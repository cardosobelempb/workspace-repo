{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\url\\url.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC,WAAW;AACX,MAAa,KAAM,SAAQ,gBAAc;IAChC,MAAM,CAAC,MAAM,CAAC,KAAa;QAChC,MAAM,UAAU,GAAG,KAAK,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,MAAM,EAAE,EAAE,CAAC,CAAC;QACpD,IAAI,CAAC,KAAK,CAAC,aAAa,CAAC,UAAU,CAAC,EAAE,CAAC;YACrC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,KAAK;gBAChB,KAAK;gBACL,OAAO,EAAE,iBAAiB,KAAK,oCAAoC;aACpE,CAAC,CAAC;QACL,CAAC;QACD,OAAO,IAAI,KAAK,CAAC,UAAU,CAAC,CAAC;IAC/B,CAAC;IAEO,MAAM,CAAC,aAAa,CAAC,KAAa;QACxC,IAAI,CAAC;YACH,MAAM,GAAG,GAAG,IAAI,GAAG,CAAC,KAAK,CAAC,UAAU,CAAC,MAAM,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,WAAW,KAAK,EAAE,CAAC,CAAC;YAC3E,OAAO,CAAC,OAAO,EAAE,QAAQ,CAAC,CAAC,QAAQ,CAAC,GAAG,CAAC,QAAQ,CAAC,CAAC;QACpD,CAAC;QAAC,MAAM,CAAC;YACP,OAAO,KAAK,CAAC;QACf,CAAC;IACH,CAAC;IAEM,OAAO;QACZ,OAAO,KAAK,CAAC,aAAa,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACzC,CAAC;CACF;AAzBD,sBAyBC;AAED,kBAAkB;AAClB,mDAAmD;AACnD,mDAAmD;AACnD,2EAA2E","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\url\\url.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { BaseVO } from \"../base.vo\";\n\n// UrlVO.ts\nexport class UrlVO extends BaseVO<string> {\n  public static create(value: string): UrlVO {\n    const normalized = value.trim().replace(/\\/+$/, \"\");\n    if (!UrlVO.isValidStatic(normalized)) {\n      throw new BadRequestError({\n        fieldName: \"url\",\n        value,\n        message: `Invalid URL: \"${value}\". Must be a valid HTTP/HTTPS URL.`,\n      });\n    }\n    return new UrlVO(normalized);\n  }\n\n  private static isValidStatic(value: string): boolean {\n    try {\n      const url = new URL(value.startsWith(\"http\") ? value : `https://${value}`);\n      return [\"http:\", \"https:\"].includes(url.protocol);\n    } catch {\n      return false;\n    }\n  }\n\n  public isValid(): boolean {\n    return UrlVO.isValidStatic(this.value);\n  }\n}\n\n// Exemplo de uso:\n// const url = UrlVO.create(\"https://example.com\");\n// console.log(url.value); // \"https://example.com\"\n// const invalidUrl = UrlVO.create(\"invalid-url\"); // Lança BadRequestError\n"],"version":3}