{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\events\\base-build.event.ts","mappings":";;;AAeA;;;;;;;;;;;GAWG;AACH,MAAa,cAAc;IACzB,8EAA8E;IAC9E,QAAQ;IACR,8EAA8E;IAE9E,sCAAsC;IAC9B,MAAM,CAAC,QAAQ,GAAgB,EAAE,CAAC;IAE1C,uCAAuC;IAC/B,MAAM,CAAC,gBAAgB,GAA6B,EAAE,CAAC;IAE/D,0CAA0C;IACnC,MAAM,CAAC,SAAS,GAAG,IAAI,CAAC;IAE/B,8EAA8E;IAC9E,eAAe;IACf,8EAA8E;IAE9E;;OAEG;IACI,MAAM,CAAC,QAAQ,CACpB,SAAiB,EACjB,QAAgC;QAEhC,MAAM,QAAQ,GAAG,IAAI,CAAC,QAAQ,CAAC,SAAS,CAAC,IAAI,EAAE,CAAC;QAEhD,IAAI,CAAC,QAAQ,CAAC,SAAS,CAAC,GAAG,CAAC,GAAG,QAAQ,EAAE,QAA0C,CAAC,CAAC;IACvF,CAAC;IAED,8EAA8E;IAC9E,eAAe;IACf,8EAA8E;IAE9E;;;OAGG;IACI,MAAM,CAAC,wBAAwB,CAAC,SAAiC;QACtE,MAAM,aAAa,GAAG,IAAI,CAAC,gBAAgB,CAAC,IAAI,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,EAAE,CAAC,MAAM,CAAC,SAAS,CAAC,EAAE,CAAC,CAAC,CAAC;QAEnF,IAAI,CAAC,aAAa,EAAE,CAAC;YACnB,IAAI,CAAC,gBAAgB,CAAC,IAAI,CAAC,SAAS,CAAC,CAAC;QACxC,CAAC;IACH,CAAC;IAED;;OAEG;IACI,MAAM,CAAC,0BAA0B,CAAC,EAAU;QACjD,MAAM,SAAS,GAAG,IAAI,CAAC,iBAAiB,CAAC,EAAE,CAAC,CAAC;QAE7C,IAAI,CAAC,SAAS,IAAI,CAAC,IAAI,CAAC,SAAS;YAAE,OAAO;QAE1C,IAAI,CAAC,uBAAuB,CAAC,SAAS,CAAC,CAAC;QACxC,SAAS,CAAC,WAAW,EAAE,CAAC;QACxB,IAAI,CAAC,eAAe,CAAC,SAAS,CAAC,CAAC;IAClC,CAAC;IAED,8EAA8E;IAC9E,WAAW;IACX,8EAA8E;IAE9E;;;OAGG;IACI,MAAM,CAAC,aAAa,CAAC,KAAgB;QAC1C,IAAI,CAAC,IAAI,CAAC,SAAS;YAAE,OAAO;QAE5B,IAAI,CAAC,QAAQ,CAAC,KAAK,CAAC,CAAC;IACvB,CAAC;IAED;;OAEG;IACK,MAAM,CAAC,uBAAuB,CAAC,SAAiC;QACtE,KAAK,MAAM,KAAK,IAAI,SAAS,CAAC,YAAY,EAAE,CAAC;YAC3C,IAAI,CAAC,QAAQ,CAAC,KAAK,CAAC,CAAC;QACvB,CAAC;IACH,CAAC;IAED;;OAEG;IACK,MAAM,CAAC,QAAQ,CAAC,KAAgB;QACtC,MAAM,SAAS,GAAG,KAAK,CAAC,WAAW,CAAC,IAAI,CAAC;QACzC,MAAM,QAAQ,GAAG,IAAI,CAAC,QAAQ,CAAC,SAAS,CAAC,CAAC;QAE1C,IAAI,CAAC,QAAQ,EAAE,MAAM;YAAE,OAAO;QAE9B,KAAK,MAAM,OAAO,IAAI,QAAQ,EAAE,CAAC;YAC/B,OAAO,CAAC,KAAK,CAAC,CAAC;QACjB,CAAC;IACH,CAAC;IAED,8EAA8E;IAC9E,mBAAmB;IACnB,8EAA8E;IAEtE,MAAM,CAAC,iBAAiB,CAAC,EAAU;QACzC,OAAO,IAAI,CAAC,gBAAgB,CAAC,IAAI,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,EAAE,CAAC,MAAM,CAAC,EAAE,CAAC,CAAC,CAAC;IAC5D,CAAC;IAEO,MAAM,CAAC,eAAe,CAAC,SAAiC;QAC9D,IAAI,CAAC,gBAAgB,GAAG,IAAI,CAAC,gBAAgB,CAAC,MAAM,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,MAAM,CAAC,SAAS,CAAC,CAAC,CAAC;IACpF,CAAC;IAED,8EAA8E;IAC9E,yBAAyB;IACzB,8EAA8E;IAE9E;;;OAGG;IACI,MAAM,CAAC,QAAQ;QACpB,IAAI,CAAC,QAAQ,GAAG,EAAE,CAAC;QACnB,IAAI,CAAC,gBAAgB,GAAG,EAAE,CAAC;IAC7B,CAAC;;AAvHH,wCAwHC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\events\\base-build.event.ts"],"sourcesContent":["import { BaseAggregate } from \"../entities/base-agregate.entity\";\nimport { UUIDVO } from \"../values-objects/uuid/uuid.vo\";\n\nimport { BaseEvent } from \"./base.event\";\n\n/**\n * Callback tipado para eventos de domínio\n */\nexport type DomainEventCallback<E extends BaseEvent = BaseEvent> = (event: E) => void;\n\n/**\n * Mapa de handlers por nome do evento\n */\ntype HandlersMap = Record<string, Array<DomainEventCallback<BaseEvent>>>;\n\n/**\n * Events\n *\n * Event Bus de domínio responsável por:\n * - Registrar handlers\n * - Controlar Unit of Work (aggregates com eventos)\n * - Despachar eventos de forma controlada\n *\n * Observação:\n * - Implementação estática por simplicidade\n * - Pode evoluir para serviço injetável futuramente\n */\nexport class BaseBuildEvent {\n  // ---------------------------------------------------------------------------\n  // STATE\n  // ---------------------------------------------------------------------------\n\n  /** Handlers registrados por evento */\n  private static handlers: HandlersMap = {};\n\n  /** Aggregates com eventos pendentes */\n  private static markedAggregates: BaseAggregate<unknown>[] = [];\n\n  /** Flag de controle (útil para testes) */\n  public static shouldRun = true;\n\n  // ---------------------------------------------------------------------------\n  // REGISTRATION\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Registra um handler para um tipo de evento\n   */\n  public static register<E extends BaseEvent>(\n    eventName: string,\n    callback: DomainEventCallback<E>,\n  ): void {\n    const handlers = this.handlers[eventName] ?? [];\n\n    this.handlers[eventName] = [...handlers, callback as DomainEventCallback<BaseEvent>];\n  }\n\n  // ---------------------------------------------------------------------------\n  // UNIT OF WORK\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Marca um aggregate para despacho posterior\n   * Evita duplicação de aggregates\n   */\n  public static markAggregateForDispatch(aggregate: BaseAggregate<unknown>): void {\n    const alreadyMarked = this.markedAggregates.some((a) => a.id.equals(aggregate.id));\n\n    if (!alreadyMarked) {\n      this.markedAggregates.push(aggregate);\n    }\n  }\n\n  /**\n   * Despacha todos os eventos de um aggregate específico\n   */\n  public static dispatchEventsForAggregate(id: UUIDVO): void {\n    const aggregate = this.findAggregateById(id);\n\n    if (!aggregate || !this.shouldRun) return;\n\n    this.dispatchAggregateEvents(aggregate);\n    aggregate.clearEvents();\n    this.removeAggregate(aggregate);\n  }\n\n  // ---------------------------------------------------------------------------\n  // DISPATCH\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Dispatch direto de um único evento\n   * 👉 Ideal para testes de subscribers\n   */\n  public static dispatchEvent(event: BaseEvent): void {\n    if (!this.shouldRun) return;\n\n    this.dispatch(event);\n  }\n\n  /**\n   * Dispatch de todos os eventos de um aggregate\n   */\n  private static dispatchAggregateEvents(aggregate: BaseAggregate<unknown>): void {\n    for (const event of aggregate.domainEvents) {\n      this.dispatch(event);\n    }\n  }\n\n  /**\n   * Dispatch de um único evento para seus handlers\n   */\n  private static dispatch(event: BaseEvent): void {\n    const eventName = event.constructor.name;\n    const handlers = this.handlers[eventName];\n\n    if (!handlers?.length) return;\n\n    for (const handler of handlers) {\n      handler(event);\n    }\n  }\n\n  // ---------------------------------------------------------------------------\n  // INTERNAL HELPERS\n  // ---------------------------------------------------------------------------\n\n  private static findAggregateById(id: UUIDVO): BaseAggregate<unknown> | undefined {\n    return this.markedAggregates.find((a) => a.id.equals(id));\n  }\n\n  private static removeAggregate(aggregate: BaseAggregate<unknown>): void {\n    this.markedAggregates = this.markedAggregates.filter((a) => !a.equals(aggregate));\n  }\n\n  // ---------------------------------------------------------------------------\n  // CLEANUP (TEST SUPPORT)\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Limpa todo o estado interno\n   * ⚠️ Deve ser usado em afterEach de testes\n   */\n  public static clearAll(): void {\n    this.handlers = {};\n    this.markedAggregates = [];\n  }\n}\n"],"version":3}