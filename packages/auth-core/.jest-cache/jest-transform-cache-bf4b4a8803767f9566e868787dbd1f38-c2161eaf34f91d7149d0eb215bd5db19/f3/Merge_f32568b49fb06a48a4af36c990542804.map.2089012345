{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\Merge.ts","mappings":";AAAA;;2FAE2F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\Merge.ts"],"sourcesContent":["/* =====================================================================================\n *  MERGE<T, U>\n * ===================================================================================== */\n\n/**\n * Merge de dois tipos (U sobrescreve T).\n *\n * @example\n * type A = { id: string; name: string }\n * type B = { name: number }\n *\n * type C = Merge<A, B>\n * // { id: string; name: number }\n */\nexport type Merge<T, U> = Omit<T, keyof U> & U;\n"],"version":3}