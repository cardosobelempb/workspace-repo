{"file":"E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\mappers\\user.mapper.ts","mappings":";;;AAGA,MAAa,UAAU;IACb,MAAM,CAAC,YAAY,CAAC,MAAkB;QAC5C,OAAO;YACL,KAAK,EAAE,MAAM,CAAC,KAAK,CAAC,QAAQ,EAAE,CAAC,KAAK;YACpC,SAAS,EAAE,MAAM,CAAC,SAAS;YAC3B,QAAQ,EAAE,MAAM,CAAC,QAAQ;YACzB,YAAY,EAAE,MAAM,CAAC,YAAY,CAAC,QAAQ,EAAE;YAC5C,aAAa,EAAE,MAAM,CAAC,aAAa,EAAE,WAAW,EAAE,IAAI,IAAI;SAC3D,CAAC;IACJ,CAAC;IAED,MAAM,CAAC,iBAAiB,CAAC,MAAkB;QACzC,OAAO,IAAI,CAAC,YAAY,CAAC,MAAM,CAAC,CAAC;IACnC,CAAC;IAED,MAAM,CAAC,iBAAiB,CAAC,MAAkB;QACzC,OAAO,IAAI,CAAC,YAAY,CAAC,MAAM,CAAC,CAAC;IACnC,CAAC;IAED,MAAM,CAAC,YAAY,CAAC,MAAkB;QACpC,OAAO;YACL,EAAE,EAAE,MAAM,CAAC,EAAE,CAAC,QAAQ,EAAE;YACxB,KAAK,EAAE,MAAM,CAAC,KAAK,CAAC,QAAQ,EAAE,CAAC,KAAK;YACpC,SAAS,EAAE,MAAM,CAAC,SAAS;YAC3B,QAAQ,EAAE,MAAM,CAAC,QAAQ;YACzB,aAAa,EAAE,MAAM,CAAC,aAAa,EAAE,WAAW,EAAE,IAAI,IAAI;SAC3D,CAAC;IACJ,CAAC;IAED,MAAM,CAAC,MAAM,CAAC,MAAkB;QAC9B,OAAO;YACL,EAAE,EAAE,MAAM,CAAC,EAAE,CAAC,QAAQ,EAAE;YACxB,KAAK,EAAE,MAAM,CAAC,KAAK,CAAC,QAAQ,EAAE,CAAC,KAAK;YACpC,SAAS,EAAE,MAAM,CAAC,SAAS;YAC3B,QAAQ,EAAE,MAAM,CAAC,QAAQ;YACzB,aAAa,EAAE,MAAM,CAAC,aAAa,EAAE,WAAW,EAAE,IAAI,IAAI;SAC3D,CAAC;IACJ,CAAC;CACF;AAtCD,gCAsCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\mappers\\user.mapper.ts"],"sourcesContent":["import { UserEntity } from \"@/common/domain\";\r\nimport { UserCreateDto, UserProjectionDto, UserUpdateDto } from \"../dto/user.dto\";\r\n\r\nexport class UserMapper {\r\n  private static toCoreFields(entity: UserEntity): UserCreateDto {\r\n    return {\r\n      email: entity.email.getValue().value,\r\n      firstName: entity.firstName,\r\n      lastName: entity.lastName,\r\n      passwordHash: entity.passwordHash.getValue(),\r\n      emailVerified: entity.emailVerified?.toISOString() ?? null,\r\n    };\r\n  }\r\n\r\n  static toCreatedResponse(entity: UserEntity): UserCreateDto {\r\n    return this.toCoreFields(entity);\r\n  }\r\n\r\n  static toUpdatedResponse(entity: UserEntity): UserUpdateDto {\r\n    return this.toCoreFields(entity);\r\n  }\r\n\r\n  static toProjection(entity: UserEntity): UserProjectionDto {\r\n    return {\r\n      id: entity.id.getValue(),\r\n      email: entity.email.getValue().value,\r\n      firstName: entity.firstName,\r\n      lastName: entity.lastName,\r\n      emailVerified: entity.emailVerified?.toISOString() ?? null,\r\n    };\r\n  }\r\n\r\n  static toHttp(entity: UserEntity): UserProjectionDto {\r\n    return {\r\n      id: entity.id.getValue(),\r\n      email: entity.email.getValue().value,\r\n      firstName: entity.firstName,\r\n      lastName: entity.lastName,\r\n      emailVerified: entity.emailVerified?.toISOString() ?? null,\r\n    };\r\n  }\r\n}\r\n"],"version":3}