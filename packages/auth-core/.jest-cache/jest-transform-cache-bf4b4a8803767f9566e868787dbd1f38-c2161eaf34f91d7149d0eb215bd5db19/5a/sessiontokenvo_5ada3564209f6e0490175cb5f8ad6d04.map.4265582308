{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\session-token\\session-token.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC,qDAAqD;AACrD,MAAM,SAAS,GAAG,qDAAqD,CAAC;AACxE,kDAAkD;AAClD,MAAM,YAAY,GAAG,0BAA0B,CAAC;AAIhD;;;;;GAKG;AACH,MAAa,cAAe,SAAQ,gBAAc;IAChD,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAED,6DAA6D;IAE7D;;OAEG;IACI,MAAM,CAAC,MAAM,CAAC,GAAW;QAC9B,IAAI,CAAC,GAAG,IAAI,GAAG,CAAC,IAAI,EAAE,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACpC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,cAAc;gBACzB,OAAO,EAAE,gCAAgC;aAC1C,CAAC,CAAC;QACL,CAAC;QAED,MAAM,QAAQ,GAAG,IAAI,cAAc,CAAC,GAAG,CAAC,IAAI,EAAE,CAAC,CAAC;QAEhD,IAAI,CAAC,QAAQ,CAAC,OAAO,EAAE,EAAE,CAAC;YACxB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,cAAc;gBACzB,OAAO,EAAE,+BAA+B;aACzC,CAAC,CAAC;QACL,CAAC;QAED,OAAO,QAAQ,CAAC;IAClB,CAAC;IAED;;;OAGG;IACI,MAAM,CAAC,QAAQ;QACpB,MAAM,KAAK,GAAG,MAAM,CAAC,eAAe,CAAC,IAAI,UAAU,CAAC,EAAE,CAAC,CAAC,CAAC;QACzD,MAAM,GAAG,GAAG,KAAK,CAAC,IAAI,CAAC,KAAK,CAAC;aAC1B,GAAG,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,EAAE,CAAC,CAAC,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC,CAAC;aAC3C,IAAI,CAAC,EAAE,CAAC,CAAC;QACZ,OAAO,IAAI,cAAc,CAAC,GAAG,CAAC,CAAC;IACjC,CAAC;IAED,6DAA6D;IAEtD,OAAO;QACZ,OAAO,SAAS,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,IAAI,YAAY,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACrE,CAAC;IAED,6DAA6D;IAE7D,IAAW,IAAI;QACb,OAAO,SAAS,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,QAAQ,CAAC;IACvD,CAAC;IAED;;;OAGG;IACH,IAAW,aAAa;QACtB,IAAI,IAAI,CAAC,IAAI,KAAK,KAAK;YAAE,OAAO,IAAI,CAAC;QACrC,OAAO,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC;IAClC,CAAC;IAED,kDAAkD;IAC3C,QAAQ;QACb,OAAO,KAAK,CAAC;IACf,CAAC;CACF;AAnED,wCAmEC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\session-token\\session-token.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\n/** JWT: 3 segmentos base64url separados por ponto */\r\nconst JWT_REGEX = /^[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+$/;\r\n/** Token opaco: hex ou base64url, 32–512 chars */\r\nconst OPAQUE_REGEX = /^[A-Za-z0-9\\-_]{32,512}$/;\r\n\r\nexport type SessionTokenType = \"jwt\" | \"opaque\";\r\n\r\n/**\r\n * 🎫 SessionTokenVO\r\n *\r\n * Encapsula um token de sessão (JWT ou opaco).\r\n * Nunca expõe o valor em logs ou serialização.\r\n */\r\nexport class SessionTokenVO extends BaseVO<string> {\r\n  private constructor(value: string) {\r\n    super(value);\r\n  }\r\n\r\n  // ─── Factories ────────────────────────────────────────────\r\n\r\n  /**\r\n   * ✅ Cria a partir de um token existente (JWT ou opaco).\r\n   */\r\n  public static create(raw: string): SessionTokenVO {\r\n    if (!raw || raw.trim().length === 0) {\r\n      throw new BadRequestError({\r\n        fieldName: \"sessionToken\",\r\n        message: \"Session token cannot be empty.\",\r\n      });\r\n    }\r\n\r\n    const instance = new SessionTokenVO(raw.trim());\r\n\r\n    if (!instance.isValid()) {\r\n      throw new BadRequestError({\r\n        fieldName: \"sessionToken\",\r\n        message: \"Invalid session token format.\",\r\n      });\r\n    }\r\n\r\n    return instance;\r\n  }\r\n\r\n  /**\r\n   * ✅ Gera um token opaco criptograficamente seguro de 64 bytes (128 chars hex).\r\n   * Requer Node 15+ ou ambiente com WebCrypto.\r\n   */\r\n  public static generate(): SessionTokenVO {\r\n    const bytes = crypto.getRandomValues(new Uint8Array(64));\r\n    const hex = Array.from(bytes)\r\n      .map((b) => b.toString(16).padStart(2, \"0\"))\r\n      .join(\"\");\r\n    return new SessionTokenVO(hex);\r\n  }\r\n\r\n  // ─── Validação ────────────────────────────────────────────\r\n\r\n  public isValid(): boolean {\r\n    return JWT_REGEX.test(this.value) || OPAQUE_REGEX.test(this.value);\r\n  }\r\n\r\n  // ─── Accessors ────────────────────────────────────────────\r\n\r\n  public get type(): SessionTokenType {\r\n    return JWT_REGEX.test(this.value) ? \"jwt\" : \"opaque\";\r\n  }\r\n\r\n  /**\r\n   * Payload bruto (base64url) do JWT, sem verificação de assinatura.\r\n   * Retorna `null` para tokens opacos.\r\n   */\r\n  public get jwtPayloadRaw(): string | null {\r\n    if (this.type !== \"jwt\") return null;\r\n    return this.value.split(\".\")[1];\r\n  }\r\n\r\n  /** Nunca exibe o token em logs ou serialização */\r\n  public toString(): string {\r\n    return \"***\";\r\n  }\r\n}\r\n"],"version":3}