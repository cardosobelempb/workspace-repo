{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\name\\name.vo.ts","mappings":";;;AACA,kFAA6E;AAC7E,wCAAoC;AAOpC,MAAa,MAAO,SAAQ,gBAAc;IACrB,KAAK,CAAS;IAEjC,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;QACb,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAED;;;;;OAKG;IACI,MAAM,CAAC,MAAM,CAClB,IAAa,EACb,UAAuB,EAAE,EACzB,IAAe;QAEf,IAAI,CAAC,IAAI,EAAE,CAAC;YACV,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,OAAO,EAAE,MAAM,CAAC,SAAS,CAAC,mBAAmB,EAAE,IAAI,CAAC;aACrD,CAAC,CAAC;QACL,CAAC;QAED,MAAM,GAAG,GAAG,OAAO,CAAC,SAAS,IAAI,CAAC,CAAC;QACnC,MAAM,GAAG,GAAG,OAAO,CAAC,SAAS,IAAI,EAAE,CAAC;QAEpC,MAAM,cAAc,GAAG,MAAM,CAAC,SAAS,CAAC,IAAI,CAAC,CAAC;QAC9C,MAAM,CAAC,QAAQ,CAAC,cAAc,EAAE,GAAG,EAAE,GAAG,EAAE,IAAI,CAAC,CAAC;QAEhD,OAAO,IAAI,MAAM,CAAC,cAAc,CAAC,CAAC;IACpC,CAAC;IAED,8BAA8B;IACvB,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAED,+BAA+B;IACxB,MAAM,CAAC,KAA6B;QACzC,IAAI,CAAC,KAAK,IAAI,CAAC,CAAC,KAAK,YAAY,MAAM,CAAC,EAAE,CAAC;YACzC,OAAO,KAAK,CAAC;QACf,CAAC;QACD,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,QAAQ,EAAE,CAAC;IACzC,CAAC;IAEM,OAAO;QACZ,OAAO,IAAI,CAAC,KAAK,CAAC,MAAM,GAAG,CAAC,CAAC;IAC/B,CAAC;IAED,2EAA2E;IACnE,MAAM,CAAC,SAAS,CAAC,IAAY;QACnC,OAAO,IAAI,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC;QACxC,cAAc;QACd,2DAA2D;QAC3D,2DAA2D;QAC3D,YAAY;QACZ,4DAA4D;QAC5D,2DAA2D;IAC7D,CAAC;IAED,6BAA6B;IACrB,MAAM,CAAC,QAAQ,CAAC,IAAY,EAAE,GAAW,EAAE,GAAW,EAAE,IAAe;QAC7E,MAAM,CAAC,GAAG,CAAC,GAAW,EAAE,IAA0B,EAAE,EAAE,CACpD,IAAI,EAAE,CAAC,CAAC,GAAG,EAAE,EAAE,IAAI,EAAE,CAAC,IAAI,MAAM,CAAC,eAAe,CAAC,GAAG,EAAE,IAAI,CAAC,CAAC;QAE9D,IAAI,IAAI,CAAC,MAAM,GAAG,GAAG,EAAE,CAAC;YACtB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,CAAC,CAAC,sBAAsB,EAAE,EAAE,IAAI,EAAE,EAAE,GAAG,EAAE,EAAE,CAAC;aACtD,CAAC,CAAC;QACL,CAAC;QAED,IAAI,IAAI,CAAC,MAAM,GAAG,GAAG,EAAE,CAAC;YACtB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,CAAC,CAAC,qBAAqB,EAAE,EAAE,IAAI,EAAE,EAAE,GAAG,EAAE,EAAE,CAAC;aACrD,CAAC,CAAC;QACL,CAAC;QAED,MAAM,KAAK,GAAG,IAAI,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC;QAC9B,IAAI,KAAK,CAAC,MAAM,GAAG,CAAC,EAAE,CAAC;YACrB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,CAAC,CAAC,4BAA4B,CAAC;aACzC,CAAC,CAAC;QACL,CAAC;QAED,MAAM,SAAS,GAAG,iBAAiB,CAAC;QACpC,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,IAAI,CAAC,EAAE,CAAC;YAC1B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,CAAC,CAAC,0BAA0B,CAAC;aACvC,CAAC,CAAC;QACL,CAAC;IACH,CAAC;IAED,oDAAoD;IAC5C,MAAM,CAAC,SAAS,CACtB,GAAW,EACX,IAAe,EACf,IAA0B;QAE1B,OAAO,IAAI,EAAE,CAAC,CAAC,GAAG,EAAE,EAAE,IAAI,EAAE,CAAC,IAAI,MAAM,CAAC,eAAe,CAAC,GAAG,EAAE,IAAI,CAAC,CAAC;IACrE,CAAC;IAED,oCAAoC;IAC5B,MAAM,CAAC,eAAe,CAAC,GAAW,EAAE,IAA0B;QACpE,MAAM,QAAQ,GAA2B;YACvC,mBAAmB,EAAE,8BAA8B;YACnD,sBAAsB,EAAE,8BAA8B,IAAI,EAAE,GAAG,IAAI,CAAC,cAAc;YAClF,qBAAqB,EAAE,6BAA6B,IAAI,EAAE,GAAG,IAAI,EAAE,cAAc;YACjF,4BAA4B,EAAE,0BAA0B;YACxD,0BAA0B,EACxB,6DAA6D;SAChE,CAAC;QACF,OAAO,QAAQ,CAAC,GAAG,CAAC,IAAI,GAAG,CAAC;IAC9B,CAAC;CACF;AA5HD,wBA4HC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\name\\name.vo.ts"],"sourcesContent":["import { BaseI18n } from \"../../../shared/utils/base-I18n\";\r\nimport { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\ninterface NameOptions {\r\n  minLength?: number;\r\n  maxLength?: number;\r\n}\r\n\r\nexport class NameVO extends BaseVO<string> {\r\n  protected readonly value: string;\r\n\r\n  private constructor(value: string) {\r\n    super(value);\r\n    this.value = value;\r\n  }\r\n\r\n  /**\r\n   * Cria um NameVO com validação e normalização.\r\n   * @param name Nome completo\r\n   * @param options Opções de validação\r\n   * @param i18n Serviço de tradução (opcional)\r\n   */\r\n  public static create(\r\n    name?: string,\r\n    options: NameOptions = {},\r\n    i18n?: BaseI18n,\r\n  ): NameVO {\r\n    if (!name) {\r\n      throw new BadRequestError({\r\n        fieldName: \"name\",\r\n        message: NameVO.translate(\"errors.name.empty\", i18n),\r\n      });\r\n    }\r\n\r\n    const min = options.minLength ?? 2;\r\n    const max = options.maxLength ?? 50;\r\n\r\n    const normalizedName = NameVO.normalize(name);\r\n    NameVO.validate(normalizedName, min, max, i18n);\r\n\r\n    return new NameVO(normalizedName);\r\n  }\r\n\r\n  /** Retorna o valor do nome */\r\n  public getValue(): string {\r\n    return this.value;\r\n  }\r\n\r\n  /** Compara com outro NameVO */\r\n  public equals(other?: BaseVO<string> | null): boolean {\r\n    if (!other || !(other instanceof NameVO)) {\r\n      return false;\r\n    }\r\n    return this.value === other.getValue();\r\n  }\r\n\r\n  public isValid(): boolean {\r\n    return this.value.length > 0;\r\n  }\r\n\r\n  /** Normaliza o nome: trim, remove múltiplos espaços e hífens duplicados */\r\n  private static normalize(name: string): string {\r\n    return name.trim().replace(/\\s+/g, \" \");\r\n    // return name\r\n    //   .normalize('NFKD')                // Normaliza acentos\r\n    //   .replace(/[\\u0300-\\u036f]/g, '') // Remove diacríticos\r\n    //   .trim()\r\n    //   .replace(/\\s+/g, ' ')             // Espaços duplicados\r\n    //   .replace(/-+/g, '-')              // Hífens duplicados\r\n  }\r\n\r\n  /** Valida o nome completo */\r\n  private static validate(name: string, min: number, max: number, i18n?: BaseI18n): void {\r\n    const t = (key: string, args?: Record<string, any>) =>\r\n      i18n?.t(key, { args }) ?? NameVO.defaultMessages(key, args);\r\n\r\n    if (name.length < min) {\r\n      throw new BadRequestError({\r\n        fieldName: \"name\",\r\n        value: name,\r\n        message: t(\"errors.name.tooShort\", { args: { min } }),\r\n      });\r\n    }\r\n\r\n    if (name.length > max) {\r\n      throw new BadRequestError({\r\n        fieldName: \"name\",\r\n        value: name,\r\n        message: t(\"errors.name.tooLong\", { args: { max } }),\r\n      });\r\n    }\r\n\r\n    const parts = name.split(\" \");\r\n    if (parts.length < 2) {\r\n      throw new BadRequestError({\r\n        fieldName: \"name\",\r\n        value: name,\r\n        message: t(\"errors.name.surnameMissing\"),\r\n      });\r\n    }\r\n\r\n    const nameRegex = /^[\\p{L}\\s'-]+$/u;\r\n    if (!nameRegex.test(name)) {\r\n      throw new BadRequestError({\r\n        fieldName: \"name\",\r\n        value: name,\r\n        message: t(\"errors.name.invalidChars\"),\r\n      });\r\n    }\r\n  }\r\n\r\n  /** Tradução fallback quando i18n não é fornecido */\r\n  private static translate(\r\n    key: string,\r\n    i18n?: BaseI18n,\r\n    args?: Record<string, any>,\r\n  ): string {\r\n    return i18n?.t(key, { args }) ?? NameVO.defaultMessages(key, args);\r\n  }\r\n\r\n  /** Mensagens padrão em português */\r\n  private static defaultMessages(key: string, args?: Record<string, any>): string {\r\n    const messages: Record<string, string> = {\r\n      \"errors.name.empty\": \"O nome não pode estar vazio.\",\r\n      \"errors.name.tooShort\": `O nome deve ter pelo menos ${args?.min ?? 2} caracteres.`,\r\n      \"errors.name.tooLong\": `O nome deve ter no máximo ${args?.max ?? 50} caracteres.`,\r\n      \"errors.name.surnameMissing\": \"Sobrenome é obrigatório.\",\r\n      \"errors.name.invalidChars\":\r\n        \"Apenas letras, espaços, apóstrofos e hífens são permitidos.\",\r\n    };\r\n    return messages[key] ?? key;\r\n  }\r\n}\r\n"],"version":3}