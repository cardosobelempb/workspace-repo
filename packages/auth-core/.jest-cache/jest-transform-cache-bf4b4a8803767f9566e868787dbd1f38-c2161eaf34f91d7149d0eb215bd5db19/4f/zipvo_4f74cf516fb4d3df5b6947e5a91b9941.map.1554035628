{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\zip.vo.ts","mappings":";;;AAAA,4BAA4B;AAC5B,iDAA4C;AAE5C,IAAI,KAAU,CAAC;AACf,IAAI,CAAC;IACH,KAAK,GAAG,OAAO,CAAC,OAAO,CAAC,CAAC;AAC3B,CAAC;AAAC,MAAM,CAAC;IACP,KAAK,GAAG,IAAI,CAAC;AACf,CAAC;AAED,MAAa,KAAM,SAAQ,yBAAU;IAC5B,OAAO;QACZ,IAAI,CAAC;YACH,IAAI,IAAI,CAAC,QAAQ,KAAK,iBAAiB,EAAE,CAAC;gBACxC,OAAO,KAAK,CAAC;YACf,CAAC;YACD,IAAI,OAAO,KAAK,KAAK,WAAW,EAAE,CAAC;gBACjC,OAAO,IAAI,CAAC,CAAC,4DAA4D;YAC3E,CAAC;YACD,wDAAwD;YACxD,OAAO,KAAK,CAAC,SAAS,CAAC,IAAI,CAAC,MAAM,CAAC;iBAChC,IAAI,CAAC,GAAG,EAAE,CAAC,IAAI,CAAC;iBAChB,KAAK,CAAC,GAAG,EAAE,CAAC,KAAK,CAAC,CAAC;QACxB,CAAC;QAAC,MAAM,CAAC;YACP,OAAO,KAAK,CAAC;QACf,CAAC;IACH,CAAC;IAED,KAAK,CAAC,QAAQ;QACZ,IAAI,IAAI,CAAC,QAAQ,KAAK,iBAAiB;YAAE,MAAM,IAAI,KAAK,CAAC,uBAAuB,CAAC,CAAC;QAClF,IAAI,OAAO,KAAK,KAAK,WAAW,EAAE,CAAC;YACjC,MAAM,KAAK,CAAC,SAAS,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC,KAAK,CAAC,GAAG,EAAE;gBAC5C,MAAM,IAAI,KAAK,CAAC,kBAAkB,CAAC,CAAC;YACtC,CAAC,CAAC,CAAC;QACL,CAAC;IACH,CAAC;CACF;AA1BD,sBA0BC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\zip.vo.ts"],"sourcesContent":["// import JSZip from 'jszip'\nimport { BaseFileVO } from \"./base-file.vo\";\n\nlet JSZip: any;\ntry {\n  JSZip = require(\"jszip\");\n} catch {\n  JSZip = null;\n}\n\nexport class ZipVO extends BaseFileVO {\n  public isValid(): boolean {\n    try {\n      if (this.mimeType !== \"application/zip\") {\n        return false;\n      }\n      if (typeof JSZip === \"undefined\") {\n        return true; // Não podemos validar o conteúdo, mas o MIME type é correto\n      }\n      // Tenta ler o arquivo como ZIP para validar a estrutura\n      return JSZip.loadAsync(this.buffer)\n        .then(() => true)\n        .catch(() => false);\n    } catch {\n      return false;\n    }\n  }\n\n  async validate() {\n    if (this.mimeType !== \"application/zip\") throw new Error(\"Invalid ZIP MIME type\");\n    if (typeof JSZip !== \"undefined\") {\n      await JSZip.loadAsync(this.buffer).catch(() => {\n        throw new Error(\"Invalid ZIP file\");\n      });\n    }\n  }\n}\n"],"version":3}