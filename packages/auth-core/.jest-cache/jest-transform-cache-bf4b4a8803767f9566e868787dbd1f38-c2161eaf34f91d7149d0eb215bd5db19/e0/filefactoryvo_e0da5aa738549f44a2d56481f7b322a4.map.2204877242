{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\file-factory.vo.ts","mappings":";;;AACA,uCAAmC;AAEnC,yCAAqC;AACrC,qCAAiC;AACjC,yCAAqC;AACrC,uCAAmC;AACnC,qCAAiC;AAEjC,MAAa,WAAW;IACtB,MAAM,CAAC,KAAK,CAAC,MAAM,CACjB,YAAoB,EACpB,QAAgB,EAChB,MAAc;QAEd,MAAM,GAAG,GAAG,GAAG,GAAG,CAAC,YAAY,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,GAAG,EAAE,IAAI,EAAE,CAAC,CAAC,WAAW,EAAE,CAAC;QAEtE,IAAI,EAAc,CAAC;QACnB,QAAQ,GAAG,EAAE,CAAC;YACZ,KAAK,MAAM,CAAC;YACZ,KAAK,MAAM,CAAC;YACZ,KAAK,OAAO,CAAC;YACb,KAAK,OAAO;gBACV,EAAE,GAAG,IAAI,kBAAO,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBACjD,MAAM;YACR,KAAK,MAAM;gBACT,EAAE,GAAG,IAAI,cAAK,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBAC/C,MAAM;YACR,KAAK,OAAO;gBACV,EAAE,GAAG,IAAI,gBAAM,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBAChD,MAAM;YACR,KAAK,OAAO;gBACV,EAAE,GAAG,IAAI,gBAAM,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBAChD,MAAM;YACR,KAAK,MAAM;gBACT,EAAE,GAAG,IAAI,cAAK,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBAC/C,MAAM;YACR,KAAK,MAAM;gBACT,EAAE,GAAG,IAAI,kBAAO,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,CAAC,CAAC;gBACjD,MAAM;YACR;gBACE,MAAM,IAAI,KAAK,CAAC,0BAA0B,GAAG,EAAE,CAAC,CAAC;QACrD,CAAC;QAED,MAAM,EAAE,CAAC,QAAQ,EAAE,CAAC;QACpB,OAAO,EAAE,CAAC;IACZ,CAAC;CACF;AAtCD,kCAsCC;AAED;;;;;;;;;;;;GAYG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\file-factory.vo.ts"],"sourcesContent":["import { BaseFileVO } from \"./base-file.vo\";\nimport { DocxVO } from \"./docx.vo\";\n\nimport { ImageVO } from \"./image.vo\";\nimport { PDFVO } from \"./pdf.vo\";\nimport { VideoVO } from \"./video.vo\";\nimport { XlsxVO } from \"./xlsx.vo\";\nimport { ZipVO } from \"./zip.vo\";\n\nexport class FileFactory {\n  static async create(\n    originalName: string,\n    mimeType: string,\n    buffer: Buffer,\n  ): Promise<BaseFileVO> {\n    const ext = \".\" + (originalName.split(\".\").pop() ?? \"\").toLowerCase();\n\n    let vo: BaseFileVO;\n    switch (ext) {\n      case \".png\":\n      case \".jpg\":\n      case \".jpeg\":\n      case \".webp\":\n        vo = new ImageVO(originalName, mimeType, buffer);\n        break;\n      case \".pdf\":\n        vo = new PDFVO(originalName, mimeType, buffer);\n        break;\n      case \".docx\":\n        vo = new DocxVO(originalName, mimeType, buffer);\n        break;\n      case \".xlsx\":\n        vo = new XlsxVO(originalName, mimeType, buffer);\n        break;\n      case \".zip\":\n        vo = new ZipVO(originalName, mimeType, buffer);\n        break;\n      case \".mp4\":\n        vo = new VideoVO(originalName, mimeType, buffer);\n        break;\n      default:\n        throw new Error(`Unsupported file type: ${ext}`);\n    }\n\n    await vo.validate();\n    return vo;\n  }\n}\n\n/**\n *\n * Exemplo de uso\nimport fs from 'fs'\n\nasync function main() {\n  const buffer = fs.readFileSync('example.pdf')\n  const file = await FileFactory.create('example.pdf', 'application/pdf', buffer)\n  console.log('Arquivo válido:', file.getName(), file.getSizeInBytes(), 'bytes')\n}\n\nmain()\n */\n"],"version":3}