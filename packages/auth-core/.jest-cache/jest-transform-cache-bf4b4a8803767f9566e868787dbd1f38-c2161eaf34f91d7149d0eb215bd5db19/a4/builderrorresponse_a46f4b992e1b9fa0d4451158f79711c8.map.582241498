{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\build-error-response.ts","mappings":";;AAkBA,gDA8BC;AA9BD,SAAgB,kBAAkB,CAAC,EACjC,KAAK,EACL,IAAI,GAIL;IACC,MAAM,QAAQ,GAAkB;QAC9B,UAAU,EAAE,KAAK,CAAC,UAAU;QAC5B,KAAK,EAAE,KAAK,CAAC,KAAK;QAClB,OAAO,EAAE,KAAK,CAAC,OAAO;QACtB,IAAI;QACJ,SAAS,EAAE,IAAI,IAAI,EAAE,CAAC,WAAW,EAAE;KACpC,CAAC;IAEF,IAAI,KAAK,CAAC,IAAI,EAAE,CAAC;QACf,QAAQ,CAAC,IAAI,GAAG,KAAK,CAAC,IAAI,CAAC;IAC7B,CAAC;IAED,IAAI,KAAK,CAAC,SAAS,EAAE,CAAC;QACpB,QAAQ,CAAC,SAAS,GAAG,KAAK,CAAC,SAAS,CAAC;QACrC,QAAQ,CAAC,MAAM,GAAG;YAChB;gBACE,KAAK,EAAE,KAAK,CAAC,SAAS;gBACtB,OAAO,EAAE,KAAK,CAAC,OAAO;aACvB;SACF,CAAC;IACJ,CAAC;IAED,OAAO,QAAQ,CAAC;AAClB,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\build-error-response.ts"],"sourcesContent":["import { StandardError } from \"./standard.error\";\n\ntype ErrorIssue = {\n  field: string;\n  message: string;\n};\n\ntype ErrorResponse = {\n  statusCode: number;\n  code?: string;\n  error: string;\n  message: string;\n  path: string;\n  timestamp: string;\n  fieldName?: string;\n  issues?: ErrorIssue[];\n};\n\nexport function buildErrorResponse({\n  error,\n  path,\n}: {\n  error: StandardError;\n  path: string;\n}): ErrorResponse {\n  const response: ErrorResponse = {\n    statusCode: error.statusCode,\n    error: error.error,\n    message: error.message,\n    path,\n    timestamp: new Date().toISOString(),\n  };\n\n  if (error.code) {\n    response.code = error.code;\n  }\n\n  if (error.fieldName) {\n    response.fieldName = error.fieldName;\n    response.issues = [\n      {\n        field: error.fieldName,\n        message: error.message,\n      },\n    ];\n  }\n\n  return response;\n}\n"],"version":3}