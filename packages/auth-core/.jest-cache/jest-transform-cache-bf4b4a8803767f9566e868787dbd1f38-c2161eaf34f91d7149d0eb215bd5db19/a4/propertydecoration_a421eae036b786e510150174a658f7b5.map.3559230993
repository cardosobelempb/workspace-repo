{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\property.decoration.ts","mappings":";;AAMA,4BAEC;AARD;;;;;GAKG;AACH,SAAgB,QAAQ,CAAC,MAAc,EAAE,WAAmB;IAC1D,OAAO,CAAC,GAAG,CAAC,sBAAsB,WAAW,EAAE,CAAC,CAAC;AACnD,CAAC;AAED;;;;;;;;;;;GAWG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\property.decoration.ts"],"sourcesContent":["/*\n * Decorator para marcar um campo como obrigatório.\n * @param target O protótipo do objeto que contém o campo decorado.\n * @param propertyKey O nome do campo decorado.\n * @returns Uma função decoradora que loga o nome do campo obrigatório no console.\n */\nexport function Required(target: object, propertyKey: string) {\n  console.log(`Campo obrigatório: ${propertyKey}`);\n}\n\n/*\n * Exemplo de uso do decorador Required:\n * class User {\n *   @Required\n *   name: string;\n *  *   @Required\n *  email: string;\n * }\n * // Saída no console:\n * // Campo obrigatório: name\n * // Campo obrigatório: email\n */\n"],"version":3}