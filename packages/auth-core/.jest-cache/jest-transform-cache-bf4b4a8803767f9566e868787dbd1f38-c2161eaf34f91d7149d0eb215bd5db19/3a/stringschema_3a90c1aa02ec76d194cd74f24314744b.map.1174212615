{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\string.schema.ts","mappings":";AAAA,gEAAgE;AAChE,gCAAgC;AAChC,gDAAgD;AAChD,gEAAgE;;;;;;AAEhE,8CAAoB;AAEpB,gEAAgE;AACnD,QAAA,UAAU,GAAG,aAAC,CAAC,IAAI,CAAC,EAAE,OAAO,EAAE,mBAAmB,EAAE,CAAC,CAAC;AACtD,QAAA,UAAU,GAAG,aAAC,CAAC,IAAI,EAAE,CAAC;AACtB,QAAA,WAAW,GAAG,aAAC,CAAC,KAAK,EAAE,CAAC;AAErC,gEAAgE;AACnD,QAAA,WAAW,GAAG,aAAC;KACzB,MAAM,EAAE;KACR,KAAK,CAAC,EAAE,OAAO,EAAE,uBAAuB,EAAE,CAAC;KAC3C,WAAW,EAAE,CAAC,uEAAuE;KACrF,IAAI,EAAE,CAAC,CAAC,6CAA6C;AAE3C,QAAA,WAAW,GAAG,aAAC;KACzB,MAAM,EAAE;KACR,KAAK,CAAC,oBAAoB,EAAE,EAAE,OAAO,EAAE,sBAAsB,EAAE,CAAC;KAChE,SAAS,CAAC,CAAC,KAAK,EAAE,EAAE,CAAC,KAAK,CAAC,OAAO,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,oCAAoC;AAEvF,gEAAgE;AACnD,QAAA,SAAS,GAAG,aAAC;KACvB,MAAM,EAAE;KACR,KAAK,CAAC,sCAAsC,EAAE,EAAE,OAAO,EAAE,aAAa,EAAE,CAAC;KACzE,SAAS,CAAC,CAAC,GAAG,EAAE,EAAE,CAAC,GAAG,CAAC,OAAO,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,oCAAoC;AAEtE,QAAA,aAAa,GAAG,aAAC;KAC3B,MAAM,EAAE;KACR,KAAK,CAAC,gBAAgB,EAAE,EAAE,OAAO,EAAE,kBAAkB,EAAE,CAAC;KACxD,SAAS,CAAC,CAAC,GAAG,EAAE,EAAE,CAAC,GAAG,CAAC,OAAO,CAAC,GAAG,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,iCAAiC;AAE9E,gEAAgE;AACnD,QAAA,SAAS,GAAG,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,CAAC,EAAE,OAAO,EAAE,aAAa,EAAE,CAAC,CAAC;AACvD,QAAA,UAAU,GAAG,aAAC;KACxB,MAAM,EAAE;KACR,KAAK,CAAC,4BAA4B,EAAE,EAAE,OAAO,EAAE,qBAAqB,EAAE,CAAC;KACvE,GAAG,CAAC,CAAC,CAAC;KACN,GAAG,CAAC,GAAG,CAAC,CAAC;AAEZ,gEAAgE;AACnD,QAAA,UAAU,GAAG,aAAC;KACxB,MAAM,EAAE;KACR,GAAG,CAAC,CAAC,EAAE,EAAE,OAAO,EAAE,oCAAoC,EAAE,CAAC;KACzD,GAAG,CAAC,GAAG,EAAE,EAAE,OAAO,EAAE,qCAAqC,EAAE,CAAC;KAC5D,IAAI,EAAE;KACN,SAAS,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC,CAAC,CAAC,0BAA0B;AAEhE,QAAA,SAAS,GAAG,aAAC;KACvB,MAAM,EAAE;KACR,GAAG,CAAC,GAAG,EAAE,EAAE,OAAO,EAAE,kCAAkC,EAAE,CAAC;KACzD,QAAQ,EAAE;KACV,QAAQ,EAAE,CAAC;AAEd,gEAAgE;AAChE,qDAAqD;AACrD,gEAAgE;AAChE,gEAAgE;AACnD,QAAA,UAAU,GAAG,aAAC;KACxB,MAAM,EAAE;KACR,WAAW,EAAE,CAAC,2CAA2C;KACzD,IAAI,EAAE,CAAC,gCAAgC;KACvC,GAAG,CAAC,CAAC,CAAC;KACN,GAAG,CAAC,EAAE,CAAC,CAAC;AAEX,SAAS;AACT,kBAAU,CAAC,KAAK,CAAC,YAAY,CAAC,CAAC,CAAC,eAAe;AAE/C,gEAAgE;AAChE,mBAAmB;AACnB,gEAAgE;AAEhE,sBAAsB;AACtB,mEAAmE;AAEnE,kBAAkB;AAClB,mEAAmE;AAEnE,gBAAgB;AAChB,0DAA0D;AAE1D,kBAAkB;AAClB,iDAAiD;AACjD,yDAAyD","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\string.schema.ts"],"sourcesContent":["// ─────────────────────────────────────────────────────────────\n// 🧱 Reusable string primitives\n// Build once, use everywhere across the project\n// ─────────────────────────────────────────────────────────────\n\nimport z from \"zod\";\n\n// — IDs -------------------------------------------------------\nexport const UuidSchema = z.uuid({ message: \"Invalid ID format\" });\nexport const CuidSchema = z.cuid();\nexport const Cuid2Schema = z.cuid2();\n\n// — Contact ---------------------------------------------------\nexport const EmailSchema = z\n  .string()\n  .email({ message: \"Invalid email address\" })\n  .toLowerCase() // normalizes before saving — avoids \"User@mail.com\" != \"user@mail.com\"\n  .trim(); // removes accidental leading/trailing spaces\n\nexport const PhoneSchema = z\n  .string()\n  .regex(/^\\+?[1-9]\\d{7,14}$/, { message: \"Invalid phone number\" })\n  .transform((phone) => phone.replace(/\\D/g, \"\")); // strips masks → stores digits only\n\n// — Documents (Brazil) ----------------------------------------\nexport const CpfSchema = z\n  .string()\n  .regex(/^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$|^\\d{11}$/, { message: \"Invalid CPF\" })\n  .transform((cpf) => cpf.replace(/\\D/g, \"\")); // stores digits only: \"12345678901\"\n\nexport const ZipCodeSchema = z\n  .string()\n  .regex(/^\\d{5}-?\\d{3}$/, { message: \"Invalid ZIP code\" })\n  .transform((zip) => zip.replace(\"-\", \"\")); // stores digits only: \"01310100\"\n\n// — Web -------------------------------------------------------\nexport const UrlSchema = z.string().url({ message: \"Invalid URL\" });\nexport const SlugSchema = z\n  .string()\n  .regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/, { message: \"Invalid slug format\" })\n  .min(3)\n  .max(100);\n\n// — Free text -------------------------------------------------\nexport const NameSchema = z\n  .string()\n  .min(2, { message: \"Name must be at least 2 characters\" })\n  .max(100, { message: \"Name must be at most 100 characters\" })\n  .trim()\n  .transform((name) => name.replace(/\\s+/g, \" \")); // collapses double spaces\n\nexport const BioSchema = z\n  .string()\n  .max(500, { message: \"Bio cannot exceed 500 characters\" })\n  .nullable()\n  .optional();\n\n// ─────────────────────────────────────────────────────────────\n// 🔄 Transform: clean and normalize strings on input\n// Avoids dirty data in the DB without extra code in the service\n// ─────────────────────────────────────────────────────────────\nexport const CodeSchema = z\n  .string()\n  .toUpperCase() // normalize to uppercase before validation\n  .trim() // remove surrounding whitespace\n  .min(4)\n  .max(10);\n\n// Usage:\nCodeSchema.parse(\"  abc123  \"); // → 'ABC123' ✅\n\n// ─────────────────────────────────────────────────────────────\n// ✅ Usage examples\n// ─────────────────────────────────────────────────────────────\n\n// Email normalization\n// EmailSchema.parse(\"  JOHN@EMAIL.COM  \"); // → 'john@email.com' ✅\n\n// Phone stripping\n// PhoneSchema.parse(\"+55 (11) 91234-5678\"); // → '5511912345678' ✅\n\n// CPF stripping\n// CpfSchema.parse(\"123.456.789-09\"); // → '12345678909' ✅\n\n// Slug validation\n// SlugSchema.parse(\"my-awesome-post-2024\"); // ✅\n// SlugSchema.parse(\"My Awesome Post\"); // ❌ invalid slug\n"],"version":3}