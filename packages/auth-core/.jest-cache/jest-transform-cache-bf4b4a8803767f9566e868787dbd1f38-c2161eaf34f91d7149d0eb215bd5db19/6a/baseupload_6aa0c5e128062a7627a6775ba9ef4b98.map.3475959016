{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\upload\\base-upload.ts","mappings":";AAAA,6BAA6B;;;AAU7B,MAAsB,UAAU;CAU/B;AAVD,gCAUC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\upload\\base-upload.ts"],"sourcesContent":["// core/contracts/Uploader.ts\n\nexport type BaseUploadFile = {\n  originalName: string;\n  mimeType: string;\n  size: number;\n  path: string;\n  url?: string; // Pode ser útil para serviços como S3, Firebase, etc.\n};\n\nexport abstract class BaseUpload {\n  /**\n   * Faz o upload de um arquivo e retorna seus dados.\n   */\n  abstract upload(file: Request): Promise<BaseUploadFile>;\n\n  /**\n   * (Opcional) Remove o arquivo do storage.\n   */\n  abstract delete(filePath: string): Promise<void>;\n}\n"],"version":3}