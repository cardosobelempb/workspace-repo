{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\validation.error.ts","mappings":";;;AAAA,+DAAqD;AACrD,qDAAiD;AAEjD,MAAa,eAAgB,SAAQ,8BAAa;IAC/B,WAAW,GAAmB,EAAE,CAAC;IAElD,YAAY,IAAa,EAAE,UAAU,GAAG,GAAG;QACzC,KAAK,CAAC;YACJ,KAAK,EAAE,kBAAkB;YACzB,OAAO,EAAE,iBAAiB;YAC1B,UAAU;YACV,GAAG,CAAC,IAAI,IAAI,EAAE,IAAI,EAAE,CAAC;SACtB,CAAC,CAAC;IACL,CAAC;IAED,aAAa,CAAC,SAAiB,EAAE,OAAe;QAC9C,IAAI,CAAC,WAAW,CAAC,IAAI,CAAC,IAAI,kCAAY,CAAC,EAAE,SAAS,EAAE,OAAO,EAAE,CAAC,CAAC,CAAC;QAChE,OAAO,IAAI,CAAC;IACd,CAAC;IAED,cAAc;QACZ,OAAO,CAAC,GAAG,IAAI,CAAC,WAAW,CAAC,CAAC;IAC/B,CAAC;IAED,SAAS;QACP,OAAO,IAAI,CAAC,WAAW,CAAC,MAAM,GAAG,CAAC,CAAC;IACrC,CAAC;IAED,gBAAgB;QACd,OAAO,IAAI,CAAC,WAAW,CAAC,GAAG,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,OAAO,CAAC,CAAC;IAChD,CAAC;IAED,SAAS;QACP,OAAO,IAAI,CAAC,WAAW,CAAC,GAAG,CAAC,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC;YACtC,KAAK,EAAE,KAAK,CAAC,SAAS;YACtB,OAAO,EAAE,KAAK,CAAC,OAAO;SACvB,CAAC,CAAC,CAAC;IACN,CAAC;IAED,IAAI,cAAc;QAChB,OAAO,IAAI,CAAC,SAAS,EAAE,CAAC,CAAC,CAAC,EAAE,KAAK,CAAC;IACpC,CAAC;IAED,MAAM;QACJ,MAAM,MAAM,GAAG,IAAI,CAAC,SAAS,EAAE,CAAC;QAEhC,OAAO;YACL,GAAG,KAAK,CAAC,MAAM,EAAE;YACjB,GAAG,CAAC,IAAI,CAAC,cAAc,IAAI,EAAE,SAAS,EAAE,IAAI,CAAC,cAAc,EAAE,CAAC;YAC9D,GAAG,CAAC,MAAM,CAAC,MAAM,GAAG,CAAC,IAAI,EAAE,MAAM,EAAE,CAAC;SACrC,CAAC;IACJ,CAAC;CACF;AAjDD,0CAiDC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\validation.error.ts"],"sourcesContent":["import { FieldMessage } from \"./field-message.error\";\nimport { StandardError } from \"./standard.error\";\n\nexport class ValidationError extends StandardError {\n  private readonly fieldErrors: FieldMessage[] = [];\n\n  constructor(path?: string, statusCode = 400) {\n    super({\n      error: \"Validation Error\",\n      message: \"Dados inválidos\",\n      statusCode,\n      ...(path && { path }),\n    });\n  }\n\n  addFieldError(fieldName: string, message: string): this {\n    this.fieldErrors.push(new FieldMessage({ fieldName, message }));\n    return this;\n  }\n\n  getFieldErrors(): ReadonlyArray<FieldMessage> {\n    return [...this.fieldErrors];\n  }\n\n  hasErrors(): boolean {\n    return this.fieldErrors.length > 0;\n  }\n\n  getErrorMessages(): string[] {\n    return this.fieldErrors.map((e) => e.message);\n  }\n\n  getIssues() {\n    return this.fieldErrors.map((error) => ({\n      field: error.fieldName,\n      message: error.message,\n    }));\n  }\n\n  get firstFieldName(): string | undefined {\n    return this.getIssues()[0]?.field;\n  }\n\n  toJSON() {\n    const issues = this.getIssues();\n\n    return {\n      ...super.toJSON(),\n      ...(this.firstFieldName && { fieldName: this.firstFieldName }),\n      ...(issues.length > 0 && { issues }),\n    };\n  }\n}\n"],"version":3}