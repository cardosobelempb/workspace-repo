{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\response-factory.schema.ts","mappings":";AAAA,+DAA+D;AAC/D,sBAAsB;AACtB,2DAA2D;AAC3D,EAAE;AACF,uDAAuD;AACvD,8DAA8D;AAC9D,+DAA+D;;;AAE/D,6BAAwB;AAExB,iDAAoE;AACpE,+CAA2C;AAE3C;;;GAGG;AACH,MAAM,aAAa,GAAG;IACpB,GAAG,EAAE,0BAAW;IAChB,GAAG,EAAE,0BAAW;IAChB,GAAG,EAAE,oCAAqB;IAC1B,GAAG,EAAE,0BAAW;IAChB,OAAO,EAAE,0BAAW;CACZ,CAAC;AAEX,gFAAgF;AAEhF;;;;;GAKG;AACI,MAAM,oBAAoB,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAAC,CAAC;IACjF,GAAG,EAAE,aAAa;IAClB,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,oBAAoB,wBAG9B;AAEH;;;;;GAKG;AACI,MAAM,cAAc,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAAC,CAAC;IAC3E,GAAG,EAAE,aAAa;IAClB,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,cAAc,kBAGxB;AAEH;;;;;GAKG;AACI,MAAM,kBAAkB,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAAC,CAAC;IAC/E,GAAG,EAAE,aAAa;IAClB,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,kBAAkB,sBAG5B;AAEH;;;;;GAKG;AACI,MAAM,oBAAoB,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAAC,CAAC;IACjF,GAAG,EAAE,aAAa;IAClB,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,oBAAoB,wBAG9B;AAEH;;GAEG;AACI,MAAM,oBAAoB,GAAG,GAAG,EAAE,CAAC,CAAC;IACzC,GAAG,EAAE,OAAC,CAAC,IAAI,EAAE;IACb,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,oBAAoB,wBAG9B;AAEH;;;;;GAKG;AACI,MAAM,oBAAoB,GAAG,GAAG,EAAE,CAAC,CAAC;IACzC,GAAG,EAAE,OAAC,CAAC,MAAM,CAAC,EAAE,OAAO,EAAE,OAAC,CAAC,MAAM,EAAE,EAAE,CAAC;IACtC,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,oBAAoB,wBAG9B;AAEH;;;;;GAKG;AACI,MAAM,kBAAkB,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAAC,CAAC;IAC/E,GAAG,EAAE,IAAA,wBAAU,EAAC,aAAa,CAAC;IAC9B,GAAG,aAAa;CACjB,CAAC,CAAC;AAHU,QAAA,kBAAkB,sBAG5B","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\response-factory.schema.ts"],"sourcesContent":["// ============================================================\n// response.factory.ts\n// Factory genérica de response schemas para rotas Fastify.\n//\n// Elimina a repetição de 400/409/422/500 em cada rota.\n// Basta passar o schema de sucesso — os erros vêm automático.\n// ============================================================\n\nimport { z } from \"zod\";\n\nimport { ErrorSchema, ValidationErrorSchema } from \"./error.schema\";\nimport { PageSchema } from \"./page.schema\";\n\n/**\n * Códigos de erro padrão reutilizados em todas as rotas.\n * Centraliza para facilitar manutenção global.\n */\nconst defaultErrors = {\n  400: ErrorSchema,\n  409: ErrorSchema,\n  422: ValidationErrorSchema,\n  500: ErrorSchema,\n  default: ErrorSchema,\n} as const;\n\n// ─── Factories por padrão de rota ────────────────────────────────────────────\n\n/**\n * POST — criação de recurso (201 + erros padrão)\n *\n * @example\n * response: createResponseSchema(z.object({ organization: OrganizationSchema }))\n */\nexport const createResponseSchema = <T extends z.ZodTypeAny>(successSchema: T) => ({\n  201: successSchema,\n  ...defaultErrors,\n});\n\n/**\n * GET — busca de recurso (200 + erros padrão)\n *\n * @example\n * response: ResponseSchema(z.object({ organization: OrganizationSchema }))\n */\nexport const responseSchema = <T extends z.ZodTypeAny>(successSchema: T) => ({\n  200: successSchema,\n  ...defaultErrors,\n});\n\n/**\n * GET — busca de recurso (200 + erros padrão)\n *\n * @example\n * response: findResponseSchema(z.object({ organization: OrganizationSchema }))\n */\nexport const findResponseSchema = <T extends z.ZodTypeAny>(successSchema: T) => ({\n  200: successSchema,\n  ...defaultErrors,\n});\n\n/**\n * PUT/PATCH — atualização de recurso (200 + erros padrão)\n *\n * @example\n * response: updateResponseSchema(z.object({ organization: OrganizationSchema }))\n */\nexport const updateResponseSchema = <T extends z.ZodTypeAny>(successSchema: T) => ({\n  200: successSchema,\n  ...defaultErrors,\n});\n\n/**\n * DELETE — remoção de recurso (204 sem body + erros padrão)\n */\nexport const deleteResponseSchema = () => ({\n  204: z.null(),\n  ...defaultErrors,\n});\n\n/**\n * Ação customizada — ex: activate, deactivate, approve (200 + mensagem)\n *\n * @example\n * response: actionResponseSchema()  // { message: '...' }\n */\nexport const actionResponseSchema = () => ({\n  200: z.object({ message: z.string() }),\n  ...defaultErrors,\n});\n\n/**\n * Listagem paginada — Page<T> (200 + erros padrão)\n *\n * @example\n * response: pageResponseSchema(OrganizationSchema)\n */\nexport const pageResponseSchema = <T extends z.ZodTypeAny>(contentSchema: T) => ({\n  200: PageSchema(contentSchema),\n  ...defaultErrors,\n});\n"],"version":3}