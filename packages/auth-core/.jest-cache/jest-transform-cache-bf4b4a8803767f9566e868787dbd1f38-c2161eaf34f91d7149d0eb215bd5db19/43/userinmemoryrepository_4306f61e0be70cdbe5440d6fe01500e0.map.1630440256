,CAAC,GAAa;QAC/B,MAAM,KAAK,GAAG,IAAI,CAAC,KAAK,CAAC,MAAM,CAAC,CAAC,IAAI,EAAE,EAAE,CACvC,GAAG,CAAC,IAAI,CAAC,CAAC,EAAE,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,CAAC,MAAM,CAAC,eAAM,CAAC,MAAM,CAAC,EAAE,CAAC,CAAC,CAAC,CACpD,CAAC;QAEF,OAAO,KAAK,CAAC;IACf,CAAC;IACD,KAAK,CAAC,MAAM,CAAC,MAAkB;QAC7B,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;QAExB,OAAO,MAAM,CAAC;IAChB,CAAC;IACD,KAAK,CAAC,MAAM,CAAC,EAAU;QACrB,MAAM,IAAI,GAAG,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,CAAC,MAAM,CAAC,eAAM,CAAC,MAAM,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;QAE1E,OAAO,CAAC,CAAC,IAAI,CAAC;IAChB,CAAC;IACD,KAAK,CAAC,IAAI,CAAC,MAAkB;QAC3B,MAAM,KAAK,GAAG,IAAI,CAAC,KAAK,CAAC,SAAS,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,CAAC,MAAM,CAAC,MAAM,CAAC,EAAE,CAAC,CAAC,CAAC;QAExE,IAAI,KAAK,KAAK,CAAC,CAAC,EAAE,CAAC;YACjB,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;QAC1B,CAAC;aAAM,CAAC;YACN,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,MAAM,CAAC;QAC7B,CAAC;QAED,OAAO,MAAM,CAAC;IAChB,CAAC;IACD,KAAK,CAAC,MAAM,CAAC,MAAkB;QAC7B,MAAM,SAAS,GAAG,IAAI,CAAC,KAAK,CAAC,SAAS,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,KAAK,MAAM,CAAC,EAAE,CAAC,CAAC;QAExE,IAAI,CAAC,KAAK,CAAC,MAAM,CAAC,SAAS,EAAE,CAAC,CAAC,CAAC;IAClC,CAAC;CACF;AArFD,wDAqFC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\domain\\repositories\\in-memory\\user-in-memory.repository.ts"],"sourcesContent":["import { EmailVO, UUIDVO } from \"@repo/common\";\nimport { UserEntity } from \"../../entities\";\nimport { UserRepository } from \"../../repositories\";\n\nexport class UserInMemoryRepository implements UserRepository {\n  public items: UserEntity[] = [];\n\n  async findActiveByEmail(email: string): Promise<UserEntity | null> {\n    const user = this.items.find(\n      (item) => item.email.equals(EmailVO.create(email)) && item.deletedAt === null,\n    );\n\n    return user || null;\n  }\n  async findActiveById(id: string): Promise<UserEntity | null> {\n    const user = this.items.find(\n      (item) => item.id.equals(UUIDVO.create(id)) && item.deletedAt === null,\n    );\n\n    return user || null;\n  }\n  async existsByEmail(email: string): Promise<boolean> {\n    const user = this.items.find(\n      (item) => item.email.equals(EmailVO.create(email)) && item.deletedAt === null,\n    );\n\n    return !!user;\n  }\n  async findByEmail(email: string): Promise<UserEntity | null> {\n    const user = this.items.find((item) => item.email.equals(EmailVO.create(email)));\n\n    return user || null;\n  }\n  async markEmailVerified(userId: string, verifiedAt: Date): Promise<void> {\n    const user = this.items.find((item) => item.id.equals(UUIDVO.create(userId)));\n\n    if (!user) {\n      return;\n    }\n\n    user.updateEmailVerified(verifiedAt);\n  }\n  async softDelete(userId: string): Promise<void> {\n    const user = this.items.find((item) => item.id.equals(UUIDVO.create(userId)));\n\n    if (!user) {\n      return;\n    }\n\n    user.softDelete();\n  }\n  async findById(id: string): Promise<UserEntity | null> {\n    const user = this.items.find((item) => item.id.equals(UUIDVO.create(id)));\n\n    return user || null;\n  }\n  async findManyByIds(ids: string[]): Promise<UserEntity[]> {\n    const users = this.items.filter((item) =>\n      ids.some((id) => item.id.equals(UUIDVO.create(id))),\n    );\n\n    return users;\n  }\n  async create(entity: UserEntity): Promise<UserEntity> {\n    this.items.push(entity);\n\n    return entity;\n  }\n  async exists(id: string): Promise<boolean> {\n    const user = this.items.find((item) => item.id.equals(UUIDVO.create(id)));\n\n    return !!user;\n  }\n  async save(entity: UserEntity): Promise<UserEntity> {\n    const index = this.items.findIndex((item) => item.id.equals(entity.id));\n\n    if (index === -1) {\n      this.items.push(entity);\n    } else {\n      this.items[index] = entity;\n    }\n\n    return entity;\n  }\n  async delete(entity: UserEntity): Promise<void> {\n    const itemIndex = this.items.findIndex((item) => item.id === entity.id);\n\n    this.items.splice(itemIndex, 1);\n  }\n}\n"],"version":3}