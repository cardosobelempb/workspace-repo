{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\context\\request-context.ts","mappings":";;;AAAA,uDAAqD;AAUrD,MAAa,cAAc;IACjB,MAAM,CAAU,OAAO,GAAG,IAAI,oCAAiB,EAAsB,CAAC;IAE9E,MAAM,CAAC,GAAG,CAAI,IAAwB,EAAE,QAAiB;QACvD,OAAO,IAAI,CAAC,OAAO,CAAC,GAAG,CAAC,IAAI,EAAE,QAAQ,CAAC,CAAC;IAC1C,CAAC;IAED,MAAM,CAAC,GAAG;QACR,OAAO,IAAI,CAAC,OAAO,CAAC,QAAQ,EAAE,CAAC;IACjC,CAAC;IAED,MAAM,CAAC,YAAY;QACjB,OAAO,IAAI,CAAC,GAAG,EAAE,EAAE,SAAS,CAAC;IAC/B,CAAC;IAED,MAAM,CAAC,UAAU;QACf,OAAO,IAAI,CAAC,GAAG,EAAE,EAAE,OAAO,CAAC;IAC7B,CAAC;IAED,MAAM,CAAC,SAAS;QACd,OAAO,IAAI,CAAC,GAAG,EAAE,EAAE,MAAM,CAAC;IAC5B,CAAC;;AArBH,wCAsBC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\context\\request-context.ts"],"sourcesContent":["import { AsyncLocalStorage } from \"node:async_hooks\";\n\nexport type RequestContextData = {\n  requestId: string;\n  traceId?: string;\n  userId?: string;\n  tenantId?: string;\n  organizationId?: string;\n};\n\nexport class RequestContext {\n  private static readonly storage = new AsyncLocalStorage<RequestContextData>();\n\n  static run<T>(data: RequestContextData, callback: () => T): T {\n    return this.storage.run(data, callback);\n  }\n\n  static get(): RequestContextData | undefined {\n    return this.storage.getStore();\n  }\n\n  static getRequestId(): string | undefined {\n    return this.get()?.requestId;\n  }\n\n  static getTraceId(): string | undefined {\n    return this.get()?.traceId;\n  }\n\n  static getUserId(): string | undefined {\n    return this.get()?.userId;\n  }\n}\n"],"version":3}