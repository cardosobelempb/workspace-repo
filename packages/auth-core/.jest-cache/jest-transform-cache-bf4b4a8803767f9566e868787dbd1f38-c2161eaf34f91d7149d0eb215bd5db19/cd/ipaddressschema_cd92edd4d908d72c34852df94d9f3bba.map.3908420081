{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\ip-address.schema.ts","mappings":";;;;;;AAAA,8CAAoB;AAEP,QAAA,eAAe,GAAG,aAAC,CAAC,MAAM,EAAE,CAAC,MAAM,CAAC,CAAC,KAAK,EAAE,EAAE;IACzD,yDAAyD;IACzD,MAAM,SAAS,GACb,kKAAkK,CAAC;IACrK,MAAM,SAAS,GACb,mqBAAmqB,CAAC;IACtqB,OAAO,SAAS,CAAC,IAAI,CAAC,KAAK,CAAC,IAAI,SAAS,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;AACxD,CAAC,CAAC,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\ip-address.schema.ts"],"sourcesContent":["import z from \"zod\";\n\nexport const IpAddressSchema = z.string().refine((value) => {\n  // Regular expression to validate IPv4 and IPv6 addresses\n  const ipv4Regex =\n    /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/;\n  const ipv6Regex =\n    /^(([0-9a-fA-F]{1,4}:){7}([0-9a-fA-F]{1,4}|:))|(([0-9a-fA-F]{1,4}:){1,7}:)|(([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4})|(([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2})|(([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3})|(([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4})|(([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5})|([0-9a-fA-F]{1,4}:)((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4][0-9]|[01]?[0-9][0-9]?))\\.){3}(25[0-5]|(2[0-4][0-9]|[01]?[0-9][0-9]?))|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4][0-9]|[01]?[0-9][0-9]?))\\.){3}(25[0-5]|(2[0-4][0-9]|[01]?[0-9][0-9]?))$/;\n  return ipv4Regex.test(value) || ipv6Regex.test(value);\n});\n"],"version":3}