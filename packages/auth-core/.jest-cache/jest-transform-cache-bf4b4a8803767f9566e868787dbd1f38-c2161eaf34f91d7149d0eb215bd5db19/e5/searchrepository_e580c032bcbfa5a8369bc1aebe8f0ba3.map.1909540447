{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\search.repository.ts","mappings":"","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\search.repository.ts"],"sourcesContent":["export type SearchInput = {\n  page?: number;\n  perPage?: number; // substitui size\n  filter?: string;\n  sortBy?: string;\n  sortDirection?: \"asc\" | \"desc\";\n};\n\nexport type SearchOutput<Entity> = {\n  items: Entity[];\n  total: number;\n  totalPages: number;\n  currentPage: number;\n  perPage: number;\n  sortBy: string | null; // opcional agora\n  sortDirection: \"asc\" | \"desc\";\n  filter: string;\n};\n"],"version":3}