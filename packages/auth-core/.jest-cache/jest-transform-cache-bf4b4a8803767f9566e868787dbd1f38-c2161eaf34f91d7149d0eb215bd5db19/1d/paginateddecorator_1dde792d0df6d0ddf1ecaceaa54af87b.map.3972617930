{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\paginated.decorator.ts","mappings":";AAAA,oDAAoD;;AAUpD,8BAMC;AAdD,yCAAyC;AAEzC;;;;;GAKG;AACH,SAAgB,SAAS;IACvB,OAAO,UAAU,MAAc,EAAE,WAA4B;QAC3D,IAAA,sBAAW,EAAC,MAAM,CAAC,WAAW,EAAE,MAAM,CAAC,WAAW,CAAC,EAAE;YACnD,UAAU,EAAE,IAAI;SACjB,CAAC,CAAC;IACL,CAAC,CAAC;AACJ,CAAC;AAED;;;;;;;;;;;EAWE","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\paginated.decorator.ts"],"sourcesContent":["// src/shared/http/decorators/paginated.decorator.ts\n\nimport { updateRoute } from \"./metadata\";\n\n/**\n * Ativa paginação automática para uma rota.\n *\n * Exemplo:\n * @Paginated()\n */\nexport function Paginated() {\n  return function (target: object, propertyKey: string | symbol): void {\n    updateRoute(target.constructor, String(propertyKey), {\n      pagination: true,\n    });\n  };\n}\n\n/**\n@Get(\"/\")\n@Paginated()\nasync listUsers(request: FastifyRequest) {\n  const query = request.query as {\n    page: number;\n    limit: number;\n  };\n\n  return this.usersService.findPaginated(query);\n}\n*/\n"],"version":3}