atusCode: z.number(),\n  code: z.string().optional(),\n  error: z.string().optional(),\n  message: z.string(),\n  path: z.string().optional(),\n  fieldName: z.string().optional(),\n  timestamp: z.string().optional(),\n\n  issues: z\n    .array(\n      z.object({\n        field: z.string(),\n        message: z.string(),\n      }),\n    )\n    .optional(),\n});\n"],"version":3}