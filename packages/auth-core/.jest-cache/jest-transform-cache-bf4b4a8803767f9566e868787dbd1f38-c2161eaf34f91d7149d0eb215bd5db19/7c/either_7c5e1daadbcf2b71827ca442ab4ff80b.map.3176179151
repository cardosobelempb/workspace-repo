{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\handle-errors\\either.ts","mappings":";;;AAAA,iCAA8B;AAC9B,mCAAgC;AAUhC;;;;;;GAMG;AACI,MAAM,IAAI,GAAG,CAAe,KAAQ,EAAgB,EAAE;IAC3D,OAAO,IAAI,WAAI,CAAC,KAAK,CAAC,CAAC;AACzB,CAAC,CAAC;AAFW,QAAA,IAAI,QAEf;AAEF;;;;;GAKG;AACI,MAAM,KAAK,GAAG,CAAe,KAAQ,EAAgB,EAAE;IAC5D,OAAO,IAAI,aAAK,CAAC,KAAK,CAAC,CAAC;AAC1B,CAAC,CAAC;AAFW,QAAA,KAAK,SAEhB","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\handle-errors\\either.ts"],"sourcesContent":["import { Left } from \"./left\";\nimport { Right } from \"./right\";\n\n/**\n * Representa um valor que pode ser falha (Left) ou sucesso (Right).\n *\n * L -> tipo da falha\n * R -> tipo do sucesso\n */\nexport type Either<L, R> = Left<L, R> | Right<L, R>;\n\n/**\n * Cria um Either do tipo Left (falha).\n * Útil para padronizar falhas em fluxos funcionais ou serviços.\n *\n * Ex:\n *   return left(\"Email inválido\")\n */\nexport const left = <L, R = never>(value: L): Either<L, R> => {\n  return new Left(value);\n};\n\n/**\n * Cria um Either do tipo Right (sucesso).\n *\n * Ex:\n *   return right({ id: 1, name: \"John\" })\n */\nexport const right = <R, L = never>(value: R): Either<L, R> => {\n  return new Right(value);\n};\n"],"version":3}