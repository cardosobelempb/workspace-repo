{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\slug\\slug.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC;;;GAGG;AACH,MAAa,MAAO,SAAQ,gBAAc;IAChC,MAAM,CAAU,UAAU,GAAG,CAAC,CAAC;IAC/B,MAAM,CAAU,UAAU,GAAG,GAAG,CAAC;IACjC,MAAM,CAAU,UAAU,GAAG,4BAA4B,CAAC;IAElE,gEAAgE;IAChE,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAED,kCAAkC;IAClC,wBAAwB;IACxB,kCAAkC;IAElC;;;OAGG;IACI,MAAM,CAAC,MAAM,CAAC,KAAa;QAChC,MAAM,UAAU,GAAG,KAAK,EAAE,IAAI,EAAE,CAAC,WAAW,EAAE,CAAC;QAE/C,IAAI,CAAC,MAAM,CAAC,OAAO,CAAC,UAAU,CAAC,EAAE,CAAC;YAChC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK;gBACL,OAAO,EAAE,kBAAkB,KAAK,cAAc,IAAI,CAAC,UAAU,IAAI,IAAI,CAAC,UAAU,6CAA6C;aAC9H,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,MAAM,CAAC,UAAU,CAAC,CAAC;IAChC,CAAC;IAED;;;;OAIG;IACI,MAAM,CAAC,cAAc,CAAC,IAAY;QACvC,IAAI,CAAC,IAAI,IAAI,IAAI,CAAC,IAAI,EAAE,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACtC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,gCAAgC;aAC1C,CAAC,CAAC;QACL,CAAC;QAED,yDAAyD;QACzD,MAAM,QAAQ,GAAG,IAAI;aAClB,SAAS,CAAC,KAAK,CAAC;aAChB,WAAW,EAAE;aACb,IAAI,EAAE;aACN,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC,0BAA0B;aAC/C,OAAO,CAAC,UAAU,EAAE,EAAE,CAAC,CAAC,kBAAkB;aAC1C,OAAO,CAAC,IAAI,EAAE,GAAG,CAAC,CAAC,wBAAwB;aAC3C,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC,yBAAyB;aAC9C,OAAO,CAAC,UAAU,EAAE,EAAE,CAAC,CAAC,CAAC,2BAA2B;QAEvD,IAAI,CAAC,MAAM,CAAC,OAAO,CAAC,QAAQ,CAAC,EAAE,CAAC;YAC9B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,KAAK,EAAE,QAAQ;gBACf,OAAO,EAAE,mBAAmB,QAAQ,yBAAyB,IAAI,CAAC,UAAU,IAAI,IAAI,CAAC,UAAU,6CAA6C;aAC7I,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,MAAM,CAAC,QAAQ,CAAC,CAAC;IAC9B,CAAC;IAED,kCAAkC;IAClC,0BAA0B;IAC1B,kCAAkC;IAElC,wDAAwD;IACjD,OAAO;QACZ,OAAO,MAAM,CAAC,OAAO,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACpC,CAAC;IAED,6CAA6C;IACtC,MAAM,CAAC,OAAO,CAAC,KAAa;QACjC,IAAI,CAAC,KAAK;YAAE,OAAO,KAAK,CAAC;QACzB,OAAO,CACL,KAAK,CAAC,MAAM,IAAI,MAAM,CAAC,UAAU;YACjC,KAAK,CAAC,MAAM,IAAI,MAAM,CAAC,UAAU;YACjC,MAAM,CAAC,UAAU,CAAC,IAAI,CAAC,KAAK,CAAC,CAC9B,CAAC;IACJ,CAAC;;AArFH,wBAsFC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\slug\\slug.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { BaseVO } from \"../base.vo\";\n\n/**\n * ✅ Value Object responsável por representar e validar um Slug.\n * Garante imutabilidade, padronização e formato seguro para URLs.\n */\nexport class SlugVO extends BaseVO<string> {\n  private static readonly MIN_LENGTH = 3;\n  private static readonly MAX_LENGTH = 100;\n  private static readonly SLUG_REGEX = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;\n\n  /** 🔒 Construtor privado: força o uso das fábricas estáticas */\n  private constructor(value: string) {\n    super(value);\n  }\n\n  // ===============================\n  // 🚀 MÉTODOS DE FÁBRICA\n  // ===============================\n\n  /**\n   * Cria um Slug a partir de uma string **já formatada**.\n   * @throws BadRequestError se o slug for inválido.\n   */\n  public static create(value: string): SlugVO {\n    const normalized = value?.trim().toLowerCase();\n\n    if (!SlugVO.isValid(normalized)) {\n      throw new BadRequestError({\n        fieldName: \"slug\",\n        value,\n        message: `Invalid slug: \"${value}\". Must be ${this.MIN_LENGTH}-${this.MAX_LENGTH} chars, lowercase, and can include hyphens.`,\n      });\n    }\n\n    return new SlugVO(normalized);\n  }\n\n  /**\n   * Gera um Slug a partir de um texto bruto (ex: título, nome, etc).\n   * Aplica normalização Unicode, substituições e validação.\n   * @throws BadRequestError se o resultado não atender aos critérios.\n   */\n  public static createFromText(text: string): SlugVO {\n    if (!text || text.trim().length === 0) {\n      throw new BadRequestError({\n        fieldName: \"slug\",\n        value: text,\n        message: \"Text for slug cannot be empty.\",\n      });\n    }\n\n    // 🧹 Normalização Unicode (remove acentos e diacríticos)\n    const slugText = text\n      .normalize(\"NFD\")\n      .toLowerCase()\n      .trim()\n      .replace(/\\s+/g, \"-\") // troca espaços por hífen\n      .replace(/[^\\w-]+/g, \"\") // remove símbolos\n      .replace(/_/g, \"-\") // substitui underscores\n      .replace(/--+/g, \"-\") // evita múltiplos hífens\n      .replace(/^-+|-+$/g, \"\"); // remove hífens nas bordas\n\n    if (!SlugVO.isValid(slugText)) {\n      throw new BadRequestError({\n        fieldName: \"slug\",\n        value: slugText,\n        message: `Generated slug \"${slugText}\" is invalid. Must be ${this.MIN_LENGTH}-${this.MAX_LENGTH} chars, lowercase, and can include hyphens.`,\n      });\n    }\n\n    return new SlugVO(slugText);\n  }\n\n  // ===============================\n  // 🧪 MÉTODOS DE VALIDAÇÃO\n  // ===============================\n\n  /** Implementação do contrato abstrato da classe base */\n  public isValid(): boolean {\n    return SlugVO.isValid(this.value);\n  }\n\n  /** Verifica se o slug informado é válido. */\n  public static isValid(value: string): boolean {\n    if (!value) return false;\n    return (\n      value.length >= SlugVO.MIN_LENGTH &&\n      value.length <= SlugVO.MAX_LENGTH &&\n      SlugVO.SLUG_REGEX.test(value)\n    );\n  }\n}\n"],"version":3}