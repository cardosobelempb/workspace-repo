{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\number.schema.ts","mappings":";AAAA,gEAAgE;AAChE,2CAA2C;AAC3C,gEAAgE;;;;;;AAEhE,8CAAoB;AACpB,mDAA6C;AAE7C,4CAA4C;AAC/B,QAAA,WAAW,GAAG,aAAC;KACzB,MAAM,EAAE;KACR,QAAQ,CAAC,EAAE,OAAO,EAAE,wBAAwB,EAAE,CAAC;KAC/C,UAAU,CAAC,IAAI,EAAE,EAAE,OAAO,EAAE,0BAA0B,EAAE,CAAC;KACzD,GAAG,CAAC,UAAU,EAAE,EAAE,OAAO,EAAE,mBAAmB,EAAE,CAAC,CAAC;AAErD,aAAa;AACA,QAAA,gBAAgB,GAAG,aAAC;KAC9B,MAAM,EAAE;KACR,GAAG,CAAC,CAAC,EAAE,EAAE,OAAO,EAAE,eAAe,EAAE,CAAC;KACpC,GAAG,CAAC,GAAG,EAAE,EAAE,OAAO,EAAE,iBAAiB,EAAE,CAAC,CAAC;AAE5C,iBAAiB;AACJ,QAAA,cAAc,GAAG,aAAC;KAC5B,MAAM,EAAE;KACR,GAAG,CAAC,EAAE,OAAO,EAAE,wBAAwB,EAAE,CAAC;KAC1C,WAAW,CAAC,EAAE,OAAO,EAAE,oBAAoB,EAAE,CAAC,CAAC;AAElD,uBAAuB;AACV,QAAA,YAAY,GAAG,aAAC;KAC1B,MAAM,EAAE;KACR,GAAG,EAAE;KACL,GAAG,CAAC,CAAC,EAAE,EAAE,OAAO,EAAE,qBAAqB,EAAE,CAAC;KAC1C,GAAG,CAAC,CAAC,EAAE,EAAE,OAAO,EAAE,qBAAqB,EAAE,CAAC,CAAC;AAE9C,gEAAgE;AAChE,gDAAgD;AAChD,6DAA6D;AAC7D,yCAAyC;AACzC,gEAAgE;AACnD,QAAA,gBAAgB,GAAG,aAAC,CAAC,MAAM,CAAC;IACvC,IAAI,EAAE,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,QAAQ,EAAE,CAAC,OAAO,CAAC,CAAC,CAAC;IACnD,KAAK,EAAE,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC,OAAO,CAAC,EAAE,CAAC;CAC3D,CAAC,CAAC;AAEH,sDAAsD;AACtD,wBAAgB,CAAC,KAAK,CAAC,EAAE,IAAI,EAAE,GAAG,EAAE,KAAK,EAAE,IAAI,EAAE,CAAC,CAAC;AACnD,6BAA6B;AAE7B,gEAAgE;AAChE,qDAAqD;AACrD,6DAA6D;AAC7D,gEAAgE;AACnD,QAAA,aAAa,GAAG,aAAC;KAC3B,MAAM,CAAC;IACN,IAAI,EAAE,0BAAU;IAChB,KAAK,EAAE,mBAAW;IAClB,SAAS,EAAE,mBAAW,CAAC,QAAQ,EAAE,CAAC,QAAQ,EAAE;IAC5C,KAAK,EAAE,sBAAc;IACrB,YAAY,EAAE,wBAAgB,CAAC,OAAO,CAAC,CAAC,CAAC;CAC1C,CAAC;KACD,MAAM,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,CAAC,IAAI,CAAC,SAAS,IAAI,IAAI,CAAC,SAAS,GAAG,IAAI,CAAC,KAAK,EAAE;IAChE,OAAO,EAAE,kDAAkD;IAC3D,IAAI,EAAE,CAAC,WAAW,CAAC;CACpB,CAAC,CAAC;AAIL,gEAAgE;AAChE,mBAAmB;AACnB,gEAAgE;AAEhE,gBAAgB;AAChB,qBAAa,CAAC,KAAK,CAAC;IAClB,IAAI,EAAE,qBAAqB;IAC3B,KAAK,EAAE,MAAM;IACb,SAAS,EAAE,MAAM;IACjB,KAAK,EAAE,EAAE;IACT,YAAY,EAAE,EAAE;CACjB,CAAC,CAAC,CAAC,IAAI;AAER,4CAA4C;AAC5C,qBAAa,CAAC,SAAS,CAAC;IACtB,IAAI,EAAE,UAAU;IAChB,KAAK,EAAE,KAAK;IACZ,SAAS,EAAE,MAAM,EAAE,yDAAyD;IAC5E,KAAK,EAAE,EAAE;CACV,CAAC,CAAC;AAEH,wBAAwB;AACxB,wBAAgB,CAAC,KAAK,CAAC,EAAE,IAAI,EAAE,GAAG,EAAE,KAAK,EAAE,IAAI,EAAE,CAAC,CAAC;AACnD,6BAA6B","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\number.schema.ts"],"sourcesContent":["// ─────────────────────────────────────────────────────────────\n// 🔢 Numbers with clear business semantics\n// ─────────────────────────────────────────────────────────────\n\nimport z from \"zod\";\nimport { NameSchema } from \"./string.schema\";\n\n// Monetary — 2 decimal places, no negatives\nexport const PriceSchema = z\n  .number()\n  .positive({ message: \"Price must be positive\" })\n  .multipleOf(0.01, { message: \"Maximum 2 decimal places\" })\n  .max(999_999.99, { message: \"Price is too high\" });\n\n// Percentage\nexport const PercentageSchema = z\n  .number()\n  .min(0, { message: \"Minimum is 0%\" })\n  .max(100, { message: \"Maximum is 100%\" });\n\n// Stock quantity\nexport const QuantitySchema = z\n  .number()\n  .int({ message: \"Must be a whole number\" })\n  .nonnegative({ message: \"Cannot be negative\" });\n\n// Star rating (1 to 5)\nexport const RatingSchema = z\n  .number()\n  .int()\n  .min(1, { message: \"Minimum rating is 1\" })\n  .max(5, { message: \"Maximum rating is 5\" });\n\n// ─────────────────────────────────────────────────────────────\n// ⚡ coerce.number — converts strings to numbers\n// Essential for query params, which always arrive as strings\n// Example: GET /products?page=2&limit=10\n// ─────────────────────────────────────────────────────────────\nexport const PaginationSchema = z.object({\n  page: z.coerce.number().int().positive().default(1),\n  limit: z.coerce.number().int().min(1).max(100).default(20),\n});\n\n// Usage with query params (Express / Fastify / Hono):\nPaginationSchema.parse({ page: \"2\", limit: \"50\" });\n// → { page: 2, limit: 50 } ✅\n\n// ─────────────────────────────────────────────────────────────\n// 🛒 Product schema with prices — real-world example\n// Cross-field validation: promotional price < original price\n// ─────────────────────────────────────────────────────────────\nexport const ProductSchema = z\n  .object({\n    name: NameSchema,\n    price: PriceSchema,\n    salePrice: PriceSchema.nullable().optional(),\n    stock: QuantitySchema,\n    discountRate: PercentageSchema.default(0),\n  })\n  .refine((data) => !data.salePrice || data.salePrice < data.price, {\n    message: \"Sale price must be lower than the original price\",\n    path: [\"salePrice\"],\n  });\n\nexport type ProductInput = z.infer<typeof ProductSchema>;\n\n// ─────────────────────────────────────────────────────────────\n// ✅ Usage examples\n// ─────────────────────────────────────────────────────────────\n\n// Valid product\nProductSchema.parse({\n  name: \"Wireless Headphones\",\n  price: 199.99,\n  salePrice: 149.99,\n  stock: 50,\n  discountRate: 25,\n}); // ✅\n\n// Invalid — sale price higher than original\nProductSchema.safeParse({\n  name: \"Keyboard\",\n  price: 99.99,\n  salePrice: 149.99, // ❌ → \"Sale price must be lower than the original price\"\n  stock: 10,\n});\n\n// Query params coercion\nPaginationSchema.parse({ page: \"3\", limit: \"25\" });\n// → { page: 3, limit: 25 } ✅\n"],"version":3}