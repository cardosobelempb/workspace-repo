{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\Mutable.ts","mappings":";AAAA;;2FAE2F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\Mutable.ts"],"sourcesContent":["/* =====================================================================================\n *  MUTABLE<T>\n * ===================================================================================== */\n\n/**\n * Remove readonly de todas as propriedades.\n *\n * Atenção: deve ser usado com parcimônia.\n *\n * @example\n * type User = { readonly id: string; readonly name: string }\n * type WritableUser = Mutable<User>\n */\nexport type Mutable<T> = {\n  -readonly [P in keyof T]: T[P];\n};\n"],"version":3}