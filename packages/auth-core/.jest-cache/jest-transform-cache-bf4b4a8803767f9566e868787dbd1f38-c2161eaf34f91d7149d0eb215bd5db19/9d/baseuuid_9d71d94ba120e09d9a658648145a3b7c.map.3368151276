{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\utils\\base-uuid.ts","mappings":";;;AAAA,MAAsB,QAAQ;CAG7B;AAHD,4BAGC;AAED;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;GA8BG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\utils\\base-uuid.ts"],"sourcesContent":["export abstract class BaseUuid {\n  abstract getId(): string;\n  abstract equals(entity: BaseUuid): boolean;\n}\n\n/**\n * 👇 Exemplo de uso:\n Agora, uma entidade que implementa esse contrato:\n // domain/User.ts\nimport { UUIDContract } from '../core/contracts/UUIDContract';\nimport { v4 as uuidv4, validate as validateUUID } from 'uuid';\n\nexport class User extends UUIDContract {\n  private readonly _id: string;\n  public readonly name: string;\n\n  constructor(name: string, id?: string) {\n    super();\n    if (id && !validateUUID(id)) {\n      throw new Error(`Invalid UUID: ${id}`);\n    }\n\n    this._id = id ?? uuidv4();\n    this.name = name;\n  }\n\n  public getId(): string {\n    return this._id;\n  }\n\n  public equals(other: UUIDContract): boolean {\n    return this._id === other.getId();\n  }\n}\n\n */\n"],"version":3}