{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\adapters\\pino.logger.ts","mappings":";;;;;;AAAA,gDAAoD;AAEpD,gDAA4C;AAC5C,gEAA4D;AAG5D,MAAa,UAAW,SAAQ,wBAAU;IACvB,MAAM,CAAe;IAEtC,YAAY,OAAuB,EAAE,QAAuB;QAC1D,KAAK,CAAC,OAAO,CAAC,CAAC;QAEf,IAAI,CAAC,MAAM;YACT,QAAQ;gBACR,IAAA,cAAI,EAAC;oBACH,KAAK,EAAE,OAAO,CAAC,GAAG,CAAC,SAAS,IAAI,MAAM;oBACtC,SAAS,EACP,OAAO,CAAC,GAAG,CAAC,QAAQ,KAAK,YAAY;wBACnC,CAAC,CAAC;4BACE,MAAM,EAAE,aAAa;4BACrB,OAAO,EAAE;gCACP,QAAQ,EAAE,IAAI;gCACd,aAAa,EAAE,cAAc;gCAC7B,MAAM,EAAE,cAAc;6BACvB;yBACF;wBACH,CAAC,CAAC,SAAS;iBAChB,CAAC,CAAC;IACP,CAAC;IAEO,SAAS,CAAC,IAAqB;QACrC,MAAM,OAAO,GAAG,gCAAc,CAAC,GAAG,EAAE,CAAC;QAErC,OAAO;YACL,OAAO,EAAE,IAAI,CAAC,OAAO;YACrB,SAAS,EAAE,OAAO,EAAE,SAAS;YAC7B,OAAO,EAAE,OAAO,EAAE,OAAO;YACzB,MAAM,EAAE,OAAO,EAAE,MAAM;YACvB,QAAQ,EAAE,OAAO,EAAE,QAAQ;YAC3B,cAAc,EAAE,OAAO,EAAE,cAAc;YACvC,GAAG,IAAI;SACR,CAAC;IACJ,CAAC;IAED,IAAI,CAAC,OAAe,EAAE,IAAqB;QACzC,IAAI,CAAC,MAAM,CAAC,IAAI,CAAC,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,EAAE,OAAO,CAAC,CAAC;IAClD,CAAC;IAED,IAAI,CAAC,OAAe,EAAE,IAAqB;QACzC,IAAI,CAAC,MAAM,CAAC,IAAI,CAAC,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,EAAE,OAAO,CAAC,CAAC;IAClD,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,KAAe,EAAE,IAAqB;QAC3D,IAAI,CAAC,MAAM,CAAC,KAAK,CACf,IAAI,CAAC,SAAS,CAAC;YACb,KAAK;YACL,GAAG,IAAI;SACR,CAAC,EACF,OAAO,CACR,CAAC;IACJ,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,IAAqB;QAC1C,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,EAAE,OAAO,CAAC,CAAC;IACnD,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,KAAe,EAAE,IAAqB;QAC3D,IAAI,CAAC,MAAM,CAAC,KAAK,CACf,IAAI,CAAC,SAAS,CAAC;YACb,KAAK;YACL,GAAG,IAAI;SACR,CAAC,EACF,OAAO,CACR,CAAC;IACJ,CAAC;IAED,KAAK,CAAC,OAAe;QACnB,OAAO,IAAI,UAAU,CAAC,EAAE,OAAO,EAAE,EAAE,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,EAAE,OAAO,EAAE,CAAC,CAAC,CAAC;IACrE,CAAC;CACF;AAzED,gCAyEC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\adapters\\pino.logger.ts"],"sourcesContent":["import pino, { Logger as PinoInstance } from \"pino\";\n\nimport { BaseLogger } from \"../base-logger\";\nimport { RequestContext } from \"../context/request-context\";\nimport { LoggerMetadata, LoggerOptions } from \"../logger.types\";\n\nexport class PinoLogger extends BaseLogger {\n  private readonly logger: PinoInstance;\n\n  constructor(options?: LoggerOptions, instance?: PinoInstance) {\n    super(options);\n\n    this.logger =\n      instance ??\n      pino({\n        level: process.env.LOG_LEVEL ?? \"info\",\n        transport:\n          process.env.NODE_ENV !== \"production\"\n            ? {\n                target: \"pino-pretty\",\n                options: {\n                  colorize: true,\n                  translateTime: \"SYS:standard\",\n                  ignore: \"pid,hostname\",\n                },\n              }\n            : undefined,\n      });\n  }\n\n  private buildMeta(meta?: LoggerMetadata): LoggerMetadata {\n    const context = RequestContext.get();\n\n    return {\n      context: this.context,\n      requestId: context?.requestId,\n      traceId: context?.traceId,\n      userId: context?.userId,\n      tenantId: context?.tenantId,\n      organizationId: context?.organizationId,\n      ...meta,\n    };\n  }\n\n  info(message: string, meta?: LoggerMetadata): void {\n    this.logger.info(this.buildMeta(meta), message);\n  }\n\n  warn(message: string, meta?: LoggerMetadata): void {\n    this.logger.warn(this.buildMeta(meta), message);\n  }\n\n  error(message: string, error?: unknown, meta?: LoggerMetadata): void {\n    this.logger.error(\n      this.buildMeta({\n        error,\n        ...meta,\n      }),\n      message,\n    );\n  }\n\n  debug(message: string, meta?: LoggerMetadata): void {\n    this.logger.debug(this.buildMeta(meta), message);\n  }\n\n  fatal(message: string, error?: unknown, meta?: LoggerMetadata): void {\n    this.logger.fatal(\n      this.buildMeta({\n        error,\n        ...meta,\n      }),\n      message,\n    );\n  }\n\n  child(context: string): BaseLogger {\n    return new PinoLogger({ context }, this.logger.child({ context }));\n  }\n}\n"],"version":3}