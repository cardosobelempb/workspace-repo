AO,CAAC,CAAC;QAEhF,OAAO;YACL,OAAO,EAAE,cAAc;YACvB,QAAQ,EAAE;gBACR,UAAU,EAAE,IAAI;gBAChB,QAAQ,EAAE,OAAO;gBACjB,MAAM,EAAE,CAAC,IAAI,GAAG,CAAC,CAAC,GAAG,OAAO;gBAC5B,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,KAAK;gBACd,IAAI,EAAE;oBACJ,MAAM,EAAE,CAAC,CAAC,MAAM;oBAChB,QAAQ,EAAE,CAAC,MAAM;oBACjB,KAAK,EAAE,CAAC,MAAM;iBACf;aACF;YACD,UAAU,EAAE,IAAI,CAAC,IAAI,CAAC,aAAa,GAAG,OAAO,CAAC;YAC9C,aAAa;YACb,IAAI,EAAE,IAAI,GAAG,OAAO,IAAI,aAAa;YACrC,IAAI,EAAE,OAAO;YACb,MAAM,EAAE,IAAI;YACZ,IAAI,EAAE;gBACJ,MAAM,EAAE,CAAC,CAAC,MAAM;gBAChB,QAAQ,EAAE,CAAC,MAAM;gBACjB,KAAK,EAAE,CAAC,MAAM;aACf;YACD,gBAAgB,EAAE,cAAc,CAAC,MAAM;YACvC,KAAK,EAAE,IAAI,KAAK,CAAC;YACjB,KAAK,EAAE,cAAc,CAAC,MAAM,KAAK,CAAC;SACnC,CAAC;IACJ,CAAC;IAED;;OAEG;IACO,KAAK,CAAC,IAAI,CAAC,EAAsB;QACzC,MAAM,MAAM,GAAG,IAAI,CAAC,KAAK,CAAC,IAAI,CAC5B,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,EAAE,QAAQ,EAAE,KAAK,EAAE,IAAI,CAAC,IAAI,CAAC,SAAS,CACxD,CAAC;QACF,IAAI,CAAC,MAAM;YACT,MAAM,IAAI,+BAAa,CAAC;gBACtB,SAAS,EAAE,IAAI;gBACf,OAAO,EAAE,6BAA6B,EAAE,EAAE;aAC3C,CAAC,CAAC;QACL,OAAO,MAAM,CAAC;IAChB,CAAC;IAKD,kCAAkC;IACxB,SAAS,CACjB,KAAe,EACf,MAAqB,EACrB,gBAAgC,KAAK;QAErC,IAAI,CAAC,MAAM,IAAI,CAAC,IAAI,CAAC,cAAc,CAAC,QAAQ,CAAC,MAAM,CAAC;YAAE,OAAO,KAAK,CAAC;QAEnE,OAAO,CAAC,GAAG,KAAK,CAAC,CAAC,IAAI,CAAC,CAAC,CAAC,EAAE,CAAC,EAAE,EAAE;YAC9B,MAAM,MAAM,GAAG,CAAC,CAAC,MAAM,CAAC,CAAC;YACzB,MAAM,MAAM,GAAG,CAAC,CAAC,MAAM,CAAC,CAAC;YAEzB,IAAI,MAAM,IAAI,IAAI;gBAAE,OAAO,CAAC,CAAC;YAC7B,IAAI,MAAM,IAAI,IAAI;gBAAE,OAAO,CAAC,CAAC,CAAC;YAE9B,IAAI,OAAO,MAAM,KAAK,QAAQ,IAAI,OAAO,MAAM,KAAK,QAAQ,EAAE,CAAC;gBAC7D,OAAO,aAAa,KAAK,MAAM;oBAC7B,CAAC,CAAC,MAAM,CAAC,aAAa,CAAC,MAAM,CAAC;oBAC9B,CAAC,CAAC,MAAM,CAAC,aAAa,CAAC,MAAM,CAAC,CAAC;YACnC,CAAC;YAED,IAAI,OAAO,MAAM,KAAK,QAAQ,IAAI,OAAO,MAAM,KAAK,QAAQ,EAAE,CAAC;gBAC7D,OAAO,aAAa,KAAK,MAAM,CAAC,CAAC,CAAC,MAAM,GAAG,MAAM,CAAC,CAAC,CAAC,MAAM,GAAG,MAAM,CAAC;YACtE,CAAC;YAED,OAAO,CAAC,CAAC;QACX,CAAC,CAAC,CAAC;IACL,CAAC;IAED,kCAAkC;IACxB,KAAK,CAAC,eAAe,CAC7B,KAAe,EACf,OAAe,CAAC,EAChB,UAAkB,EAAE;QAEpB,MAAM,KAAK,GAAG,CAAC,IAAI,GAAG,CAAC,CAAC,GAAG,OAAO,CAAC;QACnC,MAAM,GAAG,GAAG,KAAK,GAAG,OAAO,CAAC;QAE5B,sCAAsC;QACtC,OAAO,KAAK,CAAC,KAAK,CAAC,KAAK,EAAE,GAAG,CAAC,CAAC;IACjC,CAAC;IAED,KAAK,CAAC,aAAa,CAAC,GAAa;QAC/B,MAAM,aAAa,GAAa,EAAE,CAAC;QACnC,KAAK,MAAM,EAAE,IAAI,GAAG,EAAE,CAAC;YACrB,IAAI,CAAC;gBACH,MAAM,MAAM,GAAG,MAAM,IAAI,CAAC,IAAI,CAAC,EAAE,CAAC,CAAC;gBACnC,aAAa,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;YAC7B,CAAC;YAAC,MAAM,CAAC;gBACP,6BAA6B;YAC/B,CAAC;QACH,CAAC;QACD,OAAO,aAAa,CAAC;IACvB,CAAC;IACD,KAAK,CAAC,MAAM,CAAC,MAAc;QACzB,MAAM,SAAS,GAAG;YAChB,GAAG,MAAM;YACT,EAAE,EAAE,MAAM,CAAC,EAAE,IAAI,gBAAM,CAAC,MAAM,EAAE;YAChC,SAAS,EAAE,MAAM,CAAC,SAAS,IAAI,IAAI,IAAI,EAAE;YACzC,SAAS,EAAE,MAAM,CAAC,SAAS,IAAI,IAAI,IAAI,EAAE;YACzC,SAAS,EAAE,IAAI;SACN,CAAC;QACZ,OAAO,IAAI,CAAC,IAAI,CAAC,SAAS,CAAC,CAAC;IAC9B,CAAC;IACD,KAAK,CAAC,MAAM,CAAC,EAAU;QACrB,MAAM,MAAM,GAAG,IAAI,CAAC,KAAK,CAAC,IAAI,CAC5B,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,EAAE,EAAE,QAAQ,EAAE,KAAK,EAAE,IAAI,CAAC,IAAI,CAAC,SAAS,CACxD,CAAC;QACF,OAAO,CAAC,CAAC,MAAM,CAAC;IAClB,CAAC;CACF;AA5MD,gDA4MC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\in-memory-repository\\repository-in-memory.ts"],"sourcesContent":["import { NotFoundError } from \"../../errors/usecases/not-found.error\";\nimport { UUIDVO } from \"../../values-objects/uuid/uuid.vo\";\nimport { PageInput } from \"../pagination\";\nimport { Page } from \"../pagination/types/pagination.types\";\nimport { ModelProps } from \"./base-repository-in-memory\";\n\n/**\n * Repositório genérico em memória\n * Útil para testes ou prototipagem\n */\nexport abstract class RepositoryInMemory<Entity extends ModelProps> {\n  constructor() {}\n  /** Armazena todas as entidades em memória */\n  protected items: Entity[] = [];\n\n  /** Campos que podem ser usados para ordenação */\n  protected sortableFields: (keyof Entity)[] = [];\n\n  /**\n   * Busca entidade por ID. Retorna null se não encontrar.\n   * @param id string\n   */\n  async findById(id: string): Promise<Entity | null> {\n    try {\n      return await this._get(id);\n    } catch {\n      return null;\n    }\n  }\n\n  /**\n   * Cria uma nova entidade em memória\n   * Não persiste\n   */\n  // newEntity(props: CreateProps<Entity>): Entity {\n  //   return {\n  //     id: randomUUID(),\n  //     createdAt: new Date(),\n  //     updatedAt: new Date(),\n  //     deletedAt: null,\n  //     ...props,\n  //   } as Entity\n  // }\n\n  /**\n   * Persiste ou atualiza a entidade em memória\n   */\n  async save(entity: Entity): Promise<Entity> {\n    if (!entity.id) {\n      entity.id = UUIDVO.create();\n      entity.createdAt = new Date();\n    }\n\n    // entity.updatedAt = new Date()\n    const index = this.items.findIndex((item) => item.id?.equals(entity.id));\n\n    if (index === -1) {\n      this.items.push(entity);\n    } else {\n      this.items[index] = entity;\n    }\n\n    return entity;\n  }\n\n  /**\n   * Soft delete da entidade\n   */\n  async delete(entity: Entity): Promise<void> {\n    await this._get(entity.id?.getValue());\n    const index = this.items.findIndex((item) => item.id === entity.id);\n\n    // if (index === -1) {\n    //   throw new NotFoundError(`Entity not found using id ${entity.id}`)\n    // }\n\n    this.items.splice(index, 1);\n    // Agora TypeScript sabe que items[index] existe\n    // this.items[index]!.deletedAt = new Date()\n  }\n\n  /**\n   * Busca paginada com filtro e ordenação\n   */\n  async page(params: PageInput): Promise<Page<Entity>> {\n    const page = params.page ?? 1;\n    const perPage = params.size ?? 10;\n    const sortBy = params.sort ?? \"\";\n    const filter = params.filter ?? \"\";\n\n    let filteredItems = await this.applyFilter(this.items, filter);\n    const totalElements = filteredItems.length;\n\n    filteredItems = this.applySort(filteredItems, sortBy as keyof Entity);\n    const paginatedItems = await this.applyPagination(filteredItems, page, perPage);\n\n    return {\n      content: paginatedItems,\n      pageable: {\n        pageNumber: page,\n        pageSize: perPage,\n        offset: (page - 1) * perPage,\n        paged: true,\n        unpaged: false,\n        sort: {\n          sorted: !!sortBy,\n          unsorted: !sortBy,\n          empty: !sortBy,\n        },\n      },\n      totalPages: Math.ceil(totalElements / perPage),\n      totalElements,\n      last: page * perPage >= totalElements,\n      size: perPage,\n      number: page,\n      sort: {\n        sorted: !!sortBy,\n        unsorted: !sortBy,\n        empty: !sortBy,\n      },\n      numberOfElements: paginatedItems.length,\n      first: page === 1,\n      empty: paginatedItems.length === 0,\n    };\n  }\n\n  /**\n   * Busca entidade por ID ou lança erro\n   */\n  protected async _get(id: string | undefined): Promise<Entity> {\n    const entity = this.items.find(\n      (item) => item.id?.getValue() === id && !item.deletedAt,\n    );\n    if (!entity)\n      throw new NotFoundError({\n        fieldName: \"id\",\n        message: `Entity not found using id ${id}`,\n      });\n    return entity;\n  }\n\n  /** Filtro abstrato para ser implementado nas subclasses */\n  protected abstract applyFilter(items: Entity[], filter?: string): Promise<Entity[]>;\n\n  /** Ordenação genérica e segura */\n  protected applySort(\n    items: Entity[],\n    sortBy?: keyof Entity,\n    sortDirection: \"asc\" | \"desc\" = \"asc\",\n  ): Entity[] {\n    if (!sortBy || !this.sortableFields.includes(sortBy)) return items;\n\n    return [...items].sort((a, b) => {\n      const aValue = a[sortBy];\n      const bValue = b[sortBy];\n\n      if (aValue == null) return 1;\n      if (bValue == null) return -1;\n\n      if (typeof aValue === \"string\" && typeof bValue === \"string\") {\n        return sortDirection === \"desc\"\n          ? bValue.localeCompare(aValue)\n          : aValue.localeCompare(bValue);\n      }\n\n      if (typeof aValue === \"number\" && typeof bValue === \"number\") {\n        return sortDirection === \"desc\" ? bValue - aValue : aValue - bValue;\n      }\n\n      return 0;\n    });\n  }\n\n  /** Paginação genérica de itens */\n  protected async applyPagination(\n    items: Entity[],\n    page: number = 1,\n    perPage: number = 10,\n  ): Promise<Entity[]> {\n    const start = (page - 1) * perPage;\n    const end = start + perPage;\n\n    // Retorna uma cópia paginada do array\n    return items.slice(start, end);\n  }\n\n  async findManyByIds(ids: string[]): Promise<Entity[]> {\n    const foundEntities: Entity[] = [];\n    for (const id of ids) {\n      try {\n        const entity = await this._get(id);\n        foundEntities.push(entity);\n      } catch {\n        // Ignora IDs não encontrados\n      }\n    }\n    return foundEntities;\n  }\n  async create(entity: Entity): Promise<Entity> {\n    const newEntity = {\n      ...entity,\n      id: entity.id ?? UUIDVO.create(),\n      createdAt: entity.createdAt ?? new Date(),\n      updatedAt: entity.updatedAt ?? new Date(),\n      deletedAt: null,\n    } as Entity;\n    return this.save(newEntity);\n  }\n  async exists(id: string): Promise<boolean> {\n    const entity = this.items.find(\n      (item) => item.id?.getValue() === id && !item.deletedAt,\n    );\n    return !!entity;\n  }\n}\n"],"version":3}