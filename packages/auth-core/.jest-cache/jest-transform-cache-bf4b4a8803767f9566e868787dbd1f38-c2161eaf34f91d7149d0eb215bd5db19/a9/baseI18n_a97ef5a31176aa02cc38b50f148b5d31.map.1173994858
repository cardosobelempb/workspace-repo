{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\utils\\base-I18n.ts","mappings":";;;AAAA,MAAsB,QAAQ;CAkB7B;AAlBD,4BAkBC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\utils\\base-I18n.ts"],"sourcesContent":["export abstract class BaseI18n {\n  /**\n   * Traduz uma chave usando o sistema de internacionalização.\n   * @param key - A chave da tradução (ex: \"errors.name.empty\")\n   * @param args - Argumentos para interpolação (opcional)\n   */\n  abstract t(key: string, args?: Record<string, unknown>): string;\n\n  /**\n   * Altera o idioma atual.\n   * @param lng - Código do idioma (ex: \"en\", \"pt\")\n   */\n  abstract changeLanguage(lng: string): Promise<void>;\n\n  /**\n   * Retorna o idioma atual.\n   */\n  abstract getCurrentLanguage(): string;\n}\n"],"version":3}