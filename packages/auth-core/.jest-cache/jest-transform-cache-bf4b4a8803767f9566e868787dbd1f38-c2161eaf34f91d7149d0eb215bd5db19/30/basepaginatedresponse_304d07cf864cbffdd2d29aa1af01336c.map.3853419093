{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\repositories\\base-paginated-response.ts","mappings":";;;AAAA,mDAA+C;AAC/C,2CAAuC;AAEvC;;GAEG;AACH,MAAa,qBAAqB;IAEd;IACA;IAEA;IACA;IACA;IAEA;IACA;IAEA;IAEA;IACA;IACA;IAflB,YACkB,OAAY,EACZ,QAAsB,EAEtB,IAAa,EACb,UAAkB,EAClB,aAAqB,EAErB,IAAY,EACZ,MAAc,EAEd,IAAc,EAEd,KAAc,EACd,gBAAwB,EACxB,KAAc;QAdd,YAAO,GAAP,OAAO,CAAK;QACZ,aAAQ,GAAR,QAAQ,CAAc;QAEtB,SAAI,GAAJ,IAAI,CAAS;QACb,eAAU,GAAV,UAAU,CAAQ;QAClB,kBAAa,GAAb,aAAa,CAAQ;QAErB,SAAI,GAAJ,IAAI,CAAQ;QACZ,WAAM,GAAN,MAAM,CAAQ;QAEd,SAAI,GAAJ,IAAI,CAAU;QAEd,UAAK,GAAL,KAAK,CAAS;QACd,qBAAgB,GAAhB,gBAAgB,CAAQ;QACxB,UAAK,GAAL,KAAK,CAAS;IAC7B,CAAC;IAEJ,MAAM,CAAC,gBAAgB,CAAI,MAQ1B;QACC,MAAM,EAAE,KAAK,EAAE,KAAK,EAAE,UAAU,EAAE,WAAW,EAAE,OAAO,EAAE,MAAM,EAAE,GAAG,MAAM,CAAC;QAE1E;;WAEG;QACH,MAAM,UAAU,GAAG,IAAI,CAAC,GAAG,CAAC,WAAW,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;QAEhD,MAAM,IAAI,GAAG,IAAI,oBAAQ,CAAC,CAAC,CAAC,MAAM,EAAE,CAAC,MAAM,EAAE,CAAC,MAAM,CAAC,CAAC;QAEtD,MAAM,QAAQ,GAAG,IAAI,4BAAY,CAC/B,UAAU,EACV,OAAO,EACP,IAAI,EACJ,UAAU,GAAG,OAAO,EACpB,IAAI,EACJ,KAAK,CACN,CAAC;QAEF,OAAO,IAAI,qBAAqB,CAC9B,KAAK,EACL,QAAQ,EAER,WAAW,IAAI,UAAU,EACzB,UAAU,EACV,KAAK,EAEL,OAAO,EACP,UAAU,EAEV,IAAI,EAEJ,WAAW,KAAK,CAAC,EACjB,KAAK,CAAC,MAAM,EACZ,KAAK,CAAC,MAAM,KAAK,CAAC,CACnB,CAAC;IACJ,CAAC;CACF;AAhED,sDAgEC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\repositories\\base-paginated-response.ts"],"sourcesContent":["import { BasePageable } from \"./base-pageable\";\nimport { BaseSort } from \"./base-sort\";\n\n/**\n * Paginated response output\n */\nexport class BasePaginatedResponse<T> {\n  constructor(\n    public readonly content: T[],\n    public readonly pageable: BasePageable,\n\n    public readonly last: boolean,\n    public readonly totalPages: number,\n    public readonly totalElements: number,\n\n    public readonly size: number,\n    public readonly number: number,\n\n    public readonly sort: BaseSort,\n\n    public readonly first: boolean,\n    public readonly numberOfElements: number,\n    public readonly empty: boolean,\n  ) {}\n\n  static fromSearchOutput<T>(params: {\n    items: T[];\n    total: number;\n    totalPages: number;\n    currentPage: number;\n    perPage: number;\n    sortBy: string | null;\n    sortDirection: \"asc\" | \"desc\";\n  }): BasePaginatedResponse<T> {\n    const { items, total, totalPages, currentPage, perPage, sortBy } = params;\n\n    /**\n     * Spring Boot usa página iniciando em 0\n     */\n    const pageNumber = Math.max(currentPage - 1, 0);\n\n    const sort = new BaseSort(!!sortBy, !sortBy, !sortBy);\n\n    const pageable = new BasePageable(\n      pageNumber,\n      perPage,\n      sort,\n      pageNumber * perPage,\n      true,\n      false,\n    );\n\n    return new BasePaginatedResponse<T>(\n      items,\n      pageable,\n\n      currentPage >= totalPages,\n      totalPages,\n      total,\n\n      perPage,\n      pageNumber,\n\n      sort,\n\n      currentPage === 1,\n      items.length,\n      items.length === 0,\n    );\n  }\n}\n"],"version":3}