{"file":"E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\otp-code.factory.ts","mappings":";;;AAAA,yCAAiE;AACjE,2EAAsE;AAGtE,MAAa,cAAc;IACzB,MAAM,CAAC,KAAK,CAAC,KAAuB;QAClC,OAAO,+BAAa,CAAC,MAAM,CAAC;YAC1B,KAAK,EAAE,gBAAO,CAAC,MAAM,CAAC,KAAK,CAAC,KAAK,CAAC;YAClC,QAAQ,EAAE,KAAK,CAAC,QAAQ;YACxB,OAAO,EAAE,gBAAgB,EAAE,gCAAgC;YAC3D,QAAQ,EAAE,CAAC;YACX,WAAW,EAAE,CAAC,EAAE,gCAAgC;YAChD,SAAS,EAAE,IAAI,IAAI,CAAC,KAAK,CAAC,SAAS,CAAC;YACpC,SAAS,EAAE,KAAK,CAAC,SAAS,CAAC,CAAC,CAAC,oBAAW,CAAC,MAAM,CAAC,KAAK,CAAC,SAAS,CAAC,CAAC,CAAC,CAAC,IAAI;YACvE,SAAS,EAAE,KAAK,CAAC,SAAS,CAAC,CAAC,CAAC,oBAAW,CAAC,MAAM,CAAC,KAAK,CAAC,SAAS,CAAC,CAAC,CAAC,CAAC,IAAI;SACxE,CAAC,CAAC;IACL,CAAC;CACF;AAbD,wCAaC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\otp-code.factory.ts"],"sourcesContent":["import { EmailVO, IpAddressVO, UserAgentVO } from \"@repo/common\";\r\nimport { OtpCodeEntity } from \"../../domain/entities/otp-code.entity\";\r\nimport { OtpCodeCreateDto } from \"../dto\";\r\n\r\nexport class OtpCodeFactory {\r\n  static build(input: OtpCodeCreateDto): OtpCodeEntity {\r\n    return OtpCodeEntity.create({\r\n      email: EmailVO.create(input.email),\r\n      codeHash: input.codeHash,\r\n      purpose: \"authentication\", // You can adjust this as needed\r\n      attempts: 0,\r\n      maxAttempts: 5, // You can adjust this as needed\r\n      expiredAt: new Date(input.expiredAt),\r\n      ipAddress: input.ipAddress ? IpAddressVO.create(input.ipAddress) : null,\r\n      userAgent: input.userAgent ? UserAgentVO.create(input.userAgent) : null,\r\n    });\r\n  }\r\n}\r\n"],"version":3}