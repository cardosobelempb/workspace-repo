{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\object-utils.ts","mappings":";;;AAAA,MAAa,WAAW;IACtB,gBAAuB,CAAC;IAExB,8EAA8E;IAC9E,eAAe;IACf,8EAA8E;IAE9E;;OAEG;IACH,MAAM,CAAC,QAAQ,CAAC,KAAc;QAC5B,OAAO,CACL,KAAK,KAAK,IAAI;YACd,OAAO,KAAK,KAAK,QAAQ;YACzB,CAAC,KAAK,CAAC,OAAO,CAAC,KAAK,CAAC;YACrB,CAAC,CAAC,KAAK,YAAY,IAAI,CAAC,CACzB,CAAC;IACJ,CAAC;IAED,8EAA8E;IAC9E,UAAU;IACV,8EAA8E;IAE9E;;;OAGG;IACH,MAAM,CAAC,oBAAoB,CAAI,KAAQ;QACrC,OAAO,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,SAAS,CAAC,KAAK,CAAC,CAAC,CAAC;IAC3C,CAAC;IAED;;;OAGG;IACH,MAAM,CAAC,SAAS,CAAI,KAAQ;QAC1B,yCAAyC;QACzC,IAAI,OAAO,eAAe,KAAK,UAAU,EAAE,CAAC;YAC1C,IAAI,CAAC;gBACH,OAAO,eAAe,CAAC,KAAK,CAAC,CAAC;YAChC,CAAC;YAAC,MAAM,CAAC;gBACP,kBAAkB;YACpB,CAAC;QACH,CAAC;QACD,OAAO,IAAI,CAAC,oBAAoB,CAAC,KAAK,CAAC,CAAC;IAC1C,CAAC;IAED,8EAA8E;IAC9E,eAAe;IACf,8EAA8E;IAE9E;;;;;;OAMG;IACH,MAAM,CAAC,OAAO,CAAC,KAAc;QAC3B,IAAI,KAAK,IAAI,IAAI;YAAE,OAAO,IAAI,CAAC;QAC/B,IAAI,KAAK,CAAC,OAAO,CAAC,KAAK,CAAC;YAAE,OAAO,KAAK,CAAC,MAAM,KAAK,CAAC,CAAC;QACpD,IAAI,IAAI,CAAC,QAAQ,CAAC,KAAK,CAAC;YAAE,OAAO,MAAM,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC,MAAM,KAAK,CAAC,CAAC;QACjE,OAAO,KAAK,CAAC;IACf,CAAC;IAED,8EAA8E;IAC9E,aAAa;IACb,8EAA8E;IAE9E;;;;OAIG;IACH,MAAM,CAAC,SAAS,CAAmB,MAAS,EAAE,MAAkB;QAC9D,IAAI,CAAC,IAAI,CAAC,QAAQ,CAAC,MAAM,CAAC,IAAI,CAAC,IAAI,CAAC,QAAQ,CAAC,MAAM,CAAC,EAAE,CAAC;YACrD,OAAO,MAAW,CAAC;QACrB,CAAC;QAED,MAAM,MAAM,GAAG,EAAE,GAAG,MAAM,EAAyB,CAAC;QAEpD,KAAK,MAAM,GAAG,IAAI,MAAM,EAAE,CAAC;YACzB,MAAM,WAAW,GAAG,MAAM,CAAC,GAAG,CAAC,CAAC;YAChC,MAAM,WAAW,GAAG,MAAM,CAAC,GAAG,CAAC,CAAC;YAEhC,IAAI,IAAI,CAAC,QAAQ,CAAC,WAAW,CAAC,EAAE,CAAC;gBAC/B,MAAM,CAAC,GAAG,CAAC,GAAG,IAAI,CAAC,SAAS,CAC1B,IAAI,CAAC,QAAQ,CAAC,WAAW,CAAC,CAAC,CAAC,CAAC,WAAW,CAAC,CAAC,CAAC,EAAE,EAC7C,WAAW,CACZ,CAAC;YACJ,CAAC;iBAAM,CAAC;gBACN,MAAM,CAAC,GAAG,CAAC,GAAG,WAAW,CAAC;YAC5B,CAAC;QACH,CAAC;QAED,OAAO,MAAW,CAAC;IACrB,CAAC;CACF;AAjGD,kCAiGC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\object-utils.ts"],"sourcesContent":["export class ObjectUtils {\n  private constructor() {}\n\n  // ---------------------------------------------------------------------------\n  // Basic Checks\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Retorna `true` se for um objeto simples (exclui arrays, null, Date, etc.)\n   */\n  static isObject(value: unknown): value is Record<string, any> {\n    return (\n      value !== null &&\n      typeof value === \"object\" &&\n      !Array.isArray(value) &&\n      !(value instanceof Date)\n    );\n  }\n\n  // ---------------------------------------------------------------------------\n  // Cloning\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Conversão segura para objeto plano JSON (sem funções, Date, Map etc.)\n   * OBS: valores não-serializáveis serão perdidos.\n   */\n  static convertToPlainObject<T>(value: T): T {\n    return JSON.parse(JSON.stringify(value));\n  }\n\n  /**\n   * Deep clone usando serialização. Para objetos muito complexos, recomenda-se\n   * usar structuredClone (Node 17+ / browsers modernos).\n   */\n  static deepClone<T>(value: T): T {\n    // Caso ambiente suporte structuredClone:\n    if (typeof structuredClone === \"function\") {\n      try {\n        return structuredClone(value);\n      } catch {\n        // fallback abaixo\n      }\n    }\n    return this.convertToPlainObject(value);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Empty checks\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Verifica se um valor é \"vazio\":\n   *  - null, undefined → true\n   *  - [] → true\n   *  - {} → true\n   *  - outros tipos → false\n   */\n  static isEmpty(value: unknown): boolean {\n    if (value == null) return true;\n    if (Array.isArray(value)) return value.length === 0;\n    if (this.isObject(value)) return Object.keys(value).length === 0;\n    return false;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Deep Merge\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Merge profundo entre dois objetos.\n   * - Valores escalares sobrescrevem o target\n   * - Objetos são mesclados recursivamente\n   */\n  static mergeDeep<T extends object>(target: T, source: Partial<T>): T {\n    if (!this.isObject(target) || !this.isObject(source)) {\n      return source as T;\n    }\n\n    const result = { ...target } as Record<string, any>;\n\n    for (const key in source) {\n      const sourceValue = source[key];\n      const targetValue = result[key];\n\n      if (this.isObject(sourceValue)) {\n        result[key] = this.mergeDeep(\n          this.isObject(targetValue) ? targetValue : {},\n          sourceValue,\n        );\n      } else {\n        result[key] = sourceValue;\n      }\n    }\n\n    return result as T;\n  }\n}\n"],"version":3}