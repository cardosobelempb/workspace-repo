{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\pagination-response.schema.ts","mappings":";AAAA,+DAA+D;AAC/D,0BAA0B;AAC1B,oEAAoE;AACpE,+DAA+D;;;AAE/D,6BAAwB;AACxB,uDAAmD;AACnD,+CAA2C;AAE3C;;;;;;;;;GASG;AACI,MAAM,kBAAkB,GAAG,CAAyB,aAAgB,EAAE,EAAE,CAC7E,OAAC,CAAC,MAAM,CAAC;IACP,OAAO,EAAE,OAAC,CAAC,KAAK,CAAC,aAAa,CAAC;IAC/B,QAAQ,EAAE,gCAAc;IACxB,UAAU,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAC1C,aAAa,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAC7C,IAAI,EAAE,OAAC,CAAC,OAAO,EAAE;IACjB,IAAI,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,QAAQ,EAAE;IACjC,MAAM,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IACtC,IAAI,EAAE,wBAAU;IAChB,gBAAgB,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAChD,KAAK,EAAE,OAAC,CAAC,OAAO,EAAE;IAClB,KAAK,EAAE,OAAC,CAAC,OAAO,EAAE;CACnB,CAAC,CAAC;AAbQ,QAAA,kBAAkB,sBAa1B;AAEL,iFAAiF;AACjF,uDAAuD;AACvD,+DAA+D;AAC/D,6FAA6F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\pagination-response.schema.ts"],"sourcesContent":["// ============================================================\n// page-response.schema.ts\n// Schema Zod genérico para validação/parsing de respostas paginadas\n// ============================================================\n\nimport { z } from \"zod\";\nimport { PageableSchema } from \"./pageable.schema\";\nimport { SortSchema } from \"./sort.schema\";\n\n/**\n * Factory de schema paginado — recebe o schema do conteúdo e retorna\n * o schema completo no contrato Spring Data Page<T>.\n *\n * @param contentSchema - Schema Zod do item individual do content\n *\n * @example\n * const OrganizationPageSchema = PageResponseSchema(OrganizationSchema);\n * type OrganizationPage = z.infer<typeof OrganizationPageSchema>;\n */\nexport const PageResponseSchema = <T extends z.ZodTypeAny>(contentSchema: T) =>\n  z.object({\n    content: z.array(contentSchema),\n    pageable: PageableSchema,\n    totalPages: z.number().int().nonnegative(),\n    totalElements: z.number().int().nonnegative(),\n    last: z.boolean(),\n    size: z.number().int().positive(),\n    number: z.number().int().nonnegative(),\n    sort: SortSchema,\n    numberOfElements: z.number().int().nonnegative(),\n    first: z.boolean(),\n    empty: z.boolean(),\n  });\n\n// ─── Tipos inferidos ──────────────────────────────────────────────────────────\n// export type SortSchema = z.infer<typeof SortSchema>;\n// export type PageableSchema = z.infer<typeof PageableSchema>;\n// export type PageResponse<T> = ReturnType<typeof PageResponseSchema<z.ZodType<T>>>[\"type\"];\n"],"version":3}