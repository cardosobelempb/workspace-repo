{"file":"E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\email-verification-token.factory.ts","mappings":";;;AAAA,yCAAsC;AACtC,oDAAqE;AAGrE,MAAa,6BAA6B;IACxC,MAAM,CAAC,KAAK,CAAC,KAAsC;QACjD,OAAO,uCAA4B,CAAC,MAAM,CAAC;YACzC,MAAM,EAAE,eAAM,CAAC,MAAM,CAAC,KAAK,CAAC,MAAM,CAAC;YACnC,SAAS,EAAE,KAAK,CAAC,SAAS;YAC1B,SAAS,EAAE,IAAI,IAAI,CAAC,KAAK,CAAC,SAAS,CAAC;YACpC,MAAM,EAAE,IAAI;SACb,CAAC,CAAC;IACL,CAAC;CACF;AATD,sEASC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\email-verification-token.factory.ts"],"sourcesContent":["import { UUIDVO } from \"@repo/common\";\r\nimport { EmailVerificationTokenEntity } from \"../../domain/entities\";\r\nimport { EmailVerificationTokenCreateDto } from \"../dto\";\r\n\r\nexport class EmailVerificationTokenFactory {\r\n  static build(input: EmailVerificationTokenCreateDto): EmailVerificationTokenEntity {\r\n    return EmailVerificationTokenEntity.create({\r\n      userId: UUIDVO.create(input.userId),\r\n      tokenHash: input.tokenHash,\r\n      expiresAt: new Date(input.expiresAt),\r\n      usedAt: null,\r\n    });\r\n  }\r\n}\r\n"],"version":3}