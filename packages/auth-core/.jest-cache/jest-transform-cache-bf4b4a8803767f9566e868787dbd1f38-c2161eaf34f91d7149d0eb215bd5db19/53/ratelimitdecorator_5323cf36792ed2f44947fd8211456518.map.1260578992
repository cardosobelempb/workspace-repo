{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\rate-limit.decorator.ts","mappings":";AAAA,qDAAqD;;AAgBrD,8BAMC;AApBD,yCAAyC;AAQzC;;;;;GAKG;AACH,SAAgB,SAAS,CAAC,OAAyB;IACjD,OAAO,UAAU,MAAc,EAAE,WAA4B;QAC3D,IAAA,sBAAW,EAAC,MAAM,CAAC,WAAW,EAAE,MAAM,CAAC,WAAW,CAAC,EAAE;YACnD,SAAS,EAAE,OAAO;SACnB,CAAC,CAAC;IACL,CAAC,CAAC;AACJ,CAAC;AAED;;;;;;;;;GASG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\rate-limit.decorator.ts"],"sourcesContent":["// src/shared/http/decorators/rate-limit.decorator.ts\n\nimport { updateRoute } from \"./metadata\";\nimport type { RateLimitWindow } from \"./types/types\";\n\ntype RateLimitOptions = {\n  max: number;\n  window: RateLimitWindow;\n};\n\n/**\n * Limita quantidade de chamadas em uma janela de tempo.\n *\n * Exemplo:\n * @RateLimit({ max: 10, window: \"1m\" })\n */\nexport function RateLimit(options: RateLimitOptions) {\n  return function (target: object, propertyKey: string | symbol): void {\n    updateRoute(target.constructor, String(propertyKey), {\n      rateLimit: options,\n    });\n  };\n}\n\n/**\n * Define que a rota é pública, ou seja, não requer autenticação.\n *\n * Exemplo:\n * @Get(\"/\")\n * @RateLimit({ max: 10, window: \"1m\" })\n * async listUsers() {\n * return this.usersService.findAll();\n * }\n */\n"],"version":3}