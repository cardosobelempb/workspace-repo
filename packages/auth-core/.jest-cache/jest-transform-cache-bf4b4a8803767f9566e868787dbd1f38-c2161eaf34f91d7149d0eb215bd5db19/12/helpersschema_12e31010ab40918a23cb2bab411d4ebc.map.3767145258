{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\helpers.schema.ts","mappings":";;;AAAA,6BAAwB;AAExB,+EAA+E;AAC/E,kEAAkE;AAElE,mCAAmC;AACtB,QAAA,WAAW,GAAG,OAAC,CAAC,MAAM,EAAE,CAAC,KAAK,CAAC,uBAAuB,CAAC,CAAC;AAGrE,8CAA8C;AACjC,QAAA,cAAc,GAAG,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,CAAC,CAAC,EAAE,wCAAwC,CAAC,CAAC;AAG1F,wEAAwE;AAC3D,QAAA,UAAU,GAAG,OAAC,CAAC,MAAM,EAAE,CAAC,IAAI,CAAC,qBAAqB,CAAC,CAAC;AAGjE,2DAA2D;AAC9C,QAAA,gBAAgB,GAAG,OAAC;KAC9B,KAAK,CAAC,CAAC,OAAC,CAAC,MAAM,EAAE,EAAE,OAAC,CAAC,IAAI,EAAE,CAAC,CAAC;KAC7B,SAAS,CAAC,CAAC,GAAG,EAAE,EAAE,CAAC,CAAC,GAAG,YAAY,IAAI,CAAC,CAAC,CAAC,GAAG,CAAC,WAAW,EAAE,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC,CAAC;AAGvE,qEAAqE;AACxD,QAAA,iBAAiB,GAAG,OAAC,CAAC,MAAM,EAAE,CAAC,QAAQ,CAAC,EAAE,MAAM,EAAE,IAAI,EAAE,CAAC,CAAC;AAGvE,gDAAgD;AACnC,QAAA,SAAS,GAAG,OAAC;KACvB,MAAM,EAAE;KACR,KAAK,CAAC,gCAAgC,EAAE,yBAAyB,CAAC,CAAC;AAGtE,oFAAoF;AACvE,QAAA,WAAW,GAAG,OAAC;KACzB,MAAM,EAAE;KACR,KAAK,CAAC,yBAAyB,EAAE,sBAAsB,CAAC,CAAC;AAG5D,oEAAoE;AAC7D,MAAM,aAAa,GAAG,CAAC,KAAa,EAAY,EAAE;IACvD,OAAO,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,GAAG,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,IAAI,EAAE,CAAC,CAAC;AACrD,CAAC,CAAC;AAFW,QAAA,aAAa,iBAExB;AAEF,iFAAiF;AACjF,qEAAqE;AAC9D,MAAM,wBAAwB,GAAG,CACtC,MAAsB,EACtB,SAAiE;IAC/D,YAAY,EAAE,cAAc;IAC5B,oBAAoB,EAAE,sBAAsB;CAC7C,EACD,EAAE;IACF,OAAO,MAAM,CAAC,WAAW,CAAC,CAAC,IAAI,EAAE,GAAG,EAAE,EAAE;QACtC,MAAM,MAAM,GAAG,IAA+B,CAAC;QAE/C,IAAI,MAAM,CAAC,MAAM,CAAC,YAAY,CAAC,KAAK,MAAM,CAAC,MAAM,CAAC,oBAAoB,CAAC,EAAE,CAAC;YACxE,GAAG,CAAC,QAAQ,CAAC;gBACX,IAAI,EAAE,OAAC,CAAC,YAAY,CAAC,MAAM;gBAC3B,OAAO,EAAE,wBAAwB;gBACjC,IAAI,EAAE,CAAC,MAAM,CAAC,oBAAoB,CAAC;aACpC,CAAC,CAAC;QACL,CAAC;IACH,CAAC,CAAC,CAAC;AACL,CAAC,CAAC;AAlBW,QAAA,wBAAwB,4BAkBnC;AAEF,gFAAgF;AAChF,mFAAmF;AACtE,QAAA,aAAa,GAAG,OAAC;KAC3B,IAAI,CAAC,CAAC,aAAa,EAAE,YAAY,EAAE,MAAM,CAAC,CAAC;KAC3C,OAAO,CAAC,aAAa,CAAC,CAAC;AAE1B,iCAAiC;AAEpB,QAAA,cAAc,GAAG,OAAC,CAAC,IAAI,CAAC,CAAC,OAAO,EAAE,MAAM,EAAE,MAAM,EAAE,OAAO,CAAC,CAAC,CAAC,OAAO,CAAC,MAAM,CAAC,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\helpers.schema.ts"],"sourcesContent":["import { z } from \"zod\";\n\n// ── Common schema helpers ───────────────────────────────────────────────────\n// ✅ Tipos e validações comuns para os schemas de toda a aplicação\n\n// ✅ Email com validação de formato\nexport const EmailString = z.string().email(\"Invalid email address\");\nexport type EmailStringType = z.infer<typeof EmailString>;\n\n// ✅ Senha com validação de comprimento mínimo\nexport const PasswordString = z.string().min(6, \"Password must be at least 6 characters\");\nexport type PasswordStringType = z.infer<typeof PasswordString>;\n\n// ✅ UUID como string pura, sem transformação, para o Fastify serializar\nexport const UUIDString = z.string().uuid(\"Invalid UUID format\");\nexport type UUIDStringType = z.infer<typeof UUIDString>;\n\n// ✅ Para INPUT (body) — aceita Date ou string e transforma\nexport const IsoDateTimeInput = z\n  .union([z.string(), z.date()])\n  .transform((val) => (val instanceof Date ? val.toISOString() : val));\nexport type IsoDateTimeInputType = z.infer<typeof IsoDateTimeInput>;\n\n// ✅ Para OUTPUT (response) — sempre string pura, sem union/transform\nexport const IsoDateTimeOutput = z.string().datetime({ offset: true });\nexport type IsoDateTimeOutputType = z.infer<typeof IsoDateTimeOutput>;\n\n// ✅ Validações customizadas para CPF e telefone\nexport const CpfString = z\n  .string()\n  .regex(/^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$/, \"CPF must have 11 digits\");\nexport type CpfStringType = z.infer<typeof CpfString>;\n\n// ✅ Validação simples para números de telefone (ajuste a regex conforme necessário)\nexport const PhoneString = z\n  .string()\n  .regex(/^\\+?[\\d\\s\\-().]{10,20}$/, \"Invalid phone number\");\nexport type PhoneStringType = z.infer<typeof PhoneString>;\n\n// ✅ Helper para transformar strings separadas por vírgula em arrays\nexport const parseEnvArray = (value: string): string[] => {\n  return value.split(\",\").map((item) => item.trim());\n};\n\n// ── Password confirmation helper ──────────────────────────────────────────────\n// ✅ Adiciona validação de confirmação de senha a um schema existente\nexport const withPasswordConfirmation = <T extends z.ZodRawShape>(\n  schema: z.ZodObject<T>,\n  fields: { passwordHash: string; passwordConfirmation: string } = {\n    passwordHash: \"passwordHash\",\n    passwordConfirmation: \"passwordConfirmation\",\n  },\n) => {\n  return schema.superRefine((data, ctx) => {\n    const record = data as Record<string, unknown>;\n\n    if (record[fields.passwordHash] !== record[fields.passwordConfirmation]) {\n      ctx.addIssue({\n        code: z.ZodIssueCode.custom,\n        message: \"Passwords do not match\",\n        path: [fields.passwordConfirmation],\n      });\n    }\n  });\n};\n\n// ── Environment variable schemas ─────────────────────────────────────────────\n// ✅ Schemas específicos para variáveis de ambiente, com validação e valores padrão\nexport const nodeEnvSchema = z\n  .enum([\"development\", \"production\", \"test\"])\n  .default(\"development\");\n\n// ✅ Log level with default value\n\nexport const logLevelSchema = z.enum([\"debug\", \"info\", \"warn\", \"error\"]).default(\"info\");\n"],"version":3}