{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\page.mapper.ts","mappings":";;;AAYA,MAAa,UAAU;IACrB,MAAM,CAAC,MAAM,CAAiB,EAC5B,IAAI,EACJ,KAAK,EACL,IAAI,EACJ,IAAI,EACJ,MAAM,EACN,MAAM,GAAG,KAAK,GACc;QAC5B,MAAM,MAAM,GAAG,IAAI,GAAG,IAAI,CAAC;QAE3B,OAAO;YACL,OAAO,EAAE,IAAI,CAAC,GAAG,CAAC,MAAM,CAAC;YAEzB,QAAQ,EAAE;gBACR,MAAM;gBACN,UAAU,EAAE,IAAI;gBAChB,QAAQ,EAAE,IAAI;gBAEd,KAAK,EAAE,IAAI;gBACX,OAAO,EAAE,KAAK;gBAEd,IAAI,EAAE;oBACJ,MAAM;oBACN,QAAQ,EAAE,CAAC,MAAM;oBACjB,KAAK,EAAE,CAAC,MAAM;iBACf;aACF;YAED,UAAU,EAAE,IAAI,CAAC,IAAI,CAAC,KAAK,GAAG,IAAI,CAAC;YAEnC,aAAa,EAAE,KAAK;YAEpB,IAAI,EAAE,IAAI,IAAI,IAAI,CAAC,IAAI,CAAC,KAAK,GAAG,IAAI,CAAC,GAAG,CAAC;YAEzC,IAAI;YAEJ,MAAM,EAAE,IAAI;YAEZ,IAAI,EAAE;gBACJ,MAAM;gBACN,QAAQ,EAAE,CAAC,MAAM;gBACjB,KAAK,EAAE,CAAC,MAAM;aACf;YAED,gBAAgB,EAAE,IAAI,CAAC,MAAM;YAE7B,KAAK,EAAE,IAAI,KAAK,CAAC;YAEjB,KAAK,EAAE,IAAI,CAAC,MAAM,KAAK,CAAC;SACzB,CAAC;IACJ,CAAC;CACF;AApDD,gCAoDC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\page.mapper.ts"],"sourcesContent":["// page.mapper.ts\nimport { Page } from \"./types/pagination.types\";\n\ninterface ToPageInput<TData, TResult> {\n  data: TData[];\n  total: number;\n  page: number;\n  size: number;\n  mapper: (item: TData) => TResult;\n  sorted?: boolean;\n}\n\nexport class PageMapper {\n  static toPage<TData, TResult>({\n    data,\n    total,\n    page,\n    size,\n    mapper,\n    sorted = false,\n  }: ToPageInput<TData, TResult>): Page<TResult> {\n    const offset = page * size;\n\n    return {\n      content: data.map(mapper),\n\n      pageable: {\n        offset,\n        pageNumber: page,\n        pageSize: size,\n\n        paged: true,\n        unpaged: false,\n\n        sort: {\n          sorted,\n          unsorted: !sorted,\n          empty: !sorted,\n        },\n      },\n\n      totalPages: Math.ceil(total / size),\n\n      totalElements: total,\n\n      last: page >= Math.ceil(total / size) - 1,\n\n      size,\n\n      number: page,\n\n      sort: {\n        sorted,\n        unsorted: !sorted,\n        empty: !sorted,\n      },\n\n      numberOfElements: data.length,\n\n      first: page === 0,\n\n      empty: data.length === 0,\n    };\n  }\n}\n"],"version":3}