{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\transactional.decorator.ts","mappings":";AAAA,wDAAwD;;AAUxD,sCAMC;AAdD,yCAAyC;AAEzC;;;;;GAKG;AACH,SAAgB,aAAa;IAC3B,OAAO,UAAU,MAAc,EAAE,WAA4B;QAC3D,IAAA,sBAAW,EAAC,MAAM,CAAC,WAAW,EAAE,MAAM,CAAC,WAAW,CAAC,EAAE;YACnD,WAAW,EAAE,IAAI;SAClB,CAAC,CAAC;IACL,CAAC,CAAC;AACJ,CAAC;AAED;;;;;;;;;;;;;GAaG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\transactional.decorator.ts"],"sourcesContent":["// src/shared/http/decorators/transactional.decorator.ts\n\nimport { updateRoute } from \"./metadata\";\n\n/**\n * Marca uma rota para executar dentro de transação.\n *\n * Exemplo:\n * @Transactional()\n */\nexport function Transactional() {\n  return function (target: object, propertyKey: string | symbol): void {\n    updateRoute(target.constructor, String(propertyKey), {\n      transaction: true,\n    });\n  };\n}\n\n/**\n * Define que a rota é pública, ou seja, não requer autenticação.\n *@Post(\"/\")\n    @Transactional()\n    async createOrder(request: FastifyRequest) {\n      return this.ordersService.create(request.body);\n  }\n * Exemplo:\n * @Get(\"/\")\n * @Transactional()\n * async listUsers() {\n * return this.usersService.findAll();\n * }\n */\n"],"version":3}