{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\adapters\\console.logger.ts","mappings":";;;AAAA,gDAA4C;AAG5C,MAAa,aAAc,SAAQ,wBAAU;IAC3C,IAAI,CAAC,OAAe,EAAE,IAAqB;QACzC,OAAO,CAAC,GAAG,CAAC,QAAQ,EAAE,IAAI,CAAC,OAAO,EAAE,OAAO,EAAE,IAAI,IAAI,EAAE,CAAC,CAAC;IAC3D,CAAC;IAED,IAAI,CAAC,OAAe,EAAE,IAAqB;QACzC,OAAO,CAAC,IAAI,CAAC,QAAQ,EAAE,IAAI,CAAC,OAAO,EAAE,OAAO,EAAE,IAAI,IAAI,EAAE,CAAC,CAAC;IAC5D,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,KAAe,EAAE,IAAqB;QAC3D,OAAO,CAAC,KAAK,CAAC,SAAS,EAAE,IAAI,CAAC,OAAO,EAAE,OAAO,EAAE;YAC9C,KAAK;YACL,GAAG,IAAI;SACR,CAAC,CAAC;IACL,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,IAAqB;QAC1C,OAAO,CAAC,KAAK,CAAC,SAAS,EAAE,IAAI,CAAC,OAAO,EAAE,OAAO,EAAE,IAAI,IAAI,EAAE,CAAC,CAAC;IAC9D,CAAC;IAED,KAAK,CAAC,OAAe,EAAE,KAAe,EAAE,IAAqB;QAC3D,OAAO,CAAC,KAAK,CAAC,SAAS,EAAE,IAAI,CAAC,OAAO,EAAE,OAAO,EAAE;YAC9C,KAAK;YACL,GAAG,IAAI;SACR,CAAC,CAAC;IACL,CAAC;IAED,KAAK,CAAC,OAAe;QACnB,OAAO,IAAI,aAAa,CAAC;YACvB,OAAO;SACR,CAAC,CAAC;IACL,CAAC;CACF;AAhCD,sCAgCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\adapters\\console.logger.ts"],"sourcesContent":["import { BaseLogger } from \"../base-logger\";\nimport { LoggerMetadata } from \"../logger.types\";\n\nexport class ConsoleLogger extends BaseLogger {\n  info(message: string, meta?: LoggerMetadata): void {\n    console.log(\"[INFO]\", this.context, message, meta ?? \"\");\n  }\n\n  warn(message: string, meta?: LoggerMetadata): void {\n    console.warn(\"[WARN]\", this.context, message, meta ?? \"\");\n  }\n\n  error(message: string, error?: unknown, meta?: LoggerMetadata): void {\n    console.error(\"[ERROR]\", this.context, message, {\n      error,\n      ...meta,\n    });\n  }\n\n  debug(message: string, meta?: LoggerMetadata): void {\n    console.debug(\"[DEBUG]\", this.context, message, meta ?? \"\");\n  }\n\n  fatal(message: string, error?: unknown, meta?: LoggerMetadata): void {\n    console.error(\"[FATAL]\", this.context, message, {\n      error,\n      ...meta,\n    });\n  }\n\n  child(context: string): BaseLogger {\n    return new ConsoleLogger({\n      context,\n    });\n  }\n}\n"],"version":3}