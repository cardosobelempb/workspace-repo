{"file":"E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\session.factory.ts","mappings":";;;AAAA,yCAAsC;AACtC,yEAAqE;AAGrE,MAAa,cAAc;IACzB,MAAM,CAAC,KAAK,CAAC,KAAuB;QAClC,OAAO,8BAAa,CAAC,MAAM,CAAC;YAC1B,MAAM,EAAE,eAAM,CAAC,MAAM,CAAC,KAAK,CAAC,MAAM,CAAC;YACnC,YAAY,EAAE,KAAK,CAAC,YAAY;YAChC,OAAO,EAAE,IAAI,IAAI,CAAC,KAAK,CAAC,OAAO,CAAC;YAChC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;YAClC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;SACnC,CAAC,CAAC;IACL,CAAC;CACF;AAVD,wCAUC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\session.factory.ts"],"sourcesContent":["import { UUIDVO } from \"@repo/common\";\r\nimport { SessionEntity } from \"../../domain/entities/session.entity\";\r\nimport { SessionCreateDto } from \"../dto\";\r\n\r\nexport class SessionFactory {\r\n  static build(input: SessionCreateDto): SessionEntity {\r\n    return SessionEntity.create({\r\n      userId: UUIDVO.create(input.userId),\r\n      sessionToken: input.sessionToken,\r\n      expires: new Date(input.expires),\r\n      ipAddress: input.ipAddress ?? null,\r\n      userAgent: input.userAgent ?? null,\r\n    });\r\n  }\r\n}\r\n"],"version":3}