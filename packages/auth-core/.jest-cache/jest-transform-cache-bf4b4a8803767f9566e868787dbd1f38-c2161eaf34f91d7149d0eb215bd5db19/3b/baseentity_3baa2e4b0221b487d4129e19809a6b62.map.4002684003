{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\entities\\base.entity.ts","mappings":";;;AAAA,4DAAwD;AAExD;;;;;;;;GAQG;AACH,MAAsB,UAAU;IAC9B,kEAAkE;IACjD,GAAG,CAAS;IAE7B,yDAAyD;IACtC,KAAK,CAAQ;IAEhC;;;;OAIG;IACH,YAAsB,KAAY,EAAE,EAAW;QAC7C,IAAI,CAAC,KAAK,EAAE,CAAC;YACX,MAAM,IAAI,KAAK,CAAC,8CAA8C,CAAC,CAAC;QAClE,CAAC;QAED,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;QACnB,IAAI,CAAC,GAAG,GAAG,EAAE,IAAI,gBAAM,CAAC,MAAM,CAAC,EAAE,CAAC,CAAC;IACrC,CAAC;IAED,6BAA6B;IAC7B,IAAI,EAAE;QACJ,OAAO,IAAI,CAAC,GAAG,CAAC;IAClB,CAAC;IAED;;;;OAIG;IACI,MAAM,CAAC,MAA4B;QACxC,+CAA+C;QAC/C,IAAI,CAAC,MAAM,IAAI,CAAC,CAAC,MAAM,YAAY,UAAU,CAAC,EAAE,CAAC;YAC/C,OAAO,KAAK,CAAC;QACf,CAAC;QAED,qCAAqC;QACrC,IAAI,MAAM,KAAK,IAAI,EAAE,CAAC;YACpB,OAAO,IAAI,CAAC;QACd,CAAC;QAED,mCAAmC;QACnC,OAAO,MAAM,CAAC,EAAE,CAAC,MAAM,CAAC,IAAI,CAAC,GAAG,CAAC,CAAC;IACpC,CAAC;CACF;AA7CD,gCA6CC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\entities\\base.entity.ts"],"sourcesContent":["import { UUIDVO } from \"../values-objects/uuid/uuid.vo\";\n\n/**\n * Entidade base para o modelo de domínio.\n *\n * - Fornece identidade única por meio de um UUIDVO (Value Object).\n * - Garante imutabilidade do ID e controla os valores via props.\n * - Evita duplicação de lógica de igualdade entre entidades.\n *\n * @template Props Tipo das propriedades internas da entidade.\n */\nexport abstract class BaseEntity<Props> {\n  /** Identidade única da entidade representada como Value Object */\n  private readonly _id: UUIDVO;\n\n  /** Propriedades da entidade (imutáveis por convenção) */\n  protected readonly props: Props;\n\n  /**\n   * Cria uma nova instância de entidade.\n   * - Se o ID não for informado, um novo UUIDVO é gerado.\n   * - Mantém consistência e evita estados inválidos.\n   */\n  protected constructor(props: Props, id?: UUIDVO) {\n    if (!props) {\n      throw new Error(\"Props are required to instantiate an Entity.\");\n    }\n\n    this.props = props;\n    this._id = id ?? UUIDVO.create(id);\n  }\n\n  /** Obtém o ID da entidade */\n  get id(): UUIDVO {\n    return this._id;\n  }\n\n  /**\n   * Compara duas entidades por identidade.\n   *\n   * @returns true se ambas possuem o mesmo ID\n   */\n  public equals(entity?: BaseEntity<unknown>): boolean {\n    // Caso especial: null, undefined ou outro tipo\n    if (!entity || !(entity instanceof BaseEntity)) {\n      return false;\n    }\n\n    // Caso especial: a própria instância\n    if (entity === this) {\n      return true;\n    }\n\n    // Comparação por ID (regra do DDD)\n    return entity.id.equals(this._id);\n  }\n}\n"],"version":3}