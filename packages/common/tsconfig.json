{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/common/*": [
        "./src/*"
      ],
      "@/common": [
        "./src/index"
      ]
    },
    "types": [
      "node",
      "jest"
    ]
  },
  "include": [
    "src/index.ts",
    "src/application/**/*.ts",
    "src/domain/entities/**/*.ts",
    "src/domain/errors/**/*.ts",
    "src/domain/repositories/in-memory-repository/**/*.ts",
    "src/domain/repositories/search.repository.ts",
    "src/domain/repositories/types/**/*.ts",
    "src/domain/values-objects/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/infrastructure/**"
  ]
}