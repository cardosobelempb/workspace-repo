{
  "extends": "@repo/typescript-config/backend.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "paths": {
      "@repo/common": [
        "../../packages/common/src/index.ts"
      ],
      "@repo/common/*": [
        "../../packages/common/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts"
  ]
}