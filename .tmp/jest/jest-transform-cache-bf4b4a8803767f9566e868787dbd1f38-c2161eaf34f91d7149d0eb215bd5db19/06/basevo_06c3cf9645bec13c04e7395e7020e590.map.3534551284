{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\base.vo.ts","mappings":";;;AAAA;;;;;;;;;GASG;AACH,MAAsB,MAAM;IACP,KAAK,CAAI;IAE5B,YAAsB,KAAQ;QAC5B,iDAAiD;QACjD,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;QACnB,MAAM,CAAC,MAAM,CAAC,KAAK,CAAC,CAAC;IACvB,CAAC;IAED;;OAEG;IACI,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAED;;;;OAIG;IACI,MAAM,CAAC,KAAwB;QACpC,IAAI,CAAC,KAAK;YAAE,OAAO,KAAK,CAAC;QACzB,IAAI,KAAK,CAAC,WAAW,KAAK,IAAI,CAAC,WAAW;YAAE,OAAO,KAAK,CAAC;QACzD,OAAO,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,IAAI,CAAC,SAAS,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC;IACpE,CAAC;IAQD;;OAEG;IACI,QAAQ;QACb,OAAO,MAAM,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IAC5B,CAAC;CACF;AAvCD,wBAuCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\base.vo.ts"],"sourcesContent":["/**\n * 🧱 Classe base abstrata para todos os Value Objects do domínio.\n *\n * Define comportamento padrão e garante imutabilidade.\n *\n * Benefícios:\n *  - Reuso de lógica comum entre VOs\n *  - Consistência entre implementações\n *  - Aplicação de princípios SOLID (especialmente SRP e LSP)\n */\nexport abstract class BaseVO<T> {\n  protected readonly value: T;\n\n  protected constructor(value: T) {\n    // Garante imutabilidade e validação centralizada\n    this.value = value;\n    Object.freeze(value);\n  }\n\n  /**\n   * 🔒 Retorna o valor encapsulado\n   */\n  public getValue(): T {\n    return this.value;\n  }\n\n  /**\n   * 🔁 Compara dois Value Objects pelo valor interno\n   * @param other - Outro Value Object\n   * @returns true se forem equivalentes\n   */\n  public equals(other?: BaseVO<T> | null): boolean {\n    if (!other) return false;\n    if (other.constructor !== this.constructor) return false;\n    return JSON.stringify(this.value) === JSON.stringify(other.value);\n  }\n\n  /**\n   * 🧪 Método abstrato para validar o valor.\n   * Deve ser implementado por cada VO concreto.\n   */\n  public abstract isValid(): boolean;\n\n  /**\n   * 🪶 Representação string do valor (para logs, JSON, etc.)\n   */\n  public toString(): string {\n    return String(this.value);\n  }\n}\n"],"version":3}