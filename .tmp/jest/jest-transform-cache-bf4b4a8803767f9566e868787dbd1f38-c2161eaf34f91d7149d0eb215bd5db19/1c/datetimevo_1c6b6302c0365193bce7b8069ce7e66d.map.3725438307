{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\time\\date-time.vo.ts","mappings":";;;AAAA,6CAAyC;AACzC,uCAAmC;AAEnC,MAAa,UAAU;IACJ,MAAM,CAAS;IACf,MAAM,CAAS;IAEhC,YAAY,IAAY,EAAE,IAAY;QACpC,IAAI,CAAC,MAAM,GAAG,IAAI,gBAAM,CAAC,IAAI,CAAC,CAAC;QAC/B,IAAI,CAAC,MAAM,GAAG,IAAI,gBAAM,CAAC,IAAI,CAAC,CAAC;IACjC,CAAC;IAED,qCAAqC;IACrC,MAAM,CAAC,MAAM,CAAC,IAAY,EAAE,IAAY;QACtC,OAAO,IAAI,UAAU,CAAC,IAAI,EAAE,IAAI,CAAC,CAAC;IACpC,CAAC;IAED,mDAAmD;IAC5C,MAAM;QACX,MAAM,IAAI,GAAG,IAAI,CAAC,MAAM,CAAC,QAAQ,EAAE,CAAC,CAAC,aAAa;QAClD,MAAM,IAAI,GAAG,IAAI,CAAC,MAAM,CAAC,QAAQ,EAAE,CAAC,CAAC,QAAQ;QAC7C,OAAO,GAAG,IAAI,IAAI,IAAI,KAAK,CAAC;IAC9B,CAAC;IAED,+BAA+B;IACxB,OAAO;QACZ,OAAO,IAAI,IAAI,CAAC,IAAI,CAAC,MAAM,EAAE,CAAC,CAAC;IACjC,CAAC;IAED,yCAAyC;IAClC,YAAY;QACjB,OAAO,IAAI,CAAC,MAAM,CAAC,QAAQ,EAAE,CAAC;IAChC,CAAC;IAED,uCAAuC;IAChC,YAAY;QACjB,OAAO,IAAI,CAAC,MAAM,CAAC,QAAQ,EAAE,CAAC;IAChC,CAAC;IAED,mCAAmC;IAC5B,MAAM,CAAC,KAAiB;QAC7B,OAAO,IAAI,CAAC,MAAM,EAAE,KAAK,KAAK,CAAC,MAAM,EAAE,CAAC;IAC1C,CAAC;IAED,oCAAoC;IAC7B,QAAQ;QACb,OAAO,IAAI,CAAC,MAAM,EAAE,CAAC;IACvB,CAAC;CACF;AA7CD,gCA6CC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\time\\date-time.vo.ts"],"sourcesContent":["import { DateVO } from \"../date/date.vo\";\nimport { TimeVO } from \"./time.vo\";\n\nexport class DateTimeVO {\n  private readonly dateVO: DateVO;\n  private readonly timeVO: TimeVO;\n\n  constructor(date: string, time: string) {\n    this.dateVO = new DateVO(date);\n    this.timeVO = new TimeVO(time);\n  }\n\n  /** Cria uma instância via factory */\n  static create(date: string, time: string): DateTimeVO {\n    return new DateTimeVO(date, time);\n  }\n\n  /** Retorna no formato ISO (YYYY-MM-DDTHH:mm:ss) */\n  public getISO(): string {\n    const date = this.dateVO.getValue(); // YYYY-MM-DD\n    const time = this.timeVO.getValue(); // HH:mm\n    return `${date}T${time}:00`;\n  }\n\n  /** Retorna como objeto Date */\n  public getDate(): Date {\n    return new Date(this.getISO());\n  }\n\n  /** Retorna apenas a data (YYYY-MM-DD) */\n  public getDateValue(): string {\n    return this.dateVO.getValue();\n  }\n\n  /** Retorna apenas o horário (HH:mm) */\n  public getTimeValue(): string {\n    return this.timeVO.getValue();\n  }\n\n  /** Compara com outro DateTimeVO */\n  public equals(other: DateTimeVO): boolean {\n    return this.getISO() === other.getISO();\n  }\n\n  /** Representação como string ISO */\n  public toString(): string {\n    return this.getISO();\n  }\n}\n"],"version":3}