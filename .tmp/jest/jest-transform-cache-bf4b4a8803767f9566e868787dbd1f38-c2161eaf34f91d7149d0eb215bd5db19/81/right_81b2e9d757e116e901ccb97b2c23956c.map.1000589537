{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\handle-errors\\right.ts","mappings":";;;AAEA;;;;;;GAMG;AACH,MAAa,KAAK;IACP,KAAK,CAAI;IAElB,YAAY,KAAQ;QAClB,qCAAqC;QACrC,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAED;;OAEG;IACH,OAAO;QACL,OAAO,IAAI,CAAC;IACd,CAAC;IAED;;OAEG;IACH,MAAM;QACJ,OAAO,KAAK,CAAC;IACf,CAAC;IAED;;;;;OAKG;IACH,GAAG,CAAI,EAAe;QACpB,MAAM,QAAQ,GAAG,EAAE,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;QAChC,OAAO,IAAI,KAAK,CAAC,QAAQ,CAAC,CAAC;IAC7B,CAAC;IAED;;;;;;OAMG;IACH,IAAI,CAAI,CAAc,EAAE,OAAoB;QAC1C,OAAO,OAAO,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IAC7B,CAAC;IAED;;OAEG;IACH,QAAQ;QACN,OAAO,SAAS,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,KAAK,CAAC,GAAG,CAAC;IAChD,CAAC;CACF;AAlDD,sBAkDC;AAED;;;;;;;;;;;;;;;GAeG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\handle-errors\\right.ts"],"sourcesContent":["import { Left } from \"./left\";\n\n/**\n * Representa o lado de sucesso do Either.\n * Imutável e seguro. Utilizado quando uma operação é bem-sucedida.\n *\n * L -> Tipo do erro\n * R -> Tipo de sucesso\n */\nexport class Right<L, R> {\n  readonly value: R;\n\n  constructor(value: R) {\n    // Mantém imutabilidade e integridade\n    this.value = value;\n  }\n\n  /**\n   * Sempre true para Right — usado para narrowing.\n   */\n  isRight(): this is Right<L, R> {\n    return true;\n  }\n\n  /**\n   * Sempre false — mantém compatibilidade com a API funcional.\n   */\n  isLeft(): this is Left<L, R> {\n    return false;\n  }\n\n  /**\n   * Transforma o valor interno de sucesso.\n   * Mantém Left intacto (mas aqui é Right, então transforma normalmente).\n   *\n   * Segue semântica FP: map NÃO lida com erros.\n   */\n  map<T>(fn: (r: R) => T): Right<L, T> {\n    const newValue = fn(this.value);\n    return new Right(newValue);\n  }\n\n  /**\n   * fold()\n   * Desestrutura o Either chamando a função de sucesso (onRight).\n   * A função de erro é ignorada aqui.\n   *\n   * Útil para extrair o valor sem precisar checar Left/Right manualmente.\n   */\n  fold<T>(_: (l: L) => T, onRight: (r: R) => T): T {\n    return onRight(this.value);\n  }\n\n  /**\n   * Representação útil para logs e debugging.\n   */\n  toString(): string {\n    return `Right(${JSON.stringify(this.value)})`;\n  }\n}\n\n/**\nfunction divide(a: number, b: number): Left<string, number> | Right<string, number> {\n  if (b === 0) return new Left(\"Divisão por zero\")\n  return new Right(a / b)\n}\n\nconst result = divide(10, 2)\n\nresult\n  .map(n => n * 3)    // transforma (porque é Right)\n  .fold(\n    err => console.error(\"Erro:\", err),\n    value => console.log(\"Sucesso:\", value)\n  )\n\n */\n"],"version":3}