{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\file.vo.ts","mappings":";;;AAAA,MAAa,MAAM;IAyBE;IACA;IACA;IACA;IA3BX,MAAM,CAAU,kBAAkB,GAAG;QAC3C,WAAW;QACX,YAAY;QACZ,YAAY;QACZ,iBAAiB;QACjB,yEAAyE,EAAE,OAAO;QAClF,mEAAmE,EAAE,OAAO;QAC5E,iBAAiB;QACjB,WAAW;KACZ,CAAC;IAEM,MAAM,CAAU,kBAAkB,GAAG;QAC3C,MAAM;QACN,OAAO;QACP,MAAM;QACN,OAAO;QACP,MAAM;QACN,OAAO;QACP,OAAO;QACP,MAAM;QACN,MAAM;KACP,CAAC;IAEF,YACmB,YAAoB,EACpB,QAAgB,EAChB,MAAc,EACd,iBAAyB,CAAC,GAAG,IAAI,GAAG,IAAI;QAHxC,iBAAY,GAAZ,YAAY,CAAQ;QACpB,aAAQ,GAAR,QAAQ,CAAQ;QAChB,WAAM,GAAN,MAAM,CAAQ;QACd,mBAAc,GAAd,cAAc,CAA0B;QAEzD,IAAI,CAAC,QAAQ,EAAE,CAAC;IAClB,CAAC;IAEO,QAAQ;QACd,MAAM,SAAS,GAAG,IAAI,CAAC,YAAY,CAAC,IAAI,CAAC,YAAY,CAAC,CAAC,WAAW,EAAE,CAAC;QAErE,IAAI,CAAC,MAAM,CAAC,kBAAkB,CAAC,QAAQ,CAAC,SAAS,CAAC,EAAE,CAAC;YACnD,MAAM,IAAI,KAAK,CAAC,2BAA2B,SAAS,EAAE,CAAC,CAAC;QAC1D,CAAC;QAED,IAAI,CAAC,MAAM,CAAC,kBAAkB,CAAC,QAAQ,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YACvD,MAAM,IAAI,KAAK,CAAC,sBAAsB,IAAI,CAAC,QAAQ,EAAE,CAAC,CAAC;QACzD,CAAC;QAED,IAAI,CAAC,IAAI,CAAC,MAAM,IAAI,IAAI,CAAC,MAAM,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YAC7C,MAAM,IAAI,KAAK,CAAC,4BAA4B,CAAC,CAAC;QAChD,CAAC;QAED,IAAI,IAAI,CAAC,MAAM,CAAC,MAAM,GAAG,IAAI,CAAC,cAAc,EAAE,CAAC;YAC7C,MAAM,IAAI,KAAK,CACb,gCAAgC,IAAI,CAAC,cAAc,GAAG,CAAC,IAAI,GAAG,IAAI,CAAC,IAAI,CACxE,CAAC;QACJ,CAAC;QAED,IAAI,CAAC,IAAI,CAAC,kBAAkB,CAAC,SAAS,CAAC,EAAE,CAAC;YACxC,MAAM,IAAI,KAAK,CAAC,gDAAgD,CAAC,CAAC;QACpE,CAAC;IACH,CAAC;IAEO,kBAAkB,CAAC,SAAiB;QAC1C,MAAM,MAAM,GAAG,IAAI,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,+BAA+B;QAE3E,MAAM,WAAW,GAAkC;YACjD,MAAM,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,UAAU;YAClE,OAAO,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,QAAQ;YACjE,MAAM,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,QAAQ;YAChE,OAAO,EAAE,GAAG,EAAE,CACZ,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,EAAE,KAAK,MAAM;gBAC3C,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,QAAQ,EAAE,KAAK,MAAM;YAC9C,MAAM,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,EAAE,KAAK,MAAM;YACzD,MAAM,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,UAAU;YAClE,OAAO,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,UAAU;YACnE,OAAO,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,UAAU;YACnE,MAAM,EAAE,GAAG,EAAE,CAAC,MAAM,CAAC,QAAQ,CAAC,MAAM,CAAC;SACtC,CAAC;QAEF,MAAM,KAAK,GAAG,WAAW,CAAC,SAAS,CAAC,CAAC;QACrC,OAAO,KAAK,CAAC,CAAC,CAAC,KAAK,EAAE,CAAC,CAAC,CAAC,KAAK,CAAC;IACjC,CAAC;IAEO,YAAY,CAAC,QAAgB;QACnC,MAAM,OAAO,GAAG,QAAQ,CAAC,WAAW,CAAC,GAAG,CAAC,CAAC;QAC1C,OAAO,OAAO,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,CAAC,SAAS,CAAC,OAAO,CAAC,CAAC,WAAW,EAAE,CAAC;IACzE,CAAC;IAEM,OAAO;QACZ,OAAO,IAAI,CAAC,YAAY,CAAC;IAC3B,CAAC;IAEM,WAAW;QAChB,OAAO,IAAI,CAAC,QAAQ,CAAC;IACvB,CAAC;IAEM,SAAS;QACd,OAAO,IAAI,CAAC,MAAM,CAAC;IACrB,CAAC;IAEM,cAAc;QACnB,OAAO,IAAI,CAAC,MAAM,CAAC,MAAM,CAAC;IAC5B,CAAC;;AAnGH,wBAoGC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\file.vo.ts"],"sourcesContent":["export class FileVO {\n  private static readonly ALLOWED_MIME_TYPES = [\n    \"image/png\",\n    \"image/jpeg\",\n    \"image/webp\",\n    \"application/pdf\",\n    \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\", // DOCX\n    \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\", // XLSX\n    \"application/zip\",\n    \"video/mp4\",\n  ];\n\n  private static readonly ALLOWED_EXTENSIONS = [\n    \".png\",\n    \".jpeg\",\n    \".jpg\",\n    \".webp\",\n    \".pdf\",\n    \".docx\",\n    \".xlsx\",\n    \".zip\",\n    \".mp4\",\n  ];\n\n  constructor(\n    private readonly originalName: string,\n    private readonly mimeType: string,\n    private readonly buffer: Buffer,\n    private readonly maxSizeInBytes: number = 5 * 1024 * 1024, // 5MB\n  ) {\n    this.validate();\n  }\n\n  private validate(): void {\n    const extension = this.getExtension(this.originalName).toLowerCase();\n\n    if (!FileVO.ALLOWED_EXTENSIONS.includes(extension)) {\n      throw new Error(`Invalid file extension: ${extension}`);\n    }\n\n    if (!FileVO.ALLOWED_MIME_TYPES.includes(this.mimeType)) {\n      throw new Error(`Invalid MIME type: ${this.mimeType}`);\n    }\n\n    if (!this.buffer || this.buffer.length === 0) {\n      throw new Error(\"File is empty or corrupted\");\n    }\n\n    if (this.buffer.length > this.maxSizeInBytes) {\n      throw new Error(\n        `File exceeds maximum size of ${this.maxSizeInBytes / (1024 * 1024)}MB`,\n      );\n    }\n\n    if (!this.isValidMagicNumber(extension)) {\n      throw new Error(\"Invalid file signature (magic number mismatch)\");\n    }\n  }\n\n  private isValidMagicNumber(extension: string): boolean {\n    const header = this.buffer.subarray(0, 12); // ✅ Subarray evita depreciação\n\n    const magicChecks: Record<string, () => boolean> = {\n      \".png\": () => header.subarray(0, 4).toString(\"hex\") === \"89504e47\",\n      \".jpeg\": () => header.subarray(0, 3).toString(\"hex\") === \"ffd8ff\",\n      \".jpg\": () => header.subarray(0, 3).toString(\"hex\") === \"ffd8ff\",\n      \".webp\": () =>\n        header.subarray(0, 4).toString() === \"RIFF\" &&\n        header.subarray(8, 12).toString() === \"WEBP\",\n      \".pdf\": () => header.subarray(0, 4).toString() === \"%PDF\",\n      \".zip\": () => header.subarray(0, 4).toString(\"hex\") === \"504b0304\",\n      \".docx\": () => header.subarray(0, 4).toString(\"hex\") === \"504b0304\",\n      \".xlsx\": () => header.subarray(0, 4).toString(\"hex\") === \"504b0304\",\n      \".mp4\": () => header.includes(\"ftyp\"),\n    };\n\n    const check = magicChecks[extension];\n    return check ? check() : false;\n  }\n\n  private getExtension(fileName: string): string {\n    const lastDot = fileName.lastIndexOf(\".\");\n    return lastDot === -1 ? \"\" : fileName.substring(lastDot).toLowerCase();\n  }\n\n  public getName(): string {\n    return this.originalName;\n  }\n\n  public getMimeType(): string {\n    return this.mimeType;\n  }\n\n  public getBuffer(): Buffer {\n    return this.buffer;\n  }\n\n  public getSizeInBytes(): number {\n    return this.buffer.length;\n  }\n}\n"],"version":3}