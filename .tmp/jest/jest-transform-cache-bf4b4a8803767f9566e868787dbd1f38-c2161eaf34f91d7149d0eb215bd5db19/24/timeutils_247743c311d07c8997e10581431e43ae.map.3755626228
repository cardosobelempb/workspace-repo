{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\time-utils.ts","mappings":";;;AAAA,MAAa,SAAS;IACpB,gBAAuB,CAAC;IAExB;;OAEG;IACH,MAAM,CAAC,WAAW,CAAC,OAAe;QAChC,OAAO,2BAA2B,CAAC,IAAI,CAAC,OAAO,CAAC,CAAC;IACnD,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,UAAU,CAAC,IAAU;QAC1B,MAAM,KAAK,GAAG,MAAM,CAAC,IAAI,CAAC,QAAQ,EAAE,CAAC,CAAC,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC,CAAC;QACvD,MAAM,OAAO,GAAG,MAAM,CAAC,IAAI,CAAC,UAAU,EAAE,CAAC,CAAC,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC,CAAC;QAC3D,OAAO,GAAG,KAAK,IAAI,OAAO,EAAE,CAAC;IAC/B,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,SAAS,CAAC,OAAe;QAC9B,uBAAuB;QACvB,IAAI,CAAC,IAAI,CAAC,WAAW,CAAC,OAAO,CAAC;YAAE,OAAO,IAAI,CAAC;QAE5C,MAAM,CAAC,KAAK,EAAE,OAAO,CAAC,GAAG,OAAO,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC;QAExD,mDAAmD;QACnD,IAAI,KAAK,KAAK,SAAS,IAAI,OAAO,KAAK,SAAS;YAAE,OAAO,IAAI,CAAC;QAE9D,MAAM,GAAG,GAAG,IAAI,IAAI,EAAE,CAAC;QACvB,GAAG,CAAC,QAAQ,CAAC,KAAK,EAAE,OAAO,EAAE,CAAC,EAAE,CAAC,CAAC,CAAC;QACnC,OAAO,GAAG,CAAC;IACb,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,UAAU,CAAC,IAAU,EAAE,OAAe;QAC3C,MAAM,MAAM,GAAG,IAAI,IAAI,CAAC,IAAI,CAAC,CAAC;QAC9B,MAAM,CAAC,UAAU,CAAC,MAAM,CAAC,UAAU,EAAE,GAAG,OAAO,CAAC,CAAC;QACjD,OAAO,MAAM,CAAC;IAChB,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,eAAe,CAAC,IAAU,EAAE,OAAe;QAChD,OAAO,IAAI,CAAC,UAAU,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,CAAC;IACzC,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,UAAU,CAAC,KAAa,EAAE,KAAa;QAC5C,OAAO,KAAK,KAAK,KAAK,CAAC;IACzB,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,aAAa,CAAC,KAAW,EAAE,KAAW;QAC3C,MAAM,MAAM,GAAG,IAAI,CAAC,GAAG,CAAC,KAAK,CAAC,OAAO,EAAE,GAAG,KAAK,CAAC,OAAO,EAAE,CAAC,CAAC;QAC3D,OAAO,IAAI,CAAC,KAAK,CAAC,MAAM,GAAG,KAAK,CAAC,CAAC;IACpC,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,oBAAoB,CACzB,IAAU,EACV,QAAgB,EAChB,SAAiB,OAAO;QAExB,OAAO,IAAI,CAAC,kBAAkB,CAAC,MAAM,EAAE;YACrC,QAAQ;YACR,IAAI,EAAE,SAAS;YACf,MAAM,EAAE,SAAS;SAClB,CAAC,CAAC;IACL,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,aAAa,CAAC,IAAU,EAAE,KAAW,EAAE,GAAS;QACrD,MAAM,SAAS,GAAG,CAAC,CAAO,EAAE,EAAE,CAAC,CAAC,CAAC,QAAQ,EAAE,GAAG,EAAE,GAAG,CAAC,CAAC,UAAU,EAAE,CAAC;QAClE,MAAM,CAAC,GAAG,SAAS,CAAC,IAAI,CAAC,CAAC;QAC1B,MAAM,CAAC,GAAG,SAAS,CAAC,KAAK,CAAC,CAAC;QAC3B,MAAM,CAAC,GAAG,SAAS,CAAC,GAAG,CAAC,CAAC;QACzB,OAAO,CAAC,IAAI,CAAC,IAAI,CAAC,IAAI,CAAC,CAAC;IAC1B,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,wBAAwB,CAAC,OAAe;QAC7C,MAAM,CAAC,GAAG,IAAI,CAAC,KAAK,CAAC,OAAO,GAAG,EAAE,CAAC,CAAC;QACnC,MAAM,CAAC,GAAG,OAAO,GAAG,EAAE,CAAC;QACvB,OAAO,CAAC,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,MAAM,CAAC,OAAO,CAAC,CAAC,IAAI,CAAC,GAAG,CAAC,IAAI,IAAI,CAAC;IACxF,CAAC;CACF;AArGD,8BAqGC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\time-utils.ts"],"sourcesContent":["export class TimeUtils {\n  private constructor() {}\n\n  /**\n   * Valida se uma string está no formato HH:mm (24h)\n   */\n  static isValidTime(timeStr: string): boolean {\n    return /^([01]\\d|2[0-3]):[0-5]\\d$/.test(timeStr);\n  }\n\n  /**\n   * Formata uma Date para string \"HH:mm\"\n   */\n  static formatTime(date: Date): string {\n    const hours = String(date.getHours()).padStart(2, \"0\");\n    const minutes = String(date.getMinutes()).padStart(2, \"0\");\n    return `${hours}:${minutes}`;\n  }\n\n  /**\n   * Converte string \"HH:mm\" em Date com a data de hoje\n   */\n  static parseTime(timeStr: string): Date | null {\n    // Valida formato HH:mm\n    if (!this.isValidTime(timeStr)) return null;\n\n    const [hours, minutes] = timeStr.split(\":\").map(Number);\n\n    // Garantia extra, mesmo que isValidTime já proteja\n    if (hours === undefined || minutes === undefined) return null;\n\n    const now = new Date();\n    now.setHours(hours, minutes, 0, 0);\n    return now;\n  }\n\n  /**\n   * Adiciona minutos a uma data\n   */\n  static addMinutes(date: Date, minutes: number): Date {\n    const result = new Date(date);\n    result.setMinutes(result.getMinutes() + minutes);\n    return result;\n  }\n\n  /**\n   * Subtrai minutos de uma data\n   */\n  static subtractMinutes(date: Date, minutes: number): Date {\n    return this.addMinutes(date, -minutes);\n  }\n\n  /**\n   * Compara se duas strings de tempo são iguais (HH:mm)\n   */\n  static isSameTime(time1: string, time2: string): boolean {\n    return time1 === time2;\n  }\n\n  /**\n   * Calcula diferença entre duas datas em minutos\n   */\n  static diffInMinutes(date1: Date, date2: Date): number {\n    const diffMs = Math.abs(date1.getTime() - date2.getTime());\n    return Math.floor(diffMs / 60000);\n  }\n\n  /**\n   * Formata hora em determinado fuso horário\n   */\n  static formatTimeInTimeZone(\n    date: Date,\n    timeZone: string,\n    locale: string = \"pt-BR\",\n  ): string {\n    return date.toLocaleTimeString(locale, {\n      timeZone,\n      hour: \"2-digit\",\n      minute: \"2-digit\",\n    });\n  }\n\n  /**\n   * Verifica se um horário está entre dois horários\n   */\n  static isTimeBetween(time: Date, start: Date, end: Date): boolean {\n    const toMinutes = (d: Date) => d.getHours() * 60 + d.getMinutes();\n    const t = toMinutes(time);\n    const s = toMinutes(start);\n    const e = toMinutes(end);\n    return t >= s && t <= e;\n  }\n\n  /**\n   * Converte minutos para formato \"Xh Ym\"\n   */\n  static convertMinutesToReadable(minutes: number): string {\n    const h = Math.floor(minutes / 60);\n    const m = minutes % 60;\n    return [h > 0 ? `${h}h` : \"\", m > 0 ? `${m}m` : \"\"].filter(Boolean).join(\" \") || \"0m\";\n  }\n}\n"],"version":3}