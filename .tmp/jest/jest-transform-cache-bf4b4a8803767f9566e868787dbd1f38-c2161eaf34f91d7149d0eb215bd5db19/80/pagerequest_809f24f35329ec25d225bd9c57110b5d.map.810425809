{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\page-request.ts","mappings":";AAAA,kBAAkB","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\page-request.ts"],"sourcesContent":["// page-request.ts\n\nimport { SearchFilter } from \"./types/filter.types\";\n\nexport interface PageInput {\n  /**\n   * Spring usa ZERO-BASED\n   *\n   * page=0 → primeira página\n   */\n  page?: number;\n\n  /**\n   * Spring usa size\n   */\n  size?: number;\n\n  /**\n   * Formato Spring:\n   *\n   * sort=name,asc\n   * sort=createdAt,desc\n   */\n  sort?: string;\n\n  /**\n   * Filtro textual simples\n   */\n  filter?: string;\n\n  /**\n   * Filtros avançados\n   */\n  filters?: SearchFilter[];\n}\n"],"version":3}