{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\base-soft-delete.repository.ts","mappings":";;;AACA,uDAAmD;AAEnD;;GAEG;AACH,MAAsB,wBAEpB,SAAQ,gCAAuB;IAC/B;;OAEG;IACH,KAAK,CAAC,UAAU,CAAC,MAAe;QAC9B,MAAM,CAAC,SAAS,GAAG,IAAI,IAAI,EAAE,CAAC;QAC9B,MAAM,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;IAC1B,CAAC;IAED;;OAEG;IACH,KAAK,CAAC,OAAO,CAAC,MAAe;QAC3B,MAAM,CAAC,SAAS,GAAG,IAAI,CAAC;QACxB,MAAM,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,CAAC;IAC1B,CAAC;CACF;AAlBD,4DAkBC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\base-soft-delete.repository.ts"],"sourcesContent":["import { BaseSoftDeletableRepository } from \"./base-soft-deletable.repository\";\nimport { BaseRepository } from \"./base.repository\";\n\n/**\n * Repositório com suporte a soft delete.\n */\nexport abstract class BaseSoftDeleteRepository<\n  TEntity extends BaseSoftDeletableRepository,\n> extends BaseRepository<TEntity> {\n  /**\n   * Realiza exclusão lógica da entidade.\n   */\n  async softDelete(entity: TEntity): Promise<void> {\n    entity.deletedAt = new Date();\n    await this.save(entity);\n  }\n\n  /**\n   * Restaura uma entidade excluída logicamente.\n   */\n  async restore(entity: TEntity): Promise<void> {\n    entity.deletedAt = null;\n    await this.save(entity);\n  }\n}\n"],"version":3}