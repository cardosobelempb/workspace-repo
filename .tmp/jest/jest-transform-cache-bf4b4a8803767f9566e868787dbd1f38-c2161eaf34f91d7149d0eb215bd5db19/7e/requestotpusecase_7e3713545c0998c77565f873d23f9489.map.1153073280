{"version":3,"names":["cov_27tsmykuk","actualCoverage","s","constants_1","require","common_1","factories_1","RequestOtpUseCase","otpRepository","nodemailerEmailAdapter","tokenGenerator","hashGenerator","expiresInMinutes","constructor","b","f","execute","input","invalidateAllByEmailAndPurpose","email","purpose","code","generate","length","charset","codeHash","hash","AUTH_TOKEN_CONSTANTS","SESSION_TOKEN_SALT_ROUNDS","expiresAt","Date","now","otpFactory","OtpCodeFactory","build","attempts","maxAttempts","expiredAt","toISOString","ipAddress","userAgent","usedAt","create","send","to","subject","html","content","channel","NotificationChannel","EMAIL","metadata","right","undefined","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\use-cases\\request-otp.use-case.ts"],"sourcesContent":["import { AUTH_TOKEN_CONSTANTS } from \"@/common/constants\";\nimport { OtpCodeRepository } from \"@/common/domain\";\nimport {\n  Either,\n  HashGenerator,\n  NotificationChannel,\n  right,\n  TokenGenerator,\n} from \"@repo/common\";\nimport { NodemailerEmailAdapter } from \"@repo/notification-email\";\n\nimport { OtpCodeFactory } from \"../factories\";\n\nexport type RequestOtpInput = {\n  email: string;\n  purpose: string;\n  ipAddress?: string | null;\n  userAgent?: string | null;\n};\n\nexport type RequestOtpOutput = void;\nexport type RequestOtpError = never;\n\nexport class RequestOtpUseCase {\n  constructor(\n    private readonly otpRepository: OtpCodeRepository,\n    private readonly nodemailerEmailAdapter: NodemailerEmailAdapter,\n    private readonly tokenGenerator: TokenGenerator<{ length: number; charset: string }>,\n    private readonly hashGenerator: HashGenerator,\n    private readonly expiresInMinutes: number = 10,\n  ) {}\n\n  async execute(\n    input: RequestOtpInput,\n  ): Promise<Either<RequestOtpError, RequestOtpOutput>> {\n    await this.otpRepository.invalidateAllByEmailAndPurpose(input.email, input.purpose);\n\n    const code = await this.tokenGenerator.generate({ length: 6, charset: \"numeric\" });\n    const codeHash = await this.hashGenerator.hash(\n      code,\n      AUTH_TOKEN_CONSTANTS.SESSION_TOKEN_SALT_ROUNDS,\n    );\n    const expiresAt = new Date(Date.now() + this.expiresInMinutes * 60 * 1000);\n\n    const otpFactory = OtpCodeFactory.build({\n      email: input.email,\n      codeHash,\n      purpose: input.purpose,\n      attempts: 0,\n      maxAttempts: 5,\n      expiredAt: expiresAt.toISOString(),\n      ipAddress: input.ipAddress ?? null,\n      userAgent: input.userAgent ?? null,\n      usedAt: null,\n    });\n\n    await this.otpRepository.create(otpFactory);\n\n    await this.nodemailerEmailAdapter.send({\n      to: input.email,\n      subject: \"Seu código de acesso\",\n      html: `<p>Seu código é: <strong>${code}</strong></p><p>Expira em ${this.expiresInMinutes} minutos.</p>`,\n      content: `Seu código é: ${code}. Expira em ${this.expiresInMinutes} minutos.`,\n      channel: NotificationChannel.EMAIL,\n      metadata: { email: input.email, purpose: input.purpose },\n    });\n\n    return right(undefined);\n  }\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IA2BqB;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AA3BrB,MAAAC,WAAA;AAAA;AAAA,CAAAH,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAEA,MAAAC,QAAA;AAAA;AAAA,CAAAL,aAAA,GAAAE,CAAA,OAAAE,OAAA;AASA,MAAAE,WAAA;AAAA;AAAA,CAAAN,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAYA,MAAaG,iBAAiB;EAETC,aAAA;EACAC,sBAAA;EACAC,cAAA;EACAC,aAAA;EACAC,gBAAA;EALnBC,YACmBL,aAAgC,EAChCC,sBAA8C,EAC9CC,cAAmE,EACnEC,aAA4B,EAC5BC,gBAAA;EAAA;EAAA,CAAAZ,aAAA,