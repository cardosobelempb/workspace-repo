{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\location\\latitude.vo.ts","mappings":";;;AACA,kFAA6E;AAC7E,wCAAoC;AAEpC,MAAa,UAAW,SAAQ,gBAAc;IACzB,KAAK,CAAS;IAEjC,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;QACb,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAED;;;;OAIG;IACI,MAAM,CAAC,MAAM,CAAC,KAAa,EAAE,IAAe;QACjD,IAAI,CAAC,IAAI,CAAC,OAAO,CAAC,KAAK,CAAC,EAAE,CAAC;YACzB,MAAM,OAAO,GACX,IAAI,EAAE,CAAC,CAAC,yBAAyB,EAAE,EAAE,IAAI,EAAE,EAAE,KAAK,EAAE,EAAE,CAAC;gBACvD,qBAAqB,KAAK,+BAA+B,CAAC;YAC5D,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,UAAU;gBACrB,OAAO;aACR,CAAC,CAAC;QACL,CAAC;QACD,OAAO,IAAI,UAAU,CAAC,KAAK,CAAC,CAAC;IAC/B,CAAC;IAEM,OAAO;QACZ,OAAO,UAAU,CAAC,OAAO,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACxC,CAAC;IAED,iDAAiD;IAC1C,MAAM,CAAC,OAAO,CAAC,KAAa;QACjC,OAAO,OAAO,KAAK,KAAK,QAAQ,IAAI,KAAK,IAAI,CAAC,EAAE,IAAI,KAAK,IAAI,EAAE,CAAC;IAClE,CAAC;IAED,mCAAmC;IAC5B,MAAM,CAAC,KAAiB;QAC7B,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,KAAK,CAAC;IACpC,CAAC;IAED,0BAA0B;IACnB,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC,QAAQ,EAAE,CAAC;IAC/B,CAAC;CACF;AA5CD,gCA4CC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\location\\latitude.vo.ts"],"sourcesContent":["import { BaseI18n } from \"../../../shared/utils/base-I18n\";\r\nimport { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\nexport class LatitudeVO extends BaseVO<number> {\r\n  protected readonly value: number;\r\n\r\n  private constructor(value: number) {\r\n    super(value);\r\n    this.value = value;\r\n  }\r\n\r\n  /**\r\n   * Cria um LatitudeVO com validação.\r\n   * @param value Número da latitude\r\n   * @param i18n Instância de tradução (opcional)\r\n   */\r\n  public static create(value: number, i18n?: BaseI18n): LatitudeVO {\r\n    if (!this.isValid(value)) {\r\n      const message =\r\n        i18n?.t(\"errors.latitude.invalid\", { args: { value } }) ??\r\n        `Invalid latitude: ${value}. Must be between -90 and 90.`;\r\n      throw new BadRequestError({\r\n        fieldName: \"latitude\",\r\n        message,\r\n      });\r\n    }\r\n    return new LatitudeVO(value);\r\n  }\r\n\r\n  public isValid(): boolean {\r\n    return LatitudeVO.isValid(this.value);\r\n  }\r\n\r\n  /** Verifica se um valor é uma latitude válida */\r\n  public static isValid(value: number): boolean {\r\n    return typeof value === \"number\" && value >= -90 && value <= 90;\r\n  }\r\n\r\n  /** Compara com outro LatitudeVO */\r\n  public equals(other: LatitudeVO): boolean {\r\n    return this.value === other.value;\r\n  }\r\n\r\n  /** Retorna como string */\r\n  public toString(): string {\r\n    return this.value.toString();\r\n  }\r\n}\r\n"],"version":3}