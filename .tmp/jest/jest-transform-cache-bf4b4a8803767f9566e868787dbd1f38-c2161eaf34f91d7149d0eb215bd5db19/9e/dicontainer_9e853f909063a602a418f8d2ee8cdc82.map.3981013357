{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\container\\di-container.ts","mappings":";AAAA,mCAAmC;;;AAYnC,MAAa,WAAW;IACL,SAAS,GAAG,IAAI,GAAG,EAA2B,CAAC;IAC/C,SAAS,GAAG,IAAI,GAAG,EAAsC,CAAC;IAE3E,QAAQ,CAAC,SAA+B;QACtC,KAAK,MAAM,QAAQ,IAAI,SAAS,EAAE,CAAC;YACjC,IAAI,CAAC,SAAS,CAAC,GAAG,CAAC,QAAQ,CAAC,KAAK,EAAE,QAAQ,CAAC,CAAC;QAC/C,CAAC;IACH,CAAC;IAED,OAAO,CAAI,KAAwB;QACjC,MAAM,gBAAgB,GAAG,IAAI,CAAC,SAAS,CAAC,GAAG,CAAC,KAAK,CAAC,CAAC;QAEnD,IAAI,gBAAgB,EAAE,CAAC;YACrB,OAAO,gBAAqB,CAAC;QAC/B,CAAC;QAED,MAAM,QAAQ,GAAG,IAAI,CAAC,SAAS,CAAC,GAAG,CAAC,KAAK,CAAC,CAAC;QAE3C,IAAI,QAAQ,IAAI,UAAU,IAAI,QAAQ,EAAE,CAAC;YACvC,IAAI,CAAC,SAAS,CAAC,GAAG,CAAC,KAAK,EAAE,QAAQ,CAAC,QAAQ,CAAC,CAAC;YAE7C,OAAO,QAAQ,CAAC,QAAa,CAAC;QAChC,CAAC;QAED,MAAM,WAAW,GAAG,CAClB,QAAQ,IAAI,UAAU,IAAI,QAAQ,CAAC,CAAC,CAAC,QAAQ,CAAC,QAAQ,CAAC,CAAC,CAAC,KAAK,CAC5C,CAAC;QAErB,IAAI,OAAO,WAAW,KAAK,UAAU,EAAE,CAAC;YACtC,MAAM,IAAI,KAAK,CAAC,uCAAuC,MAAM,CAAC,KAAK,CAAC,EAAE,CAAC,CAAC;QAC1E,CAAC;QAED,MAAM,YAAY,GAChB,WAAW,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC,UAAU,EAAE,EAAE,CAAC,IAAI,CAAC,OAAO,CAAC,UAAU,CAAC,CAAC,IAAI,EAAE,CAAC;QAE1E,MAAM,QAAQ,GAAG,IAAI,WAAW,CAAC,GAAG,YAAY,CAAC,CAAC;QAElD,IAAI,CAAC,SAAS,CAAC,GAAG,CAAC,KAAK,EAAE,QAAQ,CAAC,CAAC;QAEpC,OAAO,QAAa,CAAC;IACvB,CAAC;CACF;AA1CD,kCA0CC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\container\\di-container.ts"],"sourcesContent":["// shared/container/di-container.ts\n\nimport type {\n  ClassConstructor,\n  InjectionToken,\n  ProviderDefinition,\n} from \"../module/module.types\";\n\ntype InjectableClass<T extends object = object> = ClassConstructor<T> & {\n  inject?: InjectionToken[];\n};\n\nexport class DIContainer {\n  private readonly instances = new Map<InjectionToken, unknown>();\n  private readonly providers = new Map<InjectionToken, ProviderDefinition>();\n\n  register(providers: ProviderDefinition[]): void {\n    for (const provider of providers) {\n      this.providers.set(provider.token, provider);\n    }\n  }\n\n  resolve<T>(token: InjectionToken<T>): T {\n    const existingInstance = this.instances.get(token);\n\n    if (existingInstance) {\n      return existingInstance as T;\n    }\n\n    const provider = this.providers.get(token);\n\n    if (provider && \"useValue\" in provider) {\n      this.instances.set(token, provider.useValue);\n\n      return provider.useValue as T;\n    }\n\n    const targetClass = (\n      provider && \"useClass\" in provider ? provider.useClass : token\n    ) as InjectableClass;\n\n    if (typeof targetClass !== \"function\") {\n      throw new Error(`Provider nao encontrado para token: ${String(token)}`);\n    }\n\n    const dependencies =\n      targetClass.inject?.map((dependency) => this.resolve(dependency)) ?? [];\n\n    const instance = new targetClass(...dependencies);\n\n    this.instances.set(token, instance);\n\n    return instance as T;\n  }\n}\n"],"version":3}