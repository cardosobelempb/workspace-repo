AK,CAAC;YAC1C,MAAM,EAAE,IAAI,CAAC,EAAE,CAAC,QAAQ,EAAE;YAC1B,YAAY,EAAE,SAAS;YACvB,OAAO,EAAE,SAAS,CAAC,WAAW,EAAE;YAChC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;YAClC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;SACnC,CAAC,CAAC;QAEH,MAAM,OAAO,GAAG,MAAM,IAAI,CAAC,iBAAiB,CAAC,MAAM,CAAC,cAAc,CAAC,CAAC;QAEpE,OAAO,IAAA,cAAK,EAAC;YACX,YAAY,EAAE,OAAO,CAAC,YAAY;YAClC,SAAS;YACT,IAAI;SACL,CAAC,CAAC;IACL,CAAC;CACF;AApED,gDAoEC",
      names: [],
