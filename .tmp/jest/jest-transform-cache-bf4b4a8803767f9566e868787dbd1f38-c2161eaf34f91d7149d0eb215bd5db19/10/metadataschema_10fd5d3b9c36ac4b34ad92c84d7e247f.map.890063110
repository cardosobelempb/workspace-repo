{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\metadata.schema.ts","mappings":";;;;;;AAAA,8CAAoB;AACpB,2DAA2D;AAC9C,QAAA,cAAc,GAAG,aAAC,CAAC,MAAM,CACpC,aAAC,CAAC,MAAM,EAAE,EACV,aAAC,CAAC,KAAK,CAAC,CAAC,aAAC,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,OAAO,EAAE,EAAE,aAAC,CAAC,IAAI,EAAE,CAAC,CAAC,CACzD,CAAC;AAEW,QAAA,oBAAoB,GAAG,aAAC,CAAC,MAAM,CAAC,aAAC,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,CAAC;AACxD,QAAA,oBAAoB,GAAG,aAAC,CAAC,MAAM,CAAC,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,CAAC;AACnF,8BAA8B;AACjB,QAAA,qBAAqB,GAAG,aAAC,CAAC,MAAM,CAAC,aAAC,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,OAAO,EAAE,CAAC,CAAC;AAEvE,6BAA6B;AAChB,QAAA,YAAY,GAAG,aAAC,CAAC,MAAM,CAAC,aAAC,CAAC,MAAM,EAAE,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\metadata.schema.ts"],"sourcesContent":["import z from \"zod\";\n/** Metadata genérica: chaves string, valores primitivos */\nexport const MetadataSchema = z.record(\n  z.string(),\n  z.union([z.string(), z.number(), z.boolean(), z.null()]),\n);\n\nexport const MetadataStringSchema = z.record(z.string(), z.string());\nexport const MetadataNumberSchema = z.record(z.coerce.number(), z.coerce.number());\n/** Record<string, unknown> */\nexport const MetadataUnknownSchema = z.record(z.string(), z.unknown());\n\n/** Record<string, string> */\nexport const stringRecord = z.record(z.string(), z.string());\n"],"version":3}