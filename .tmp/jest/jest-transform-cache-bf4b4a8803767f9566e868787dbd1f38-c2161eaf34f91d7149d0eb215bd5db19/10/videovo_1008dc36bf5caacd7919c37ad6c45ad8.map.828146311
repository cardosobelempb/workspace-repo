{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\video.vo.ts","mappings":";;;AAAA,iDAA4C;AAE5C,MAAa,OAAQ,SAAQ,yBAAU;IACrC,YACE,YAAoB,EACpB,QAAgB,EAChB,MAAc,EACd,cAAuB;QAEvB,KAAK,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,EAAE,cAAc,CAAC,CAAC;IACxD,CAAC;IAEM,OAAO;QACZ,OAAO,CACL,IAAI,CAAC,QAAQ,KAAK,WAAW,IAAI,IAAI,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,EAAE,KAAK,MAAM,CAClF,CAAC;IACJ,CAAC;IACD,KAAK,CAAC,QAAQ;QACZ,IAAI,IAAI,CAAC,QAAQ,KAAK,WAAW,EAAE,CAAC;YAClC,MAAM,IAAI,KAAK,CAAC,yBAAyB,CAAC,CAAC;QAC7C,CAAC;QAED,MAAM,MAAM,GAAG,IAAI,CAAC,MAAM,CAAC,QAAQ,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,QAAQ,EAAE,CAAC,CAAC,+BAA+B;QACrF,IAAI,MAAM,KAAK,MAAM,EAAE,CAAC;YACtB,MAAM,IAAI,KAAK,CAAC,4BAA4B,CAAC,CAAC;QAChD,CAAC;IACH,CAAC;CACF;AAzBD,0BAyBC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\video.vo.ts"],"sourcesContent":["import { BaseFileVO } from \"./base-file.vo\";\n\nexport class VideoVO extends BaseFileVO {\n  constructor(\n    originalName: string,\n    mimeType: string,\n    buffer: Buffer,\n    maxSizeInBytes?: number,\n  ) {\n    super(originalName, mimeType, buffer, maxSizeInBytes);\n  }\n\n  public isValid(): boolean {\n    return (\n      this.mimeType === \"video/mp4\" && this.buffer.subarray(4, 8).toString() === \"ftyp\"\n    );\n  }\n  async validate() {\n    if (this.mimeType !== \"video/mp4\") {\n      throw new Error(\"Invalid video MIME type\");\n    }\n\n    const header = this.buffer.subarray(4, 8).toString(); // normalmente \"ftyp\" fica aqui\n    if (header !== \"ftyp\") {\n      throw new Error(\"Invalid MP4 file signature\");\n    }\n  }\n}\n"],"version":3}