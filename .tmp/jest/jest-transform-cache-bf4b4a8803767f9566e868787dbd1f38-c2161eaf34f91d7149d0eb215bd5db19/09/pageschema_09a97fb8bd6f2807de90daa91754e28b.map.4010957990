{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\page.schema.ts","mappings":";AAAA,+DAA+D;AAC/D,uBAAuB;AACvB,8DAA8D;AAC9D,+DAA+D;;;AAE/D,6BAAwB;AACxB,iEAA4D;AAC5D,yDAAoD;AAEpD;;;;;;;;;;;;;GAaG;AACI,MAAM,UAAU,GAAG,CAAyB,aAAgB,EAAE,EAAE,CACrE,OAAC,CAAC,MAAM,CAAC;IACP,OAAO,EAAE,OAAC,CAAC,KAAK,CAAC,aAAa,CAAC;IAC/B,QAAQ,EAAE,yCAAkB;IAC5B,IAAI,EAAE,iCAAc;IACpB,UAAU,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAC1C,aAAa,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAC7C,gBAAgB,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IAChD,IAAI,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,QAAQ,EAAE;IACjC,MAAM,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,WAAW,EAAE;IACtC,KAAK,EAAE,OAAC,CAAC,OAAO,EAAE;IAClB,IAAI,EAAE,OAAC,CAAC,OAAO,EAAE;IACjB,KAAK,EAAE,OAAC,CAAC,OAAO,EAAE;CACnB,CAAC,CAAC;AAbQ,QAAA,UAAU,cAalB","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\page.schema.ts"],"sourcesContent":["// ============================================================\n// pagination.schema.ts\n// Schemas genéricos de paginação — padrão Spring Data Page<T>\n// ============================================================\n\nimport { z } from \"zod\";\nimport { PagePageableSchema } from \"./page-pageable.schema\";\nimport { PageSortSchema } from \"./page-sort.schema\";\n\n/**\n * Factory de Page<T> — recebe o schema do item e retorna\n * o schema completo no contrato Spring Data Page.\n *\n * @param contentSchema - Schema Zod do item individual\n *\n * @example\n * // Gera Page<Organization>\n * const OrgPageSchema = PageSchema(OrganizationSchema);\n * type OrgPage = z.infer<typeof OrgPageSchema>;\n *\n * // Gera Page<User>\n * const UserPageSchema = PageSchema(UserSchema);\n */\nexport const PageSchema = <T extends z.ZodTypeAny>(contentSchema: T) =>\n  z.object({\n    content: z.array(contentSchema),\n    pageable: PagePageableSchema,\n    sort: PageSortSchema,\n    totalPages: z.number().int().nonnegative(),\n    totalElements: z.number().int().nonnegative(),\n    numberOfElements: z.number().int().nonnegative(),\n    size: z.number().int().positive(),\n    number: z.number().int().nonnegative(),\n    first: z.boolean(),\n    last: z.boolean(),\n    empty: z.boolean(),\n  });\n\n// ─── Tipos inferidos ──────────────────────────────────────────────────────────\nexport type SortMeta = z.infer<typeof PagePageableSchema>;\nexport type PageableMeta = z.infer<typeof PagePageableSchema>;\n\n// ✅ Corrigido: \"_type\" em vez de \"type\"\nexport type PageResponse<T> = z.infer<ReturnType<typeof PageSchema<z.ZodType<T>>>>;\n"],"version":3}