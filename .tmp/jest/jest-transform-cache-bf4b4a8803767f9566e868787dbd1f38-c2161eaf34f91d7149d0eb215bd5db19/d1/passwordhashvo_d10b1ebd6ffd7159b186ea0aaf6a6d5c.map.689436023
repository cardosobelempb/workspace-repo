{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\password-hash\\password-hash.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC;;;GAGG;AACH,MAAM,YAAY,GAAG,sCAAsC,CAAC;AAE5D;;;;;GAKG;AACH,MAAa,cAAe,SAAQ,gBAAc;IAChD,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAED,6DAA6D;IAE7D;;;OAGG;IACI,MAAM,CAAC,MAAM,CAAC,IAAY;QAC/B,IAAI,CAAC,IAAI,IAAI,IAAI,CAAC,IAAI,EAAE,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACtC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,cAAc;gBACzB,OAAO,EAAE,gCAAgC;aAC1C,CAAC,CAAC;QACL,CAAC;QAED,MAAM,QAAQ,GAAG,IAAI,cAAc,CAAC,IAAI,CAAC,IAAI,EAAE,CAAC,CAAC;QAEjD,IAAI,CAAC,QAAQ,CAAC,OAAO,EAAE,EAAE,CAAC;YACxB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,cAAc;gBACzB,OAAO,EAAE,6BAA6B;aACvC,CAAC,CAAC;QACL,CAAC;QAED,OAAO,QAAQ,CAAC;IAClB,CAAC;IAED,6DAA6D;IAEtD,OAAO;QACZ,OAAO,YAAY,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACvC,CAAC;IAED,6DAA6D;IAE7D;;;OAGG;IACH,IAAW,MAAM;QACf,OAAO,QAAQ,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC;IAChD,CAAC;IAED,iDAAiD;IAC1C,QAAQ;QACb,OAAO,KAAK,CAAC;IACf,CAAC;CACF;AAnDD,wCAmDC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\password-hash\\password-hash.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\n/**\r\n * Formato bcrypt: $2a$, $2b$ ou $2y$ + 2 dígitos de custo + 53 chars\r\n * Exemplo: $2b$12$...\r\n */\r\nconst BCRYPT_REGEX = /^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$/;\r\n\r\n/**\r\n * 🔑 PasswordHashVO\r\n *\r\n * Representa um hash bcrypt já gerado e persistido.\r\n * Valida o formato sem jamais expor o conteúdo.\r\n */\r\nexport class PasswordHashVO extends BaseVO<string> {\r\n  private constructor(value: string) {\r\n    super(value);\r\n  }\r\n\r\n  // ─── Factory ──────────────────────────────────────────────\r\n\r\n  /**\r\n   * ✅ Cria a partir de um hash bcrypt existente.\r\n   * Use ao remontar uma entidade do banco de dados.\r\n   */\r\n  public static create(hash: string): PasswordHashVO {\r\n    if (!hash || hash.trim().length === 0) {\r\n      throw new BadRequestError({\r\n        fieldName: \"passwordHash\",\r\n        message: \"Password hash cannot be empty.\",\r\n      });\r\n    }\r\n\r\n    const instance = new PasswordHashVO(hash.trim());\r\n\r\n    if (!instance.isValid()) {\r\n      throw new BadRequestError({\r\n        fieldName: \"passwordHash\",\r\n        message: \"Invalid bcrypt hash format.\",\r\n      });\r\n    }\r\n\r\n    return instance;\r\n  }\r\n\r\n  // ─── Validação ────────────────────────────────────────────\r\n\r\n  public isValid(): boolean {\r\n    return BCRYPT_REGEX.test(this.value);\r\n  }\r\n\r\n  // ─── Accessors ────────────────────────────────────────────\r\n\r\n  /**\r\n   * Custo (salt rounds) extraído do hash bcrypt.\r\n   * Ex.: $2b$12$... → 12\r\n   */\r\n  public get rounds(): number {\r\n    return parseInt(this.value.split(\"$\")[2], 10);\r\n  }\r\n\r\n  /** Nunca exibe o hash em logs ou serialização */\r\n  public toString(): string {\r\n    return \"***\";\r\n  }\r\n}\r\n"],"version":3}