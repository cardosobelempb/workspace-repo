{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\date-range\\date-range.vo.ts","mappings":";AAAA,+DAA+D;AAC/D,mDAAmD;AACnD,kCAAkC;AAClC,+DAA+D;;;AAE/D,qFAAgF;AAChF,2CAAuC;AAOvC;;GAEG;AACH,MAAa,WAAY,SAAQ,gBAAsB;IACrD,YAAoB,KAAqB;QACvC,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAEM,MAAM,CAAC,MAAM,CAAC,SAAwB,EAAE,OAAsB;QACnE,MAAM,UAAU,GAAmB;YACjC,SAAS,EAAE,IAAI,IAAI,CAAC,SAAS,CAAC;YAC9B,OAAO,EAAE,IAAI,IAAI,CAAC,OAAO,CAAC;SAC3B,CAAC;QAEF,IAAI,CAAC,WAAW,CAAC,aAAa,CAAC,UAAU,CAAC,EAAE,CAAC;YAC3C,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,qEAAqE;aAC/E,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,WAAW,CAAC,UAAU,CAAC,CAAC;IACrC,CAAC;IAEO,MAAM,CAAC,aAAa,CAAC,KAAqB;QAChD,OAAO,CACL,WAAW,CAAC,WAAW,CAAC,KAAK,CAAC,SAAS,CAAC;YACxC,WAAW,CAAC,WAAW,CAAC,KAAK,CAAC,OAAO,CAAC;YACtC,KAAK,CAAC,SAAS,CAAC,OAAO,EAAE,IAAI,KAAK,CAAC,OAAO,CAAC,OAAO,EAAE,CACrD,CAAC;IACJ,CAAC;IAEM,OAAO;QACZ,OAAO,WAAW,CAAC,aAAa,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IAC/C,CAAC;IAEM,MAAM,CAAC,QAAQ,CAAC,SAAwB,EAAE,OAAsB;QACrE,OAAO,WAAW,CAAC,aAAa,CAAC;YAC/B,SAAS,EAAE,IAAI,IAAI,CAAC,SAAS,CAAC;YAC9B,OAAO,EAAE,IAAI,IAAI,CAAC,OAAO,CAAC;SAC3B,CAAC,CAAC;IACL,CAAC;IAEO,MAAM,CAAC,WAAW,CAAC,IAAU;QACnC,OAAO,IAAI,YAAY,IAAI,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,IAAI,CAAC,OAAO,EAAE,CAAC,CAAC;IAC/D,CAAC;IAED,IAAW,SAAS;QAClB,OAAO,IAAI,CAAC,KAAK,CAAC,SAAS,CAAC;IAC9B,CAAC;IAED,IAAW,OAAO;QAChB,OAAO,IAAI,CAAC,KAAK,CAAC,OAAO,CAAC;IAC5B,CAAC;IAEM,sBAAsB;QAC3B,OAAO,IAAI,CAAC,OAAO,CAAC,OAAO,EAAE,GAAG,IAAI,CAAC,SAAS,CAAC,OAAO,EAAE,CAAC;IAC3D,CAAC;IAEM,iBAAiB;QACtB,OAAO,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,sBAAsB,EAAE,GAAG,IAAI,CAAC,CAAC;IAC1D,CAAC;IAEM,iBAAiB;QACtB,OAAO,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,iBAAiB,EAAE,GAAG,EAAE,CAAC,CAAC;IACnD,CAAC;IAEM,eAAe;QACpB,OAAO,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,iBAAiB,EAAE,GAAG,EAAE,CAAC,CAAC;IACnD,CAAC;IAEM,cAAc;QACnB,OAAO,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,eAAe,EAAE,GAAG,EAAE,CAAC,CAAC;IACjD,CAAC;IAEM,QAAQ,CAAC,IAAmB;QACjC,MAAM,MAAM,GAAG,IAAI,IAAI,CAAC,IAAI,CAAC,CAAC;QAE9B,IAAI,CAAC,WAAW,CAAC,WAAW,CAAC,MAAM,CAAC,EAAE,CAAC;YACrC,OAAO,KAAK,CAAC;QACf,CAAC;QAED,OAAO,CACL,MAAM,CAAC,OAAO,EAAE,IAAI,IAAI,CAAC,SAAS,CAAC,OAAO,EAAE;YAC5C,MAAM,CAAC,OAAO,EAAE,IAAI,IAAI,CAAC,OAAO,CAAC,OAAO,EAAE,CAC3C,CAAC;IACJ,CAAC;IAEM,QAAQ,CAAC,KAAkB;QAChC,OAAO,CACL,IAAI,CAAC,SAAS,CAAC,OAAO,EAAE,IAAI,KAAK,CAAC,OAAO,CAAC,OAAO,EAAE;YACnD,KAAK,CAAC,SAAS,CAAC,OAAO,EAAE,IAAI,IAAI,CAAC,OAAO,CAAC,OAAO,EAAE,CACpD,CAAC;IACJ,CAAC;IAEM,SAAS,CAAC,gBAAsB,IAAI,IAAI,EAAE;QAC/C,OAAO,IAAI,CAAC,OAAO,CAAC,OAAO,EAAE,GAAG,aAAa,CAAC,OAAO,EAAE,CAAC;IAC1D,CAAC;IAEM,QAAQ,CAAC,gBAAsB,IAAI,IAAI,EAAE;QAC9C,OAAO,IAAI,CAAC,QAAQ,CAAC,aAAa,CAAC,CAAC;IACtC,CAAC;CACF;AAnGD,kCAmGC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\date-range\\date-range.vo.ts"],"sourcesContent":["// ============================================================\r\n// src/common/domain/value-objects/date-range.vo.ts\r\n// Compatível com sua BaseVO atual\r\n// ============================================================\r\n\r\nimport { BadRequestError } from \"../../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../../base.vo\";\r\n\r\nexport interface DateRangeValue {\r\n  startDate: Date;\r\n  endDate: Date;\r\n}\r\n\r\n/**\r\n * 📅 DateRangeVO - Representa intervalo entre duas datas\r\n */\r\nexport class DateRangeVO extends BaseVO<DateRangeValue> {\r\n  private constructor(value: DateRangeValue) {\r\n    super(value);\r\n  }\r\n\r\n  public static create(startDate: Date | string, endDate: Date | string): DateRangeVO {\r\n    const normalized: DateRangeValue = {\r\n      startDate: new Date(startDate),\r\n      endDate: new Date(endDate),\r\n    };\r\n\r\n    if (!DateRangeVO.isValidStatic(normalized)) {\r\n      throw new BadRequestError({\r\n        fieldName: \"dateRange\",\r\n        message: \"Invalid date range. Start date must be before or equal to end date.\",\r\n      });\r\n    }\r\n\r\n    return new DateRangeVO(normalized);\r\n  }\r\n\r\n  private static isValidStatic(value: DateRangeValue): boolean {\r\n    return (\r\n      DateRangeVO.isValidDate(value.startDate) &&\r\n      DateRangeVO.isValidDate(value.endDate) &&\r\n      value.startDate.getTime() <= value.endDate.getTime()\r\n    );\r\n  }\r\n\r\n  public isValid(): boolean {\r\n    return DateRangeVO.isValidStatic(this.value);\r\n  }\r\n\r\n  public static validate(startDate: Date | string, endDate: Date | string): boolean {\r\n    return DateRangeVO.isValidStatic({\r\n      startDate: new Date(startDate),\r\n      endDate: new Date(endDate),\r\n    });\r\n  }\r\n\r\n  private static isValidDate(date: Date): boolean {\r\n    return date instanceof Date && !Number.isNaN(date.getTime());\r\n  }\r\n\r\n  public get startDate(): Date {\r\n    return this.value.startDate;\r\n  }\r\n\r\n  public get endDate(): Date {\r\n    return this.value.endDate;\r\n  }\r\n\r\n  public durationInMilliseconds(): number {\r\n    return this.endDate.getTime() - this.startDate.getTime();\r\n  }\r\n\r\n  public durationInSeconds(): number {\r\n    return Math.floor(this.durationInMilliseconds() / 1000);\r\n  }\r\n\r\n  public durationInMinutes(): number {\r\n    return Math.floor(this.durationInSeconds() / 60);\r\n  }\r\n\r\n  public durationInHours(): number {\r\n    return Math.floor(this.durationInMinutes() / 60);\r\n  }\r\n\r\n  public durationInDays(): number {\r\n    return Math.floor(this.durationInHours() / 24);\r\n  }\r\n\r\n  public contains(date: Date | string): boolean {\r\n    const target = new Date(date);\r\n\r\n    if (!DateRangeVO.isValidDate(target)) {\r\n      return false;\r\n    }\r\n\r\n    return (\r\n      target.getTime() >= this.startDate.getTime() &&\r\n      target.getTime() <= this.endDate.getTime()\r\n    );\r\n  }\r\n\r\n  public overlaps(other: DateRangeVO): boolean {\r\n    return (\r\n      this.startDate.getTime() <= other.endDate.getTime() &&\r\n      other.startDate.getTime() <= this.endDate.getTime()\r\n    );\r\n  }\r\n\r\n  public isExpired(referenceDate: Date = new Date()): boolean {\r\n    return this.endDate.getTime() < referenceDate.getTime();\r\n  }\r\n\r\n  public isActive(referenceDate: Date = new Date()): boolean {\r\n    return this.contains(referenceDate);\r\n  }\r\n}\r\n"],"version":3}