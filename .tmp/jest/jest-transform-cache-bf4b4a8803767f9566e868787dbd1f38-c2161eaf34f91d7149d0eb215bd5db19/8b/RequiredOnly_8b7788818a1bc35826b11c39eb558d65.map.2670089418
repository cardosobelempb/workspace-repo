{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\RequiredOnly.ts","mappings":";AAAA;;2FAE2F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\RequiredOnly.ts"],"sourcesContent":["/* =====================================================================================\n *  REQUIREDONLY<T, K>\n * ===================================================================================== */\n\n/**\n * Força apenas as propriedades K a serem obrigatórias\n * mantendo o restante sem alterações.\n *\n * Muito útil em DTOs de update.\n *\n * @example\n * type User = { id?: string; name?: string; age?: number }\n * type MustHaveName = RequiredOnly<User, 'name'>\n * // { id?: string; age?: number; name: string }\n */\nexport type RequiredOnly<T, K extends keyof T> = Required<Pick<T, K>> & Omit<T, K>;\n"],"version":3}