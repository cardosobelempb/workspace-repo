{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\description\\long-description.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AACpC,mEAAmD;AAEnD,MAAa,iBAAkB,SAAQ,gBAAc;IAChC,KAAK,CAAS;IAEjC,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;QACb,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAEM,MAAM,CAAC,MAAM,CAClB,QAAgB,EAChB,OAAoB,IAAI,EACxB,YAAoB,IAAI;QAExB,MAAM,GAAG,GAAG,gCAAQ,CAAC,IAAI,CAAC,IAAI,gCAAQ,CAAC,IAAI,CAAC,CAAC;QAC7C,MAAM,KAAK,GAAG,iBAAiB,CAAC,SAAS,CAAC,QAAQ,CAAC,CAAC;QAEpD,IAAI,KAAK,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACvB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,aAAa;gBACxB,OAAO,EAAE,GAAG,CAAC,KAAK,IAAI,8BAA8B;aACrD,CAAC,CAAC;QACL,CAAC;QAED,IAAI,KAAK,CAAC,MAAM,GAAG,SAAS,EAAE,CAAC;YAC7B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,aAAa;gBACxB,OAAO,EACL,GAAG,CAAC,QAAQ;oBACZ,qDAAqD,SAAS,cAAc;aAC/E,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,iBAAiB,CAAC,KAAK,CAAC,CAAC;IACtC,CAAC;IAEM,OAAO;QACZ,OAAO,IAAI,CAAC,KAAK,CAAC,MAAM,GAAG,CAAC,IAAI,IAAI,CAAC,KAAK,CAAC,MAAM,IAAI,IAAI,CAAC;IAC5D,CAAC;IAEO,MAAM,CAAC,SAAS,CAAC,KAAa;QACpC,OAAO,CAAC,KAAK,IAAI,EAAE,CAAC,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC;IACnD,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAEM,MAAM,CAAC,KAAwB;QACpC,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,QAAQ,EAAE,CAAC;IACzC,CAAC;CACF;AAlDD,8CAkDC;AAED;;;;;;;;;;;;;;GAcG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\description\\long-description.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { BaseVO } from \"../base.vo\";\nimport { messages } from \"./desciption-message.vo\";\n\nexport class LongDescriptionVO extends BaseVO<string> {\n  protected readonly value: string;\n\n  private constructor(value: string) {\n    super(value);\n    this.value = value;\n  }\n\n  public static create(\n    rawValue: string,\n    lang: \"pt\" | \"en\" = \"en\",\n    maxLength: number = 1000,\n  ): LongDescriptionVO {\n    const msg = messages[lang] ?? messages[\"en\"];\n    const value = LongDescriptionVO.normalize(rawValue);\n\n    if (value.length === 0) {\n      throw new BadRequestError({\n        fieldName: \"description\",\n        message: msg.EMPTY ?? \"Description cannot be empty.\",\n      });\n    }\n\n    if (value.length > maxLength) {\n      throw new BadRequestError({\n        fieldName: \"description\",\n        message:\n          msg.TOO_LONG ??\n          `Description exceeds the maximum allowed length of ${maxLength} characters.`,\n      });\n    }\n\n    return new LongDescriptionVO(value);\n  }\n\n  public isValid(): boolean {\n    return this.value.length > 0 && this.value.length <= 1000;\n  }\n\n  private static normalize(value: string): string {\n    return (value ?? \"\").trim().replace(/\\s+/g, \" \");\n  }\n\n  public toString(): string {\n    return this.value;\n  }\n\n  public equals(other: LongDescriptionVO): boolean {\n    return this.value === other.getValue();\n  }\n}\n\n/**\n const shortDesc = ShortDescriptionVO.create('Título do produto')\nconsole.log(shortDesc.getValue())\n// \"Título do produto\"\n\nconst longDesc = LongDescriptionVO.create('Descrição detalhada do produto, com muitas informações importantes para o cliente.')\nconsole.log(longDesc.getValue())\n// \"Descrição detalhada do produto, com muitas informações importantes para o cliente.\"\n\n// Comparação\nconst anotherLongDesc = LongDescriptionVO.create('Descrição detalhada do produto, com muitas informações importantes para o cliente.')\nconsole.log(longDesc.equals(anotherLongDesc))\n// true\n\n */\n"],"version":3}