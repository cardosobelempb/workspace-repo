{"version":3,"names":["cov_kd14bul9t","actualCoverage","s","common_1","require","account_entity_1","AccountFactory","build","input","f","AccountEntity","create","userId","UUIDVO","providerAccountId","provider","email","EmailVO","refreshToken","accessToken","expiresAt","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\account.factory.ts"],"sourcesContent":["import { EmailVO, UUIDVO } from \"@repo/common\";\r\nimport { AccountEntity } from \"../../domain/entities/account.entity\";\r\nimport { AccountCreateDto } from \"../dto\";\r\n\r\nexport type BuildAccountInput = {\r\n  userId: string;\r\n  accountToken: string;\r\n  expires: Date;\r\n  ipAddress?: string | null;\r\n  userAgent?: string | null;\r\n};\r\n\r\nexport class AccountFactory {\r\n  static build(input: AccountCreateDto): AccountEntity {\r\n    return AccountEntity.create({\r\n      userId: UUIDVO.create(input.userId),\r\n      providerAccountId: input.providerAccountId,\r\n      provider: input.provider,\r\n      email: EmailVO.create(input.email),\r\n      refreshToken: input.refreshToken,\r\n      accessToken: input.accessToken,\r\n      expiresAt: input.expiresAt,\r\n    });\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IAsBO;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AAtBP,MAAAC,QAAA;AAAA;AAAA,CAAAH,aAAA,GAAAE,CAAA,OAAAE,OAAA;AACA,MAAAC,gBAAA;AAAA;AAAA,CAAAL,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAWA,MAAaE,cAAc;EACzB,OAAOC,KAAKA,CAACC,KAAuB;IAAA;IAAAR,aAAA,GAAAS,CAAA;IAAAT,aAAA,GAAAE,CAAA;IAClC,OAAOG,gBAAA,CAAAK,aAAa,CAACC,MAAM,CAAC;MAC1BC,MAAM,EAAET,QAAA,CAAAU,MAAM,CAACF,MAAM,CAACH,KAAK,CAACI,MAAM,CAAC;MACnCE,iBAAiB,EAAEN,KAAK,CAACM,iBAAiB;MAC1CC,QAAQ,EAAEP,KAAK,CAACO,QAAQ;MACxBC,KAAK,EAAEb,QAAA,CAAAc,OAAO,CAACN,MAAM,CAACH,KAAK,CAACQ,KAAK,CAAC;MAClCE,YAAY,EAAEV,KAAK,CAACU,YAAY;MAChCC,WAAW,E