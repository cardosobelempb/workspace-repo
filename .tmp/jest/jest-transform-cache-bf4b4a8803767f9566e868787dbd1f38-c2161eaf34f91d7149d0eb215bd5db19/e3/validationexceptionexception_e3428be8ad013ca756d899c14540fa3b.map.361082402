{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\validations\\validation.exception.exception.ts","mappings":";;;AAAA,6DAAyD;AAGzD,MAAa,mBAAoB,SAAQ,8BAAa;IACpD,YAAY,MAA+D;QACzE,KAAK,CAAC;YACJ,UAAU,EAAE,GAAG;YACf,IAAI,EAAE,sBAAsB;YAC5B,KAAK,EAAE,kBAAkB;YACzB,OAAO,EAAE,MAAM,CAAC,OAAO,IAAI,GAAG,MAAM,CAAC,SAAS,KAAK,MAAM,CAAC,KAAK,aAAa;YAC5E,SAAS,EAAE,MAAM,CAAC,SAAS;SAC5B,CAAC,CAAC;IACL,CAAC;CACF;AAVD,kDAUC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\validations\\validation.exception.exception.ts"],"sourcesContent":["import { StandardError } from \"../errors/standard.error\";\nimport { BaseUseCaseError } from \"../errors/usecases/base-usecase.error\";\n\nexport class ValidationException extends StandardError implements BaseUseCaseError {\n  constructor(params: { fieldName: string; value?: string; message?: string }) {\n    super({\n      statusCode: 400,\n      code: \"ValidationException \",\n      error: \"Validation Error\",\n      message: params.message ?? `${params.fieldName} \"${params.value}\" já existe`,\n      fieldName: params.fieldName,\n    });\n  }\n}\n"],"version":3}