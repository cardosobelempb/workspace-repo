{"file":"E:\\workspace-sass\\repo\\packages\\jest-config\\helpers\\mock.helper.ts","mappings":";;AAIA,gCAEC;AAFD,SAAgB,UAAU,CAAI,IAAwB;IACpD,OAAO,IAAiB,CAAC;AAC3B,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\jest-config\\helpers\\mock.helper.ts"],"sourcesContent":["export type Mocked<T> = {\n  [K in keyof T]: T[K] extends (...args: infer A) => infer R ? jest.Mock<R, A> : T[K];\n};\n\nexport function createMock<T>(mock: Partial<Mocked<T>>): Mocked<T> {\n  return mock as Mocked<T>;\n}\n"],"version":3}