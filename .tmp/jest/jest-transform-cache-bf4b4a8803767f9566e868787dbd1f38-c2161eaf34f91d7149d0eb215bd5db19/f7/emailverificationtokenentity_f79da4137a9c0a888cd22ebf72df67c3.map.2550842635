{"version":3,"names":["cov_bzq21u1k2","actualCoverage","s","common_1","require","EmailVerificationTokenEntity","BaseAggregate","userId","f","props","tokenHash","expiresAt","usedAt","markAsUsed","isUsed","b","Date","createdAt","deletedAt","isDeleted","create","id","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\domain\\entities\\email-verification-token.entity.ts"],"sourcesContent":["import { BaseAggregate, Optional, UUIDVO } from \"@repo/common\";\r\n\r\nexport interface EmailVerificationTokenProps {\r\n  userId: UUIDVO;\r\n  tokenHash: string;\r\n  expiresAt: Date;\r\n  usedAt: Date | null;\r\n  createdAt: Date;\r\n  deletedAt: Date | null;\r\n}\r\n\r\nexport class EmailVerificationTokenEntity extends BaseAggregate<EmailVerificationTokenProps> {\r\n  get userId() {\r\n    return this.props.userId;\r\n  }\r\n  get tokenHash() {\r\n    return this.props.tokenHash;\r\n  }\r\n  get expiresAt() {\r\n    return this.props.expiresAt;\r\n  }\r\n  get usedAt() {\r\n    return this.props.usedAt;\r\n  }\r\n\r\n  markAsUsed(): void {\r\n    if (!this.isUsed()) {\r\n      this.props.usedAt = new Date();\r\n    }\r\n  }\r\n\r\n  isUsed(): boolean {\r\n    return this.props.usedAt !== null;\r\n  }\r\n\r\n  get createdAt() {\r\n    return this.props.createdAt;\r\n  }\r\n\r\n  get deletedAt() {\r\n    return this.props.deletedAt;\r\n  }\r\n\r\n  isDeleted(): boolean {\r\n    return this.props.deletedAt !== null;\r\n  }\r\n\r\n  static create(\r\n    props: Optional<EmailVerificationTokenProps, \"createdAt\" | \"deletedAt\">,\r\n    id?: UUIDVO,\r\n  ) {\r\n    return new EmailVerificationTokenEntity(\r\n      {\r\n        ...props,\r\n        createdAt: props.createdAt ?? new Date(),\r\n        deletedAt: props.deletedAt ?? null,\r\n      },\r\n      id,\r\n    );\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;