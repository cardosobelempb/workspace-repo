{"version":3,"names":["cov_2aq4bnwky0","actualCoverage","s","common_1","require","UserEntity","BaseAggregate","email","f","props","firstName","lastName","passwordHash","emailVerified","createdAt","updatedAt","deletedAt","softDelete","isDeleted","b","Date","touch","restore","updateEmailVerified","verifiedAt","updateEmail","updatePasswordHash","hash","create","id","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\domain\\entities\\user.entity.ts"],"sourcesContent":["import { BaseAggregate, EmailVO, Optional, PasswordHashVO, UUIDVO } from \"@repo/common\";\n\nexport interface UserProps {\n  email: EmailVO;\n  firstName: string;\n  lastName: string;\n  passwordHash: PasswordHashVO;\n  emailVerified: Date | null;\n  createdAt: Date;\n  updatedAt: Date | null;\n  deletedAt: Date | null;\n}\n\nexport class UserEntity extends BaseAggregate<UserProps> {\n  get email() {\n    return this.props.email;\n  }\n  get firstName() {\n    return this.props.firstName;\n  }\n  get lastName() {\n    return this.props.lastName;\n  }\n  get passwordHash() {\n    return this.props.passwordHash;\n  }\n  get emailVerified() {\n    return this.props.emailVerified;\n  }\n  get createdAt() {\n    return this.props.createdAt;\n  }\n  get updatedAt() {\n    return this.props.updatedAt;\n  }\n  get deletedAt() {\n    return this.props.deletedAt;\n  }\n\n  softDelete(): void {\n    if (!this.isDeleted()) {\n      this.props.deletedAt = new Date();\n      this.touch();\n    }\n  }\n  restore(): void {\n    this.props.deletedAt = null;\n    this.touch();\n  }\n\n  updateEmailVerified(verifiedAt: Date): void {\n    this.props.emailVerified = new Date(verifiedAt);\n    this.touch();\n  }\n\n  isDeleted(): boolean {\n    return this.props.deletedAt !== null;\n  }\n\n  updateEmail(email: EmailVO): void {\n    this.props.email = email;\n    this.touch();\n  }\n  updatePasswordHash(hash: PasswordHashVO): void {\n    this.props.passwordHash = hash;\n    this.touch();\n  }\n\n  private touch(): void {\n    this.props.updatedAt = new Date();\n  }\n\n  static create(\n    props: Optional<UserProps, \"createdAt\" | \"updatedAt\" | \"deletedAt\">,\n    id?: UUIDVO,\n  ) {\n    return new UserEntity(\n      {\n        ...props,\n        createdAt: props.createdAt ?? new Date(),\n        updatedAt: props.updatedAt ?? null,\n        deletedAt: props.deletedAt ?? null,\n      },\n      id,\n    );\n  }\n}\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IAwBI;IAAAA,cAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,cAAA;AAAAA,cAAA,GAAAE,CAAA;;;;;;;AAxBJ,MAAAC,QAAA;AAAA;AAAA,CAAAH,cAAA,GAAAE,CAAA,OAAAE,OAAA;AAaA,MAAaC,UAAW;AAAA;AAAA,CAAQF,QAAA,CAAAG,aAAwB;EACtD,IAAIC,KAAKA,CAAA;IAAA;IAAAP,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACP,OAAO,IAAI,CAACO,KAAK,CAACF,KAAK;EACzB;EACA,IAAIG,SAASA,CAAA;IAAA;IAAAV,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACC,SAAS;EAC7B;EACA,IAAIC,QAAQA,CAAA;IAAA;IAAAX,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACV,OAAO,IAAI,CAACO,KAAK,CAACE,QAAQ;EAC5B;EACA,IAAIC,YAAYA,CAAA;IAAA;IAAAZ,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACd,OAAO,IAAI,CAACO,KAAK,CAACG,YAAY;EAChC;EACA,IAAIC,aAAaA,CAA