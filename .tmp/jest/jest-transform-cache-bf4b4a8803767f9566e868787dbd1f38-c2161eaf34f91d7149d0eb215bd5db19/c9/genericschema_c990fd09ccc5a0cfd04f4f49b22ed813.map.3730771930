{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\generic.schema.ts","mappings":";;;AAAA,6BAAwB;AAEX,QAAA,aAAa,GAAG,OAAC,CAAC,MAAM,CAAC;IACpC,OAAO,EAAE,OAAC,CAAC,MAAM,EAAE;CACpB,CAAC,CAAC;AAEU,QAAA,oBAAoB,GAAG,OAAC,CAAC,MAAM,CAAC;IAC3C,EAAE,EAAE,OAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE;CAC5B,CAAC,CAAC;AAIU,QAAA,oBAAoB,GAAG,OAAC,CAAC,MAAM,CAAC;IAC3C,EAAE,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;CACtB,CAAC,CAAC;AAGH,uCAAuC;AAC1B,QAAA,cAAc,GAAG,4BAAoB,CAAC;AAEtC,QAAA,qBAAqB,GAAG,OAAC,CAAC,MAAM,CAAC;IAC5C,OAAO,EAAE,OAAC,CAAC,MAAM,EAAE;IACnB,QAAQ,EAAE,OAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE;CAC3B,CAAC,CAAC;AAEU,QAAA,YAAY,GAAG,OAAC,CAAC,MAAM,CAAC;IACnC,EAAE,EAAE,OAAC,CAAC,OAAO,EAAE;CAChB,CAAC,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\generic.schema.ts"],"sourcesContent":["import { z } from \"zod\";\n\nexport const MessageSchema = z.object({\n  message: z.string(),\n});\n\nexport const ParamsIdNumberSchema = z.object({\n  id: z.coerce.number().int(),\n});\n\nexport type ParamsIdNumber = z.infer<typeof ParamsIdNumberSchema>;\n\nexport const ParamsIdStringSchema = z.object({\n  id: z.string().min(1),\n});\nexport type ParamsIdString = z.infer<typeof ParamsIdStringSchema>;\n\n// Compat (se ainda existir uso antigo)\nexport const ParamsIdSchema = ParamsIdStringSchema;\n\nexport const CleanupResponseSchema = z.object({\n  message: z.string(),\n  affected: z.number().int(),\n});\n\nexport const StatusSchema = z.object({\n  ok: z.boolean(),\n});\n"],"version":3}