{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\time\\time.vo.ts","mappings":";;;AAAA,qFAAgF;AAChF,iDAAgD;AAEhD,MAAa,MAAO,SAAQ,6BAAc;IACrB,KAAK,CAAS;IAEjC,YAAY,IAAY;QACtB,KAAK,EAAE,CAAC;QACR,IAAI,CAAC,KAAK,GAAG,IAAI,CAAC,QAAQ,CAAC,IAAI,CAAC,CAAC;IACnC,CAAC;IAES,QAAQ,CAAC,IAAY;QAC7B,MAAM,KAAK,GAAG,2BAA2B,CAAC;QAC1C,IAAI,CAAC,KAAK,CAAC,IAAI,CAAC,IAAI,CAAC,EAAE,CAAC;YACtB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,MAAM;gBACjB,OAAO,EAAE,mDAAmD;aAC7D,CAAC,CAAC;QACL,CAAC;QACD,OAAO,IAAI,CAAC;IACd,CAAC;IAED,QAAQ;QACN,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAED,QAAQ;QACN,OAAO,QAAQ,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,IAAI,GAAG,EAAE,EAAE,CAAC,CAAC;IACvD,CAAC;IAED,UAAU;QACR,OAAO,QAAQ,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,IAAI,GAAG,EAAE,EAAE,CAAC,CAAC;IACvD,CAAC;IAED,QAAQ;QACN,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAED,MAAM,CAAC,KAAa;QAClB,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,QAAQ,EAAE,CAAC;IACzC,CAAC;CACF;AAtCD,wBAsCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\time\\time.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../../errors/controllers/bad-request.error\";\r\nimport { AbstractTimeVO } from \"./base-time.vo\";\r\n\r\nexport class TimeVO extends AbstractTimeVO {\r\n  protected readonly value: string;\r\n\r\n  constructor(time: string) {\r\n    super();\r\n    this.value = this.validate(time);\r\n  }\r\n\r\n  protected validate(time: string): string {\r\n    const regex = /^([01]\\d|2[0-3]):[0-5]\\d$/;\r\n    if (!regex.test(time)) {\r\n      throw new BadRequestError({\r\n        fieldName: \"time\",\r\n        message: \"Time must be in the format HH:mm (24-hour format)\",\r\n      });\r\n    }\r\n    return time;\r\n  }\r\n\r\n  getValue(): string {\r\n    return this.value;\r\n  }\r\n\r\n  getHours(): number {\r\n    return parseInt(this.value.split(\":\")[0] ?? \"0\", 10);\r\n  }\r\n\r\n  getMinutes(): number {\r\n    return parseInt(this.value.split(\":\")[1] ?? \"0\", 10);\r\n  }\r\n\r\n  toString(): string {\r\n    return this.value;\r\n  }\r\n\r\n  equals(other: TimeVO): boolean {\r\n    return this.value === other.getValue();\r\n  }\r\n}\r\n"],"version":3}