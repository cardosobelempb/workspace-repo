QAAQ,GAAG,IAAI,CAAC,KAAK,CAAC,MAAM,KAAK,EAAE,CAAC;QAC1C,MAAM,SAAS,GAAG,QAAQ,CAAC,CAAC,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC;QAC7E,MAAM,UAAU,GAAG,QAAQ,CAAC,CAAC,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC;QACxE,OAAO,IAAI,GAAG,KAAK,SAAS,IAAI,UAAU,EAAE,CAAC;IAC/C,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,MAAM,EAAE,CAAC;IACvB,CAAC;IAED,qCAAqC;IACrC,mCAAmC;IACnC,qCAAqC;IAE7B,MAAM,CAAC,KAAK,CAAC,KAAa;QAChC,OAAO,KAAK,CAAC,OAAO,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC;IAClC,CAAC;IAEO,MAAM,CAAC,QAAQ,CAAC,OAAe,EAAE,GAAW,EAAE,GAAW;QAC/D,IAAI,CAAC,OAAO,CAAC,IAAI,CAAC,OAAO,CAAC,EAAE,CAAC;YAC3B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,wCAAwC;aAClD,CAAC,CAAC;QACL,CAAC;QAED,IAAI,OAAO,CAAC,MAAM,GAAG,GAAG,EAAE,CAAC;YACzB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,mCAAmC,GAAG,UAAU;aAC1D,CAAC,CAAC;QACL,CAAC;QAED,IAAI,OAAO,CAAC,MAAM,GAAG,GAAG,EAAE,CAAC;YACzB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,kCAAkC,GAAG,UAAU;aACzD,CAAC,CAAC;QACL,CAAC;QAED,MAAM,GAAG,GAAG,OAAO,CAAC,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC;QAChC,MAAM,MAAM,GAAG,OAAO,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC;QAEhC,IAAI,CAAC,OAAO,CAAC,UAAU,CAAC,QAAQ,CAAC,GAAG,CAAC,EAAE,CAAC;YACtC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,gBAAgB,GAAG,oBAAoB,OAAO,CAAC,UAAU,CAAC,IAAI,CAAC,IAAI,CAAC,GAAG;aACjF,CAAC,CAAC;QACL,CAAC;QAED,IAAI,MAAM,CAAC,MAAM,KAAK,CAAC,IAAI,MAAM,CAAC,CAAC,CAAC,KAAK,GAAG,EAAE,CAAC;YAC7C,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,iEAAiE;aAC3E,CAAC,CAAC;QACL,CAAC;QAED,IAAI,MAAM,CAAC,MAAM,KAAK,CAAC,IAAI,CAAC,CAAC,GAAG,EAAE,GAAG,EAAE,GAAG,EAAE,GAAG,CAAC,CAAC,QAAQ,CAAC,MAAM,CAAC,CAAC,CAAE,CAAC,EAAE,CAAC;YACtE,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,OAAO;gBAClB,KAAK,EAAE,OAAO;gBACd,OAAO,EAAE,8EAA8E;aACxF,CAAC,CAAC;QACL,CAAC;IACH,CAAC;IAED,2CAA2C;IACpC,MAAM,CAAC,OAAO,CAAC,KAAqB;QACzC,IAAI,CAAC,KAAK,IAAI,KAAK,CAAC,IAAI,EAAE,KAAK,EAAE;YAAE,OAAO,KAAK,CAAC;QAChD,IAAI,CAAC;YACH,MAAM,OAAO,GAAG,OAAO,CAAC,KAAK,CAAC,KAAK,CAAC,CAAC;YACrC,OAAO,CAAC,QAAQ,CAAC,OAAO,EAAE,IAAI,CAAC,kBAAkB,EAAE,IAAI,CAAC,kBAAkB,CAAC,CAAC;YAC5E,OAAO,IAAI,CAAC;QACd,CAAC;QAAC,MAAM,CAAC;YACP,OAAO,KAAK,CAAC;QACf,CAAC;IACH,CAAC;;AA3MH,0BA4MC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\phone\\phone.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { BaseVO } from \"../base.vo\";\n\nexport interface PhoneValidationOptions {\n  minLength?: number;\n  maxLength?: number;\n}\n\n/**\n * ✅ Value Object de Telefone (Brasil)\n * - Aceita `undefined`, `null` ou string vazia e trata internamente\n * - Valida DDD, tamanho e formato\n * - Imutável e seguro\n */\nexport class PhoneVO extends BaseVO<string> {\n  private static readonly VALID_DDDS = [\n    \"11\",\n    \"12\",\n    \"13\",\n    \"14\",\n    \"15\",\n    \"16\",\n    \"17\",\n    \"18\",\n    \"19\",\n    \"21\",\n    \"22\",\n    \"24\",\n    \"27\",\n    \"28\",\n    \"31\",\n    \"32\",\n    \"33\",\n    \"34\",\n    \"35\",\n    \"37\",\n    \"38\",\n    \"41\",\n    \"42\",\n    \"43\",\n    \"44\",\n    \"45\",\n    \"46\",\n    \"47\",\n    \"48\",\n    \"49\",\n    \"51\",\n    \"53\",\n    \"54\",\n    \"55\",\n    \"61\",\n    \"62\",\n    \"63\",\n    \"64\",\n    \"65\",\n    \"66\",\n    \"67\",\n    \"68\",\n    \"69\",\n    \"71\",\n    \"73\",\n    \"74\",\n    \"75\",\n    \"77\",\n    \"79\",\n    \"81\",\n    \"82\",\n    \"83\",\n    \"84\",\n    \"85\",\n    \"86\",\n    \"87\",\n    \"88\",\n    \"89\",\n    \"91\",\n    \"92\",\n    \"93\",\n    \"94\",\n    \"95\",\n    \"96\",\n    \"97\",\n    \"98\",\n    \"99\",\n  ];\n\n  private static readonly DEFAULT_MIN_LENGTH = 10;\n  private static readonly DEFAULT_MAX_LENGTH = 11;\n\n  protected readonly value: string;\n\n  /** Construtor privado — use o método de fábrica `create()` */\n  private constructor(phone: string) {\n    super(phone);\n    this.value = PhoneVO.clean(phone);\n  }\n\n  // ==================================\n  // 🏗️ Fábrica segura (create)\n  // ==================================\n  public static create(\n    phone?: string | null,\n    options: PhoneValidationOptions = {},\n  ): PhoneVO {\n    if (phone == null || phone.trim() === \"\") {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        message: \"Phone number cannot be empty.\",\n      });\n    }\n\n    const cleaned = PhoneVO.clean(phone);\n    const { minLength = this.DEFAULT_MIN_LENGTH, maxLength = this.DEFAULT_MAX_LENGTH } =\n      options;\n\n    PhoneVO.validate(cleaned, minLength, maxLength);\n    return new PhoneVO(cleaned);\n  }\n\n  // ==================================\n  // 🧩 Métodos de instância\n  // ==================================\n\n  public getValue(): string {\n    return this.value;\n  }\n\n  public equals(other?: BaseVO<string> | null): boolean {\n    return !!other && this.value === (other as PhoneVO).value;\n  }\n\n  public isValid(): boolean {\n    return PhoneVO.isValid(this.value);\n  }\n\n  public format(): string {\n    const ddd = this.value.slice(0, 2);\n    const isMobile = this.value.length === 11;\n    const firstPart = isMobile ? this.value.slice(2, 7) : this.value.slice(2, 6);\n    const secondPart = isMobile ? this.value.slice(7) : this.value.slice(6);\n    return `(${ddd}) ${firstPart}-${secondPart}`;\n  }\n\n  public toString(): string {\n    return this.format();\n  }\n\n  // ==================================\n  // 🧱 Métodos utilitários estáticos\n  // ==================================\n\n  private static clean(phone: string): string {\n    return phone.replace(/\\D/g, \"\");\n  }\n\n  private static validate(cleaned: string, min: number, max: number): void {\n    if (!/^\\d+$/.test(cleaned)) {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: \"Phone number must contain only digits.\",\n      });\n    }\n\n    if (cleaned.length < min) {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: `Phone number must have at least ${min} digits.`,\n      });\n    }\n\n    if (cleaned.length > max) {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: `Phone number must have at most ${max} digits.`,\n      });\n    }\n\n    const ddd = cleaned.slice(0, 2);\n    const number = cleaned.slice(2);\n\n    if (!PhoneVO.VALID_DDDS.includes(ddd)) {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: `Invalid DDD: ${ddd}. Must be one of ${PhoneVO.VALID_DDDS.join(\", \")}.`,\n      });\n    }\n\n    if (number.length === 9 && number[0] !== \"9\") {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: `Invalid mobile phone number: 9-digit numbers must start with 9.`,\n      });\n    }\n\n    if (number.length === 8 && ![\"2\", \"3\", \"4\", \"5\"].includes(number[0]!)) {\n      throw new BadRequestError({\n        fieldName: \"phone\",\n        value: cleaned,\n        message: `Invalid landline phone number: 8-digit numbers must start with 2, 3, 4 or 5.`,\n      });\n    }\n  }\n\n  /** Verifica validade sem lançar exceção */\n  public static isValid(phone?: string | null): boolean {\n    if (!phone || phone.trim() === \"\") return false;\n    try {\n      const cleaned = PhoneVO.clean(phone);\n      PhoneVO.validate(cleaned, this.DEFAULT_MIN_LENGTH, this.DEFAULT_MAX_LENGTH);\n      return true;\n    } catch {\n      return false;\n    }\n  }\n}\n"],"version":3}