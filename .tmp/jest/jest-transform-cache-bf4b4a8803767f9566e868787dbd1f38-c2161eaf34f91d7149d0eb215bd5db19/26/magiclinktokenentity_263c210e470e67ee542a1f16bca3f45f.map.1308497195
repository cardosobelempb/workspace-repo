{"version":3,"names":["cov_w1izcuivv","actualCoverage","s","common_1","require","MagicLinkTokenEntity","BaseAggregate","email","f","props","tokenHash","ipAddress","userAgent","expiresAt","usedAt","markAsUsed","isUsed","b","Date","createdAt","deletedAt","isDeleted","create","id","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\domain\\entities\\magic-link-token.entity.ts"],"sourcesContent":["import {\r\n  BaseAggregate,\r\n  EmailVO,\r\n  IpAddressVO,\r\n  Optional,\r\n  UserAgentVO,\r\n  UUIDVO,\r\n} from \"@repo/common\";\r\n\r\nexport interface MagicLinkTokenProps {\r\n  email: EmailVO;\r\n  tokenHash: string;\r\n  ipAddress: IpAddressVO;\r\n  userAgent: UserAgentVO;\r\n  expiresAt: Date;\r\n  usedAt: Date | null;\r\n  createdAt: Date;\r\n  deletedAt: Date | null;\r\n}\r\n\r\nexport class MagicLinkTokenEntity extends BaseAggregate<MagicLinkTokenProps> {\r\n  get email() {\r\n    return this.props.email;\r\n  }\r\n  get tokenHash() {\r\n    return this.props.tokenHash;\r\n  }\r\n  get ipAddress() {\r\n    return this.props.ipAddress;\r\n  }\r\n  get userAgent() {\r\n    return this.props.userAgent;\r\n  }\r\n  get expiresAt() {\r\n    return this.props.expiresAt;\r\n  }\r\n  get usedAt() {\r\n    return this.props.usedAt;\r\n  }\r\n\r\n  markAsUsed(): void {\r\n    if (!this.isUsed()) {\r\n      this.props.usedAt = new Date();\r\n    }\r\n  }\r\n\r\n  isUsed(): boolean {\r\n    return this.props.usedAt !== null;\r\n  }\r\n\r\n  get createdAt() {\r\n    return this.props.createdAt;\r\n  }\r\n\r\n  get deletedAt() {\r\n    return this.props.deletedAt;\r\n  }\r\n\r\n  isDeleted(): boolean {\r\n    return this.props.deletedAt !== null;\r\n  }\r\n\r\n  static create(\r\n    props: Optional<MagicLinkTokenProps, \"createdAt\" | \"deletedAt\">,\r\n    id?: UUIDVO,\r\n  ) {\r\n    return new MagicLinkTokenEntity(\r\n      {\r\n        ...props,\r\n        createdAt: props.createdAt ?? new Date(),\r\n        deletedAt: props.deletedAt ?? null,\r\n      },\r\n      id,\r\n    );\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IA+BI;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AA/BJ,MAAAC,QAAA;AAAA;AAAA,CAAAH,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAoBA,MAAaC,oBAAqB;AAAA;AAAA,CAAQF,QAAA,CAAAG,aAAkC;EAC1E,IAAIC,KAAKA,CAAA;IAAA;IAAAP,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACP,OAAO,IAAI,CAACO,KAAK,CAACF,KAAK;EACzB;EACA,IAAIG,SAASA,CAAA;IAAA;IAAAV,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACC,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAX,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACE,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAZ,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACG,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAb,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACI,SAAS;EAC7B;EACA,IAAIC,MAAMA,CAAA;IAAA;IAAAd,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACR,OAAO,IAAI,CAACO,KAAK,CAACK,MAAM;EAC1B;EAEAC,UAAUA,CAAA;IAAA;IAAAf,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACR,IAAI,CAAC,IAAI,CAACc,MAAM,EAAE,EAAE;MAAA;MAAAhB,aAAA,GAAAiB,CAAA;MAAAjB,aAAA,GAAAE,CAAA;MAClB,IAAI,CAACO,KAAK,CAACK,MAAM,GAAG,IAAII,IAAI,EAAE;IAChC,CAAC;IAAA;IAAA;MAAAlB,aAAA,GAAAiB,CAAA;IAAA;EACH;EAEAD,MAAMA,CAAA;IAAA;IAAAhB,aAAA,GAAAQ,CAAA;IAAAR,aAAA,GAAAE,CAAA;IACJ,OAAO,IAAI,CAACO,KAAK,CAACK,MAAM,KAAK,IAAI;EACnC;EAEA,IAAIK,SA