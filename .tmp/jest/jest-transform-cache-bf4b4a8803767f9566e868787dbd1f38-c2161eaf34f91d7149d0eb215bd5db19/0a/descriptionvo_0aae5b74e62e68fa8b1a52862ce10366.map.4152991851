{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\description\\description.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,mEAAmD;AAQnD,MAAa,aAAa;IACP,KAAK,CAAS;IAE/B,YAAoB,KAAa;QAC/B,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAEM,MAAM,CAAC,MAAM,CAClB,QAAgB,EAChB,OAAoB,IAAI,EACxB,UAAwC,EAAE,QAAQ,EAAE,IAAI,EAAE,SAAS,EAAE,GAAG,EAAE;QAE1E,MAAM,GAAG,GAAG,gCAAQ,CAAC,IAAI,CAAC,IAAI,gCAAQ,CAAC,IAAI,CAAC,CAAC;QAC7C,MAAM,KAAK,GAAG,aAAa,CAAC,SAAS,CAAC,QAAQ,CAAC,CAAC;QAEhD,MAAM,EAAE,QAAQ,GAAG,IAAI,EAAE,SAAS,GAAG,GAAG,EAAE,SAAS,GAAG,CAAC,EAAE,GAAG,OAAO,CAAC;QAEpE,IAAI,QAAQ,IAAI,KAAK,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACnC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,aAAa;gBACxB,OAAO,EAAE,GAAG,CAAC,KAAK,IAAI,8BAA8B;aACrD,CAAC,CAAC;QACL,CAAC;QAED,IAAI,KAAK,CAAC,MAAM,GAAG,SAAS,EAAE,CAAC;YAC7B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,aAAa;gBACxB,OAAO,EAAE,GAAG,CAAC,SAAS,IAAI,qBAAqB,SAAS,EAAE;aAC3D,CAAC,CAAC;QACL,CAAC;QAED,IAAI,KAAK,CAAC,MAAM,GAAG,SAAS,EAAE,CAAC;YAC7B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,aAAa;gBACxB,OAAO,EAAE,GAAG,CAAC,QAAQ,IAAI,qBAAqB,SAAS,EAAE;aAC1D,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,aAAa,CAAC,KAAK,CAAC,CAAC;IAClC,CAAC;IAED,6CAA6C;IACrC,MAAM,CAAC,SAAS,CAAC,KAAa;QACpC,OAAO,CAAC,KAAK,IAAI,EAAE,CAAC,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,MAAM,EAAE,GAAG,CAAC,CAAC;IACnD,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAED,kCAAkC;IAC3B,MAAM,CAAC,KAAoB;QAChC,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,QAAQ,EAAE,CAAC;IACzC,CAAC;CACF;AA1DD,sCA0DC;AAED;;;;;;;;;;;;;;;;;;GAkBG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\description\\description.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { messages } from \"./desciption-message.vo\";\n\ntype DescriptionValidationOptions = {\n  required?: boolean;\n  maxLength?: number;\n  minLength?: number;\n};\n\nexport class DescriptionVO {\n  private readonly value: string;\n\n  private constructor(value: string) {\n    this.value = value;\n  }\n\n  public static create(\n    rawValue: string,\n    lang: \"pt\" | \"en\" = \"en\",\n    options: DescriptionValidationOptions = { required: true, maxLength: 500 },\n  ): DescriptionVO {\n    const msg = messages[lang] ?? messages[\"en\"];\n    const value = DescriptionVO.normalize(rawValue);\n\n    const { required = true, maxLength = 500, minLength = 0 } = options;\n\n    if (required && value.length === 0) {\n      throw new BadRequestError({\n        fieldName: \"description\",\n        message: msg.EMPTY ?? \"Description cannot be empty.\",\n      });\n    }\n\n    if (value.length < minLength) {\n      throw new BadRequestError({\n        fieldName: \"description\",\n        message: msg.TOO_SHORT ?? `Minimum length is ${minLength}`,\n      });\n    }\n\n    if (value.length > maxLength) {\n      throw new BadRequestError({\n        fieldName: \"description\",\n        message: msg.TOO_LONG ?? `Maximum length is ${maxLength}`,\n      });\n    }\n\n    return new DescriptionVO(value);\n  }\n\n  // Normaliza: trim + remove múltiplos espaços\n  private static normalize(value: string): string {\n    return (value ?? \"\").trim().replace(/\\s+/g, \" \");\n  }\n\n  public getValue(): string {\n    return this.value;\n  }\n\n  public toString(): string {\n    return this.value;\n  }\n\n  // Compara com outro DescriptionVO\n  public equals(other: DescriptionVO): boolean {\n    return this.value === other.getValue();\n  }\n}\n\n/**\n * Exemplo prático:\n const desc1 = DescriptionVO.create('  Esta é uma descrição de teste.  ')\nconsole.log(desc1.getValue())\n// \"Esta é uma descrição de teste.\"\n\nconst desc2 = DescriptionVO.create('Esta é uma descrição de teste.')\nconsole.log(desc1.equals(desc2))\n// true\n\n// Tentativa de criar descrição vazia com required = true\ntry {\n  DescriptionVO.create('', 'pt', { required: true })\n} catch (err) {\n  console.error(err.message)\n  // Ex: \"Campo obrigatório\" (dependendo do msg do PT)\n}\n\n */\n"],"version":3}