CF,MAAM,SAAS,GAAG,IAAI,IAAI,CAAC,IAAI,CAAC,GAAG,EAAE,GAAG,IAAI,CAAC,iBAAiB,GAAG,IAAI,CAAC,CAAC;QAEvE,MAAM,cAAc,GAAG,0BAAc,CAAC,KAAK,CAAC;YAC1C,MAAM,EAAE,IAAI,CAAC,EAAE,CAAC,QAAQ,EAAE;YAC1B,YAAY,EAAE,WAAW;YACzB,OAAO,EAAE,SAAS,CAAC,WAAW,EAAE;YAChC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;YAClC,SAAS,EAAE,KAAK,CAAC,SAAS,IAAI,IAAI;SACnC,CAAC,CAAC;QAEH,MAAM,OAAO,GAAG,MAAM,IAAI,CAAC,iBAAiB,CAAC,MAAM,CAAC,cAAc,CAAC,CAAC;QAEpE,MAAM,IAAI,CAAC,sBAAsB,CAAC,GAAG,CAAC,OAAO,CAAC,CAAC;QAE/C,OAAO,IAAA,cAAK,EAAC;YACX,SAAS,EAAE,QAAQ;YACnB,SAAS,EAAE,SAAS,CAAC,WAAW,EAAE;YAClC,IAAI,EAAE,wBAAU,CAAC,YAAY,CAAC,IAAI,CAAC;SACpC,CAAC,CAAC;IACL,CAAC;CACF;AA1FD,wDA0FC",
