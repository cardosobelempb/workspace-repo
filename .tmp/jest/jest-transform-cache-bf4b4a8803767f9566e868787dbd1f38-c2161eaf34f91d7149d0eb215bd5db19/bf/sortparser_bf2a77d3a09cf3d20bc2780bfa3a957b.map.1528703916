{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\sort-parser.ts","mappings":";AAAA,iBAAiB;;;AAOjB,MAAa,UAAU;IACrB,MAAM,CAAC,KAAK,CAAC,IAAa;QACxB,IAAI,CAAC,IAAI,EAAE,CAAC;YACV,OAAO,IAAI,CAAC;QACd,CAAC;QAED,MAAM,CAAC,KAAK,EAAE,SAAS,CAAC,GAAG,IAAI,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC;QAE3C,OAAO;YACL,KAAK;YACL,SAAS,EAAE,SAAS,EAAE,WAAW,EAAE,KAAK,KAAK,CAAC,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,MAAM;SAC/D,CAAC;IACJ,CAAC;CACF;AAbD,gCAaC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\repositories\\pagination\\sort-parser.ts"],"sourcesContent":["// sort-parser.ts\n\nexport interface ParsedSort {\n  field: string;\n  direction: \"asc\" | \"desc\";\n}\n\nexport class SortParser {\n  static parse(sort?: string): ParsedSort | null {\n    if (!sort) {\n      return null;\n    }\n\n    const [field, direction] = sort.split(\",\");\n\n    return {\n      field,\n      direction: direction?.toLowerCase() === \"asc\" ? \"asc\" : \"desc\",\n    };\n  }\n}\n"],"version":3}