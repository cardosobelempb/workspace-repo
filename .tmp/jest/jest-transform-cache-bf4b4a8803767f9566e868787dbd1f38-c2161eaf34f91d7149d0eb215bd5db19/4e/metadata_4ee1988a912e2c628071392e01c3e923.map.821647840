{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\metadata.ts","mappings":";AAAA,yCAAyC;;AAOzC,kDAEC;AAED,kDAEC;AAED,4BAMC;AAED,8BAEC;AAED,kCAcC;AArCD,MAAM,wBAAwB,GAAG,IAAI,OAAO,EAAkB,CAAC;AAC/D,MAAM,cAAc,GAAG,IAAI,OAAO,EAA6B,CAAC;AAEhE,SAAgB,mBAAmB,CAAC,MAAc,EAAE,MAAc;IAChE,wBAAwB,CAAC,GAAG,CAAC,MAAM,EAAE,MAAM,CAAC,CAAC;AAC/C,CAAC;AAED,SAAgB,mBAAmB,CAAC,MAAc;IAChD,OAAO,wBAAwB,CAAC,GAAG,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC;AACpD,CAAC;AAED,SAAgB,QAAQ,CAAC,MAAc,EAAE,KAAsB;IAC7D,MAAM,MAAM,GAAG,cAAc,CAAC,GAAG,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC;IAEhD,MAAM,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IAEnB,cAAc,CAAC,GAAG,CAAC,MAAM,EAAE,MAAM,CAAC,CAAC;AACrC,CAAC;AAED,SAAgB,SAAS,CAAC,MAAc;IACtC,OAAO,cAAc,CAAC,GAAG,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC;AAC1C,CAAC;AAED,SAAgB,WAAW,CACzB,MAAc,EACd,WAAmB,EACnB,MAAgC;IAEhC,MAAM,MAAM,GAAG,SAAS,CAAC,MAAM,CAAC,CAAC;IAEjC,MAAM,KAAK,GAAG,MAAM,CAAC,IAAI,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,WAAW,KAAK,WAAW,CAAC,CAAC;IAEtE,IAAI,CAAC,KAAK,EAAE,CAAC;QACX,MAAM,IAAI,KAAK,CAAC,8CAA8C,WAAW,EAAE,CAAC,CAAC;IAC/E,CAAC;IAED,MAAM,CAAC,MAAM,CAAC,KAAK,EAAE,MAAM,CAAC,CAAC;AAC/B,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\metadata.ts"],"sourcesContent":["// src/shared/http/decorators/metadata.ts\n\nimport { RouteDefinition } from \"./types/types.js\";\n\nconst controllerPrefixMetadata = new WeakMap<object, string>();\nconst routesMetadata = new WeakMap<object, RouteDefinition[]>();\n\nexport function setControllerPrefix(target: object, prefix: string): void {\n  controllerPrefixMetadata.set(target, prefix);\n}\n\nexport function getControllerPrefix(target: object): string {\n  return controllerPrefixMetadata.get(target) ?? \"\";\n}\n\nexport function addRoute(target: object, route: RouteDefinition): void {\n  const routes = routesMetadata.get(target) ?? [];\n\n  routes.push(route);\n\n  routesMetadata.set(target, routes);\n}\n\nexport function getRoutes(target: object): RouteDefinition[] {\n  return routesMetadata.get(target) ?? [];\n}\n\nexport function updateRoute(\n  target: object,\n  handlerName: string,\n  update: Partial<RouteDefinition>,\n): void {\n  const routes = getRoutes(target);\n\n  const route = routes.find((item) => item.handlerName === handlerName);\n\n  if (!route) {\n    throw new Error(`Decorator usado antes de registrar a rota: ${handlerName}`);\n  }\n\n  Object.assign(route, update);\n}\n"],"version":3}