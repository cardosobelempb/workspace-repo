{"version":3,"names":["cov_jd951ju7r","actualCoverage","s","common_1","require","otp_code_entity_1","OtpCodeFactory","build","input","f","OtpCodeEntity","create","email","EmailVO","codeHash","purpose","attempts","maxAttempts","expiredAt","Date","ipAddress","b","IpAddressVO","userAgent","UserAgentVO","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\factories\\otp-code.factory.ts"],"sourcesContent":["import { EmailVO, IpAddressVO, UserAgentVO } from \"@repo/common\";\r\nimport { OtpCodeEntity } from \"../../domain/entities/otp-code.entity\";\r\nimport { OtpCodeCreateDto } from \"../dto\";\r\n\r\nexport class OtpCodeFactory {\r\n  static build(input: OtpCodeCreateDto): OtpCodeEntity {\r\n    return OtpCodeEntity.create({\r\n      email: EmailVO.create(input.email),\r\n      codeHash: input.codeHash,\r\n      purpose: \"authentication\", // You can adjust this as needed\r\n      attempts: 0,\r\n      maxAttempts: 5, // You can adjust this as needed\r\n      expiredAt: new Date(input.expiredAt),\r\n      ipAddress: input.ipAddress ? IpAddressVO.create(input.ipAddress) : null,\r\n      userAgent: input.userAgent ? UserAgentVO.create(input.userAgent) : null,\r\n    });\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IAcM;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AAdN,MAAAC,QAAA;AAAA;AAAA,CAAAH,aAAA,GAAAE,CAAA,OAAAE,OAAA;AACA,MAAAC,iBAAA;AAAA;AAAA,CAAAL,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAGA,MAAaE,cAAc;EACzB,OAAOC,KAAKA,CAACC,KAAuB;IAAA;IAAAR,aAAA,GAAAS,CAAA;IAAAT,aAAA,GAAAE,CAAA;IAClC,OAAOG,iBAAA,CAAAK,aAAa,CAACC,MAAM,CAAC;MAC1BC,KAAK,EAAET,QAAA,CAAAU,OAAO,CAACF,MAAM,CAACH,KAAK,CAACI,KAAK,CAAC;MAClCE,QAAQ,EAAEN,KAAK,CAACM,QAAQ;MACxBC,OAAO,EAAE,gBAAgB;MAAE;MAC3BC,QAAQ,EAAE,CAAC;MACXC,WAAW,EAAE,CAAC;MA