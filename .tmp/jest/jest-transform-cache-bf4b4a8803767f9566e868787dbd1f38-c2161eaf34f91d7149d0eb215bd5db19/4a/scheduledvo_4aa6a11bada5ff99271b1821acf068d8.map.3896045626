{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\scheduling\\scheduled-vo.ts","mappings":";;;AAAA,qFAAgF;AAChF,qDAAiD;AAEjD,IAAI,KAAU,CAAC;AACf,IAAI,CAAC;IACH,KAAK,GAAG,OAAO,CAAC,OAAO,CAAC,CAAC;AAC3B,CAAC;AAAC,MAAM,CAAC;IACP,KAAK,GAAG,IAAI,CAAC;AACf,CAAC;AAED,MAAa,WAAY,SAAQ,8BAAa;IAClC,IAAI,CAAM;IAEpB,YAAY,KAAmC;QAC7C,KAAK,EAAE,CAAC;QAER,2BAA2B;QAC3B,MAAM,MAAM,GAAG,IAAI,CAAC,YAAY,CAAC,KAAK,CAAC,CAAC,CAAC,qCAAqC;QAE9E,wDAAwD;QACxD,MAAM,GAAG,GAAG,KAAK,EAAE,CAAC;QACpB,IAAI,CAAC,IAAI,CAAC,eAAe,CAAC,MAAM,CAAC,OAAO,EAAE,EAAE,GAAG,CAAC,OAAO,EAAE,CAAC,EAAE,CAAC;YAC3D,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,eAAe;gBAC1B,KAAK,EAAE,KAAK,YAAY,IAAI,CAAC,CAAC,CAAC,KAAK,CAAC,WAAW,EAAE,CAAC,CAAC,CAAC,KAAK;gBAC1D,OAAO,EAAE,qEAAqE;aAC/E,CAAC,CAAC;QACL,CAAC;QAED,IAAI,CAAC,IAAI,GAAG,MAAM,CAAC;IACrB,CAAC;IAED,QAAQ;QACN,OAAO,IAAI,CAAC,IAAI,CAAC;IACnB,CAAC;IAED,QAAQ;QACN,OAAO,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,kBAAkB,CAAC,CAAC;IAC9C,CAAC;IAED,OAAO;QACL,MAAM,GAAG,GAAG,KAAK,EAAE,CAAC;QACpB,OAAO,CACL,IAAI,CAAC,IAAI,CAAC,OAAO,EAAE,IAAI,IAAI,CAAC,eAAe,CAAC,IAAI,CAAC,IAAI,CAAC,OAAO,EAAE,EAAE,GAAG,CAAC,OAAO,EAAE,CAAC,CAChF,CAAC;IACJ,CAAC;CACF;AApCD,kCAoCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\scheduling\\scheduled-vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../../errors/controllers/bad-request.error\";\r\nimport { BaseScheduled } from \"./base-scheduled\";\r\n\r\nlet dayjs: any;\r\ntry {\r\n  dayjs = require(\"dayjs\");\r\n} catch {\r\n  dayjs = null;\r\n}\r\n\r\nexport class ScheduledVO extends BaseScheduled {\r\n  protected date: any;\r\n\r\n  constructor(input: string | Date | typeof dayjs) {\r\n    super();\r\n\r\n    // Valida a data de entrada\r\n    const parsed = this.validateDate(input); // Usa a validação da classe abstrata\r\n\r\n    // Verifica se a data está dentro do intervalo permitido\r\n    const now = dayjs();\r\n    if (!this.isValidSchedule(parsed.valueOf(), now.valueOf())) {\r\n      throw new BadRequestError({\r\n        fieldName: \"scheduledDate\",\r\n        value: input instanceof Date ? input.toISOString() : input,\r\n        message: \"Data de agendamento deve ser futura e não mais de um ano no futuro.\",\r\n      });\r\n    }\r\n\r\n    this.date = parsed;\r\n  }\r\n\r\n  getValue(): typeof dayjs {\r\n    return this.date;\r\n  }\r\n\r\n  toString(): string {\r\n    return this.date.format(\"YYYY-MM-DD HH:mm\");\r\n  }\r\n\r\n  isValid(): boolean {\r\n    const now = dayjs();\r\n    return (\r\n      this.date.isValid() && this.isValidSchedule(this.date.valueOf(), now.valueOf())\r\n    );\r\n  }\r\n}\r\n"],"version":3}