{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\number-utils.ts","mappings":";;;AAAA;;;;;GAKG;AACH,MAAa,WAAW;IACtB,gBAAuB,CAAC;IAExB,8EAA8E;IAC9E,mBAAmB;IACnB,8EAA8E;IAE9E,gFAAgF;IACxE,MAAM,CAAC,aAAa,CAAC,KAAU;QACrC,OAAO,OAAO,KAAK,KAAK,QAAQ,IAAI,MAAM,CAAC,QAAQ,CAAC,KAAK,CAAC,CAAC;IAC7D,CAAC;IAED,sEAAsE;IAC9D,MAAM,CAAC,YAAY,CAAC,KAAU;QACpC,OAAO,IAAI,CAAC,aAAa,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC;IAC/C,CAAC;IAED,8EAA8E;IAC9E,aAAa;IACb,8EAA8E;IAE9E;;;OAGG;IACH,MAAM,CAAC,uBAAuB,CAAC,GAAW;QACxC,GAAG,GAAG,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,CAAC;QAC7B,OAAO,GAAG,CAAC,OAAO,CAAC,CAAC,CAAC,CAAC;IACxB,CAAC;IAED;;;;OAIG;IACH,MAAM,CAAC,cAAc,CACnB,GAAW,EACX,SAAiB,OAAO,EACxB,WAAmB,KAAK;QAExB,GAAG,GAAG,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,CAAC;QAE7B,OAAO,IAAI,IAAI,CAAC,YAAY,CAAC,MAAM,EAAE;YACnC,KAAK,EAAE,UAAU;YACjB,QAAQ;YACR,qBAAqB,EAAE,CAAC;YACxB,qBAAqB,EAAE,CAAC;SACzB,CAAC,CAAC,MAAM,CAAC,GAAG,CAAC,CAAC;IACjB,CAAC;IAED;;;OAGG;IACH,MAAM,CAAC,aAAa,CAAC,GAAW;QAC9B,IAAI,CAAC,GAAG;YAAE,OAAO,CAAC,CAAC;QAEnB,MAAM,OAAO,GAAG,GAAG;aAChB,OAAO,CAAC,UAAU,EAAE,EAAE,CAAC,CAAC,yBAAyB;aACjD,OAAO,CAAC,eAAe,EAAE,EAAE,CAAC,CAAC,+BAA+B;aAC5D,OAAO,CAAC,GAAG,EAAE,GAAG,CAAC,CAAC,CAAC,sCAAsC;QAE5D,MAAM,GAAG,GAAG,UAAU,CAAC,OAAO,CAAC,CAAC;QAChC,OAAO,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,CAAC;IAChC,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,gBAAgB,CAAC,GAAW;QACjC,GAAG,GAAG,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,CAAC;QAC7B,OAAO,GAAG,CAAC,GAAG,GAAG,GAAG,CAAC,CAAC,OAAO,CAAC,CAAC,CAAC,GAAG,CAAC;IACtC,CAAC;IAED,8EAA8E;IAC9E,uBAAuB;IACvB,8EAA8E;IAE9E;;OAEG;IACH,MAAM,CAAC,oBAAoB,CAAC,GAAW,EAAE,aAAqB;QAC5D,GAAG,GAAG,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,CAAC;QAC7B,aAAa,GAAG,IAAI,CAAC,GAAG,CAAC,CAAC,EAAE,aAAa,CAAC,CAAC;QAE3C,MAAM,MAAM,GAAG,IAAI,CAAC,GAAG,CAAC,EAAE,EAAE,aAAa,CAAC,CAAC;QAC3C,OAAO,IAAI,CAAC,KAAK,CAAC,GAAG,GAAG,MAAM,CAAC,GAAG,MAAM,CAAC;IAC3C,CAAC;IAED;;OAEG;IACH,MAAM,CAAC,YAAY,CAAC,MAAc,EAAE,OAAe;QACjD,MAAM,GAAG,IAAI,CAAC,YAAY,CAAC,MAAM,CAAC,CAAC;QACnC,OAAO,GAAG,IAAI,CAAC,YAAY,CAAC,OAAO,CAAC,CAAC;QAErC,OAAO,CAAC,MAAM,GAAG,OAAO,CAAC,GAAG,GAAG,CAAC;IAClC,CAAC;IAED,8EAA8E;IAC9E,aAAa;IACb,8EAA8E;IAE9E,MAAM,CAAC,UAAU,CAAC,GAAW;QAC3B,OAAO,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC;IACpC,CAAC;IAED,MAAM,CAAC,UAAU,CAAC,GAAW;QAC3B,OAAO,IAAI,CAAC,YAAY,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC;IACpC,CAAC;IAED,MAAM,CAAC,SAAS,CAAC,GAAW;QAC1B,OAAO,MAAM,CAAC,SAAS,CAAC,GAAG,CAAC,CAAC;IAC/B,CAAC;IAED,8EAA8E;IAC9E,wBAAwB;IACxB,8EAA8E;IAE9E;;;OAGG;IACH,MAAM,CAAC,iBAAiB,CAAC,KAAa;QACpC,IAAI,CAAC,KAAK;YAAE,OAAO,EAAE,CAAC;QAEtB,MAAM,MAAM,GAAG,KAAK,CAAC,OAAO,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC;QACxC,MAAM,KAAK,GAAG,MAAM,CAAC,KAAK,CAAC,yBAAyB,CAAC,CAAC;QAEtD,OAAO,KAAK,CAAC,CAAC,CAAC,IAAI,KAAK,CAAC,CAAC,CAAC,KAAK,KAAK,CAAC,CAAC,CAAC,IAAI,KAAK,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,KAAK,CAAC;IACjE,CAAC;CACF;AAnID,kCAmIC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\utils\\number-utils.ts"],"sourcesContent":["/**\n * Utilitário para manipulação e formatação de números.\n * - Seguro\n * - Reutilizável\n * - Coberto contra edge-cases\n */\nexport class NumberUtils {\n  private constructor() {}\n\n  // ---------------------------------------------------------------------------\n  // Helpers internos\n  // ---------------------------------------------------------------------------\n\n  /** Verifica se um valor é um número finito (proteção contra NaN e Infinity). */\n  private static isValidNumber(value: any): value is number {\n    return typeof value === \"number\" && Number.isFinite(value);\n  }\n\n  /** Garante que um número inválido se torne zero (fallback seguro). */\n  private static ensureNumber(value: any): number {\n    return this.isValidNumber(value) ? value : 0;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Formatação\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Formata para sempre ter duas casas decimais.\n   * - Usa `toFixed(2)` para evitar inconsistências.\n   */\n  static formatNumberWithDecimal(num: number): string {\n    num = this.ensureNumber(num);\n    return num.toFixed(2);\n  }\n\n  /**\n   * Formata um número como moeda usando `Intl.NumberFormat`.\n   * - Locale automático\n   * - Currency dinâmica\n   */\n  static formatCurrency(\n    num: number,\n    locale: string = \"pt-BR\",\n    currency: string = \"BRL\",\n  ): string {\n    num = this.ensureNumber(num);\n\n    return new Intl.NumberFormat(locale, {\n      style: \"currency\",\n      currency,\n      minimumFractionDigits: 2,\n      maximumFractionDigits: 2,\n    }).format(num);\n  }\n\n  /**\n   * Converte uma string de moeda para número.\n   * Ex: \"R$ 1.234,56\" → 1234.56\n   */\n  static parseCurrency(str: string): number {\n    if (!str) return 0;\n\n    const cleaned = str\n      .replace(/[^\\d,-]/g, \"\") // remove letras/símbolos\n      .replace(/\\.(?=\\d{3,})/g, \"\") // remove separadores de milhar\n      .replace(\",\", \".\"); // transforma decimal BR em decimal US\n\n    const num = parseFloat(cleaned);\n    return this.ensureNumber(num);\n  }\n\n  /**\n   * Formata para percentual com 2 casas: 0.123 → \"12.30%\"\n   */\n  static formatPercentage(num: number): string {\n    num = this.ensureNumber(num);\n    return `${(num * 100).toFixed(2)}%`;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Manipulação numérica\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Arredonda para N casas decimais.\n   */\n  static roundToDecimalPlaces(num: number, decimalPlaces: number): number {\n    num = this.ensureNumber(num);\n    decimalPlaces = Math.max(0, decimalPlaces);\n\n    const factor = Math.pow(10, decimalPlaces);\n    return Math.round(num * factor) / factor;\n  }\n\n  /**\n   * Calcula imposto: Ex: (100, 15) → 15\n   */\n  static calculateTax(amount: number, taxRate: number): number {\n    amount = this.ensureNumber(amount);\n    taxRate = this.ensureNumber(taxRate);\n\n    return (amount * taxRate) / 100;\n  }\n\n  // ---------------------------------------------------------------------------\n  // Validações\n  // ---------------------------------------------------------------------------\n\n  static isPositive(num: number): boolean {\n    return this.ensureNumber(num) > 0;\n  }\n\n  static isNegative(num: number): boolean {\n    return this.ensureNumber(num) < 0;\n  }\n\n  static isInteger(num: number): boolean {\n    return Number.isInteger(num);\n  }\n\n  // ---------------------------------------------------------------------------\n  // Formatação específica\n  // ---------------------------------------------------------------------------\n\n  /**\n   * Formata um telefone brasileiro no padrão:\n   * \"11987654321\" → \"(11) 98765-4321\"\n   */\n  static formatPhoneNumber(phone: string): string {\n    if (!phone) return \"\";\n\n    const digits = phone.replace(/\\D/g, \"\");\n    const match = digits.match(/^(\\d{2})(\\d{5})(\\d{4})$/);\n\n    return match ? `(${match[1]}) ${match[2]}-${match[3]}` : phone;\n  }\n}\n"],"version":3}