{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\logger.factory.ts","mappings":";;;AAAA,8DAA0D;AAC1D,wDAAoD;AAGpD,+DAA+D;AAC/D,4BAA4B;AAC5B,EAAE;AACF,0BAA0B;AAC1B,+BAA+B;AAC/B,sBAAsB;AACtB,+DAA+D;AAE/D,MAAa,aAAa;IACxB,MAAM,CAAC,MAAM,CAAC,OAAgB;QAC5B,MAAM,YAAY,GAAG,OAAO,CAAC,GAAG,CAAC,QAAQ,KAAK,YAAY,CAAC;QAE3D,IAAI,YAAY,EAAE,CAAC;YACjB,OAAO,IAAI,wBAAU,CAAC;gBACpB,OAAO;aACR,CAAC,CAAC;QACL,CAAC;QAED,OAAO,IAAI,8BAAa,CAAC;YACvB,OAAO;SACR,CAAC,CAAC;IACL,CAAC;CACF;AAdD,sCAcC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\observability\\logger.factory.ts"],"sourcesContent":["import { ConsoleLogger } from \"./adapters/console.logger\";\r\nimport { PinoLogger } from \"./adapters/pino.logger\";\r\nimport { BaseLogger } from \"./base-logger\";\r\n\r\n// ============================================================\r\n// Factory central do Logger\r\n//\r\n// Decide automaticamente:\r\n// - DEV -> Console/Pino Pretty\r\n// - PROD -> Pino JSON\r\n// ============================================================\r\n\r\nexport class LoggerFactory {\r\n  static create(context?: string): BaseLogger {\r\n    const isProduction = process.env.NODE_ENV === \"production\";\r\n\r\n    if (isProduction) {\r\n      return new PinoLogger({\r\n        context,\r\n      });\r\n    }\r\n\r\n    return new ConsoleLogger({\r\n      context,\r\n    });\r\n  }\r\n}\r\n"],"version":3}