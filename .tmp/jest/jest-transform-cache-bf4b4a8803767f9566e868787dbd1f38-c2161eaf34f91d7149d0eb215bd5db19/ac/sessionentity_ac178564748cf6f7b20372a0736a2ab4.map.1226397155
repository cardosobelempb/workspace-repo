{"version":3,"names":["cov_2b6q8apkao","actualCoverage","s","common_1","require","SessionEntity","BaseEntity","userId","f","props","expires","sessionToken","ipAddress","userAgent","createdAt","updatedAt","deletedAt","isExpired","Date","revoke","now","touch","create","id","b","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\domain\\entities\\session.entity.ts"],"sourcesContent":["import { BaseEntity, Optional, UUIDVO } from \"@repo/common\";\r\n\r\nexport interface SessionProps {\r\n  userId: UUIDVO;\r\n  sessionToken: string;\r\n  expires: Date;\r\n  ipAddress: string | null;\r\n  userAgent: string | null;\r\n  createdAt: Date;\r\n  updatedAt: Date | null;\r\n  deletedAt: Date | null;\r\n}\r\n\r\nexport class SessionEntity extends BaseEntity<SessionProps> {\r\n  get userId() {\r\n    return this.props.userId;\r\n  }\r\n  get expires() {\r\n    return this.props.expires;\r\n  }\r\n\r\n  get sessionToken() {\r\n    return this.props.sessionToken;\r\n  }\r\n\r\n  get ipAddress() {\r\n    return this.props.ipAddress;\r\n  }\r\n\r\n  get userAgent() {\r\n    return this.props.userAgent;\r\n  }\r\n  get createdAt() {\r\n    return this.props.createdAt;\r\n  }\r\n  get updatedAt() {\r\n    return this.props.updatedAt;\r\n  }\r\n  get deletedAt() {\r\n    return this.props.deletedAt;\r\n  }\r\n\r\n  isExpired(): boolean {\r\n    return new Date() > this.props.expires;\r\n  }\r\n\r\n  revoke(): void {\r\n    this.props.expires = new Date(Date.now() - 1000);\r\n    this.touch();\r\n  }\r\n\r\n  private touch(): void {\r\n    this.props.updatedAt = new Date();\r\n  }\r\n\r\n  static create(\r\n    props: Optional<\r\n      SessionProps,\r\n      \"ipAddress\" | \"userAgent\" | \"createdAt\" | \"updatedAt\" | \"deletedAt\"\r\n    >,\r\n    id?: UUIDVO,\r\n  ) {\r\n    return new SessionEntity(\r\n      {\r\n        ...props,\r\n        ipAddress: props.ipAddress ?? null,\r\n        userAgent: props.userAgent ?? null,\r\n        createdAt: props.createdAt ?? new Date(),\r\n        updatedAt: props.updatedAt ?? null,\r\n        deletedAt: props.deletedAt ?? null,\r\n      },\r\n      id,\r\n    );\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IA0BI;IAAAA,cAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,cAAA;AAAAA,cAAA,GAAAE,CAAA;;;;;;;AA1BJ,MAAAC,QAAA;AAAA;AAAA,CAAAH,cAAA,GAAAE,CAAA,OAAAE,OAAA;AAaA,MAAaC,aAAc;AAAA;AAAA,CAAQF,QAAA,CAAAG,UAAwB;EACzD,IAAIC,MAAMA,CAAA;IAAA;IAAAP,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACR,OAAO,IAAI,CAACO,KAAK,CAACF,MAAM;EAC1B;EACA,IAAIG,OAAOA,CAAA;IAAA;IAAAV,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACT,OAAO,IAAI,CAACO,KAAK,CAACC,OAAO;EAC3B;EAEA,IAAIC,YAAYA,CAAA;IAAA;IAAAX,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACd,OAAO,IAAI,CAACO,KAAK,CAACE,YAAY;EAChC;EAEA,IAAIC,SAASA,CAAA;IAAA;IAAAZ,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACG,SAAS;EAC7B;EAEA,IAAIC,SAASA,CAAA;IAAA;IAAAb,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACI,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAd,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACK,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAf,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACM,SAAS;EAC7B;EACA,IAAIC,SAASA,CAAA;IAAA;IAAAhB,cAAA,GAAAQ,CAAA;IAAAR,cAAA,GAAAE,CAAA;IACX,OAAO,IAAI,CAACO,KAAK,CAACO,S