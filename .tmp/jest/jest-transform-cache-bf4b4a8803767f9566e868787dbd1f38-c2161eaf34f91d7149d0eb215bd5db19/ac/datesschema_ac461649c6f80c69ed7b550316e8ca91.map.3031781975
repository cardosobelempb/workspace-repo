{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\dates.schema.ts","mappings":";;;AAAA,6BAAwB;AAExB,gEAAgE;AAChE,0DAA0D;AAC1D,sDAAsD;AACtD,gEAAgE;AAEhE,oDAAoD;AACvC,QAAA,UAAU,GAAG,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC;AAE1C,gEAAgE;AAChE,iCAAiC;AACjC,gEAAgE;AACnD,QAAA,eAAe,GAAG,OAAC;KAC7B,MAAM,CAAC;IACN,2CAA2C;IAC3C,WAAW,EAAE,OAAC,CAAC,MAAM;SAClB,IAAI,EAAE;SACN,GAAG,CAAC,IAAI,IAAI,EAAE,EAAE,EAAE,OAAO,EAAE,4BAA4B,EAAE,CAAC;IAE7D,6CAA6C;IAC7C,SAAS,EAAE,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC,GAAG,CAAC,IAAI,IAAI,CAAC,IAAI,CAAC,GAAG,EAAE,GAAG,GAAG,GAAG,EAAE,GAAG,EAAE,GAAG,EAAE,GAAG,IAAI,CAAC,EAAE;QAC/E,OAAO,EAAE,oCAAoC;KAC9C,CAAC;IAEF,oCAAoC;IACpC,SAAS,EAAE,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE;IAC1B,OAAO,EAAE,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE;CACzB,CAAC;KACD,MAAM;AACL,iEAAiE;AACjE,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,OAAO,GAAG,IAAI,CAAC,SAAS,EACvC;IACE,OAAO,EAAE,mCAAmC;IAC5C,IAAI,EAAE,CAAC,SAAS,CAAC,EAAE,qCAAqC;CACzD,CACF,CAAC;AAEJ,gEAAgE;AAChE,gEAAgE;AAChE,gEAAgE;AACnD,QAAA,eAAe,GAAG,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC,MAAM,CACnD,CAAC,IAAI,EAAE,EAAE;IACP,MAAM,KAAK,GAAG,IAAI,IAAI,EAAE,CAAC;IACzB,MAAM,UAAU,GAAG,IAAI,IAAI,CACzB,KAAK,CAAC,WAAW,EAAE,GAAG,EAAE,EACxB,KAAK,CAAC,QAAQ,EAAE,EAChB,KAAK,CAAC,OAAO,EAAE,CAChB,CAAC;IACF,OAAO,IAAI,IAAI,UAAU,CAAC;AAC5B,CAAC,EACD,EAAE,OAAO,EAAE,+BAA+B,EAAE,CAC7C,CAAC;AAEF,gEAAgE;AAChE,wDAAwD;AACxD,gEAAgE;AACnD,QAAA,YAAY,GAAG,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC,QAAQ,EAAE,CAAC,CAAC,2BAA2B;AACtE,QAAA,YAAY,GAAG,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC,QAAQ,EAAE,CAAC,CAAC,iBAAiB;AAC5D,QAAA,WAAW,GAAG,OAAC,CAAC,MAAM,CAAC,IAAI,EAAE,CAAC,OAAO,EAAE,CAAC,CAAC,wBAAwB;AAI9E,gEAAgE;AAChE,mBAAmB;AACnB,gEAAgE;AAEhE,eAAe;AACf,0CAA0C;AAC1C,+BAA+B;AAC/B,6BAA6B;AAC7B,6BAA6B;AAC7B,2BAA2B;AAC3B,MAAM;AAEN,WAAW;AACX,gEAAgE","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\dates.schema.ts"],"sourcesContent":["import { z } from \"zod\";\r\n\r\n// ─────────────────────────────────────────────────────────────\r\n// ⚠️ COMMON MISTAKE: z.date() does NOT accept ISO strings\r\n// APIs and databases return strings, not Date objects\r\n// ─────────────────────────────────────────────────────────────\r\n\r\n// ✅ Correct — coerce automatically converts to Date\r\nexport const DateSchema = z.coerce.date();\r\n\r\n// ─────────────────────────────────────────────────────────────\r\n// 📅 Practical range validations\r\n// ─────────────────────────────────────────────────────────────\r\nexport const DateRangeSchema = z\r\n  .object({\r\n    // Minimum date: does not accept past dates\r\n    scheduledAt: z.coerce\r\n      .date()\r\n      .min(new Date(), { message: \"Date cannot be in the past\" }),\r\n\r\n    // Maximum date: at most 1 year in the future\r\n    expiresAt: z.coerce.date().max(new Date(Date.now() + 365 * 24 * 60 * 60 * 1000), {\r\n      message: \"Date cannot exceed 1 year from now\",\r\n    }),\r\n\r\n    // Cross-field date range validation\r\n    startDate: z.coerce.date(),\r\n    endDate: z.coerce.date(),\r\n  })\r\n  .refine(\r\n    // ✅ refine: cross-field validation between startDate and endDate\r\n    (data) => data.endDate > data.startDate,\r\n    {\r\n      message: \"End date must be after start date\",\r\n      path: [\"endDate\"], // points to the field with the error\r\n    },\r\n  );\r\n\r\n// ─────────────────────────────────────────────────────────────\r\n// 🎂 Minimum age validation — very common in registration forms\r\n// ─────────────────────────────────────────────────────────────\r\nexport const BirthDateSchema = z.coerce.date().refine(\r\n  (date) => {\r\n    const today = new Date();\r\n    const minAgeDate = new Date(\r\n      today.getFullYear() - 18,\r\n      today.getMonth(),\r\n      today.getDate(),\r\n    );\r\n    return date <= minAgeDate;\r\n  },\r\n  { message: \"Must be at least 18 years old\" },\r\n);\r\n\r\n// ─────────────────────────────────────────────────────────────\r\n// 🔁 Reusable date utilities for Prisma nullable fields\r\n// ─────────────────────────────────────────────────────────────\r\nexport const NullableDate = z.coerce.date().nullable(); // mirrors Prisma \"?\" field\r\nexport const OptionalDate = z.coerce.date().optional(); // API input body\r\nexport const NullishDate = z.coerce.date().nullish(); // PATCH partial updates\r\n\r\nexport type DateRangeInput = z.infer<typeof DateRangeSchema>;\r\n\r\n// ─────────────────────────────────────────────────────────────\r\n// ✅ Usage examples\r\n// ─────────────────────────────────────────────────────────────\r\n\r\n// Booking form\r\n// const booking = DateRangeSchema.parse({\r\n//   scheduledAt: \"2026-06-01\",\r\n//   expiresAt: \"2026-12-31\",\r\n//   startDate: \"2026-06-01\",\r\n//   endDate: \"2026-06-10\",\r\n// });\r\n\r\n// Age gate\r\n// const dob = BirthDateSchema.parse(\"1990-05-15\"); // ✅ over 18\r\n"],"version":3}