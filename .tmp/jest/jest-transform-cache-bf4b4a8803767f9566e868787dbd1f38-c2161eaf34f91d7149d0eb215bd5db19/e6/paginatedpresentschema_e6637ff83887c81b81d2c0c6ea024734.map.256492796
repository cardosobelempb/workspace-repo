{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\paginated-present.schema.ts","mappings":";;;;;;AAAA,8CAAoB;AACpB,uDAAmD;AACnD,+CAA2C;AAE3C;;;GAGG;AACU,QAAA,gBAAgB,GAAG,aAAC,CAAC,MAAM,CAAC;IACvC,OAAO,EAAE,aAAC,CAAC,KAAK,CAAC,aAAC,CAAC,GAAG,EAAE,CAAC;IAEzB,QAAQ,EAAE,gCAAc;IAExB,IAAI,EAAE,aAAC,CAAC,OAAO,EAAE;IACjB,UAAU,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;IACnC,aAAa,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;IAEtC,IAAI,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;IAC7B,MAAM,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;IAE/B,IAAI,EAAE,wBAAU;IAEhB,KAAK,EAAE,aAAC,CAAC,OAAO,EAAE;IAClB,gBAAgB,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC;IACzC,KAAK,EAAE,aAAC,CAAC,OAAO,EAAE;CACnB,CAAC,CAAC;AAEU,QAAA,sBAAsB,GAAG;IACpC,GAAG,EAAE,wBAAgB;IACrB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,wBAAwB;IACxB,4BAA4B;CACpB,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\paginated-present.schema.ts"],"sourcesContent":["import z from \"zod\";\nimport { PageableSchema } from \"./pageable.schema\";\nimport { SortSchema } from \"./sort.schema\";\n\n/**\n * Generic paginated response schema\n * Use .extend() or replace `z.any()` for strong typing of content\n */\nexport const PaginatedPresent = z.object({\n  content: z.array(z.any()),\n\n  pageable: PageableSchema,\n\n  last: z.boolean(),\n  totalPages: z.number().int().min(0),\n  totalElements: z.number().int().min(0),\n\n  size: z.number().int().min(1),\n  number: z.number().int().min(0),\n\n  sort: SortSchema,\n\n  first: z.boolean(),\n  numberOfElements: z.number().int().min(0),\n  empty: z.boolean(),\n});\n\nexport const PaginatedPresentSchema = {\n  200: PaginatedPresent,\n  // 404: HttpErrorSchema,\n  // 409: HttpErrorSchema,\n  // 422: HttpErrorSchema,\n  // 500: HttpErrorSchema,\n  // default: HttpErrorSchema,\n} as const;\n\nexport type SortDto = z.infer<typeof SortSchema>;\nexport type PageableDto = z.infer<typeof PageableSchema>;\nexport type PaginatedResponseDto = z.infer<typeof PaginatedPresentSchema>;\n"],"version":3}