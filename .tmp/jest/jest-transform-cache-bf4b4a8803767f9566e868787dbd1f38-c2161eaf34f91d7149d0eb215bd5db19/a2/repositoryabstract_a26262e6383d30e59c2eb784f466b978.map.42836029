{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\repositories\\repository.abstract.ts","mappings":";;;AAEA,MAAsB,kBAAkB;CAMvC;AAND,gDAMC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\infrastructure\\repositories\\repository.abstract.ts"],"sourcesContent":["import { BasePagination } from \"./base-paginated\";\n\nexport abstract class RepositoryAbstract<T> {\n  abstract findById(id: string): Promise<T | null>;\n  abstract findAll(params: BasePagination): Promise<T[]>;\n  abstract create(entity: T): Promise<void>;\n  abstract update(entity: T): Promise<void>;\n  abstract delete(entity: T): Promise<void>;\n}\n"],"version":3}