{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\usecases\\already-exists.error.ts","mappings":";;;AAAA,sDAAkD;AAGlD,MAAa,kBAAmB,SAAQ,8BAAa;IACnD,YAAY,MAA+D;QACzE,KAAK,CAAC;YACJ,UAAU,EAAE,GAAG;YACf,IAAI,EAAE,gBAAgB;YACtB,KAAK,EAAE,UAAU;YACjB,OAAO,EAAE,MAAM,CAAC,OAAO,IAAI,GAAG,MAAM,CAAC,SAAS,KAAK,MAAM,CAAC,KAAK,aAAa;YAC5E,SAAS,EAAE,MAAM,CAAC,SAAS;SAC5B,CAAC,CAAC;IACL,CAAC;CACF;AAVD,gDAUC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\usecases\\already-exists.error.ts"],"sourcesContent":["import { StandardError } from \"../standard.error\";\nimport { BaseUseCaseError } from \"./base-usecase.error\";\n\nexport class AlreadyExistsError extends StandardError implements BaseUseCaseError {\n  constructor(params: { fieldName: string; value?: string; message?: string }) {\n    super({\n      statusCode: 409,\n      code: \"ALREADY_EXISTS\",\n      error: \"Conflict\",\n      message: params.message ?? `${params.fieldName} \"${params.value}\" já existe`,\n      fieldName: params.fieldName,\n    });\n  }\n}\n"],"version":3}