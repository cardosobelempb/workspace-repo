{"version":3,"names":["cov_ld87qirgf","actualCoverage","s","exports","AUTH_DI_TOKENS","PRISMA_CLIENT","USER_REPOSITORY","SESSION_REPOSITORY","SESSION_CACHE_REPOSITORY","OTP_REPOSITORY","MAGIC_LINK_REPOSITORY","EMAIL_VERIFICATION_REPOSITORY","ACCOUNT_REPOSITORY","AUDIT_LOG_REPOSITORY","PASSWORD_HASHER","PASSWORD_COMPARER","SESSION_TOKEN_SERVICE","OPAQUE_TOKEN_GENERATOR","HASH_GENERATOR","REGISTER_USE_CASE","CREATE_SESSION_USE_CASE","RESOLVE_SESSION_USE_CASE","REFRESH_SESSION_USE_CASE","LOGOUT_USE_CASE","REVOKE_ALL_SESSIONS_USE_CASE","REGISTER_CONTROLLER","LOGIN_CONTROLLER","LOGOUT_CONTROLLER","ME_CONTROLLER","REFRESH_SESSION_CONTROLLER"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\constants\\auth-di-tokens.ts"],"sourcesContent":["/**\r\n * Tokens oficiais de DI do módulo Authentication V2.\r\n *\r\n * Use estes tokens em vez de classes concretas para manter o domínio desacoplado\r\n * e permitir trocar providers sem alterar use cases/controllers.\r\n */\r\nexport const AUTH_DI_TOKENS = {\r\n  // Prisma / Database\r\n  PRISMA_CLIENT: \"AUTH.PRISMA_CLIENT\",\r\n\r\n  // Repositories\r\n  USER_REPOSITORY: \"AUTH.USER_REPOSITORY\",\r\n  SESSION_REPOSITORY: \"AUTH.SESSION_REPOSITORY\",\r\n  SESSION_CACHE_REPOSITORY: \"AUTH.SESSION_CACHE_REPOSITORY\",\r\n  OTP_REPOSITORY: \"AUTH.OTP_REPOSITORY\",\r\n  MAGIC_LINK_REPOSITORY: \"AUTH.MAGIC_LINK_REPOSITORY\",\r\n  EMAIL_VERIFICATION_REPOSITORY: \"AUTH.EMAIL_VERIFICATION_REPOSITORY\",\r\n  ACCOUNT_REPOSITORY: \"AUTH.ACCOUNT_REPOSITORY\",\r\n  AUDIT_LOG_REPOSITORY: \"AUTH.AUDIT_LOG_REPOSITORY\",\r\n\r\n  // Crypto / Tokens\r\n  PASSWORD_HASHER: \"AUTH.PASSWORD_HASHER\",\r\n  PASSWORD_COMPARER: \"AUTH.PASSWORD_COMPARER\",\r\n  SESSION_TOKEN_SERVICE: \"AUTH.SESSION_TOKEN_SERVICE\",\r\n  OPAQUE_TOKEN_GENERATOR: \"AUTH.OPAQUE_TOKEN_GENERATOR\",\r\n  HASH_GENERATOR: \"AUTH.HASH_GENERATOR\",\r\n\r\n  // Use Cases\r\n  REGISTER_USE_CASE: \"AUTH.REGISTER_USE_CASE\",\r\n  CREATE_SESSION_USE_CASE: \"AUTH.CREATE_SESSION_USE_CASE\",\r\n  RESOLVE_SESSION_USE_CASE: \"AUTH.RESOLVE_SESSION_USE_CASE\",\r\n  REFRESH_SESSION_USE_CASE: \"AUTH.REFRESH_SESSION_USE_CASE\",\r\n  LOGOUT_USE_CASE: \"AUTH.LOGOUT_USE_CASE\",\r\n  REVOKE_ALL_SESSIONS_USE_CASE: \"AUTH.REVOKE_ALL_SESSIONS_USE_CASE\",\r\n\r\n  // Controllers\r\n  REGISTER_CONTROLLER: \"AUTH.REGISTER_CONTROLLER\",\r\n  LOGIN_CONTROLLER: \"AUTH.LOGIN_CONTROLLER\",\r\n  LOGOUT_CONTROLLER: \"AUTH.LOGOUT_CONTROLLER\",\r\n  ME_CONTROLLER: \"AUTH.ME_CONTROLLER\",\r\n  REFRESH_SESSION_CONTROLLER: \"AUTH.REFRESH_SESSION_CONTROLLER\",\r\n} as const;\r\n\r\nexport type AuthDiToken = (typeof AUTH_DI_TOKENS)[keyof typeof AUTH_DI_TOKENS];\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IAaE;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AAbF;;;;;;AAAA;AAAAF,aAAA,GAAAE,CAAA;AAMaC,OAAA,CAAAC,cAAc,GAAG;EAC5B;EACAC,aAAa,EAAE,oBAAoB;EAEnC;EACAC,eAAe,EAAE,sBAAsB;EACvCC,kBAAkB,EAAE,yBAAyB;EAC7CC,wBAAwB,EAAE,+BAA+B;EACzDC,cAAc,EAAE,qBAAqB;EACrCC,qBAAqB,EAAE,4BAA4B;EACnDC,6BAA6B,EAAE,oCAAoC;EACnEC,kBAAkB,EAAE,yBAAyB;EAC7CC,oBAAoB,EAAE,2BAA2B;EAEjD;EACAC,eAAe,EAAE,sBAAsB;EACvCC,iBAAiB,EAAE,wBAAwB;EAC3CC,qBAAqB,EAAE,4BAA4B;EACnDC,sBAAsB,EAAE,6BAA6B;EACrDC,cAAc,EAAE,qBAAqB;EAErC;EACAC,iBAAiB,EAAE,wBAAwB;EAC3CC,uBAAuB,EAAE,8BAA8B;EACvDC,wBAAwB,EAAE,+BAA+B;EACzDC,wBAAwB,EAAE,+BAA+B;EACzDC,eAAe,EAAE,sBAAsB;EACvCC,4BAA4B,EAAE,mCAAmC;EAEjE;EACAC,mBAAmB,EAAE,0BAA0B;EAC/CC,gBAAgB,EAAE,uBAAuB;EACzCC,iBAAiB,EAAE,wBAAwB;EAC3CC,aAAa,EAAE,oBAAoB;EACnCC,0BAA0B,EAAE;CACpB","ignoreList":[]}