{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\location\\longitude.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC,MAAa,WAAY,SAAQ,gBAAc;IAC1B,KAAK,CAAS;IAEjC,YAAY,KAAa;QACvB,KAAK,CAAC,KAAK,CAAC,CAAC;QACb,IAAI,CAAC,WAAW,CAAC,OAAO,CAAC,KAAK,CAAC,EAAE,CAAC;YAChC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,iDAAiD;aAC3D,CAAC,CAAC;QACL,CAAC;QACD,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;IACrB,CAAC;IAEM,MAAM,CAAC,OAAO,CAAC,KAAa;QACjC,OAAO,KAAK,IAAI,CAAC,GAAG,IAAI,KAAK,IAAI,GAAG,CAAC;IACvC,CAAC;IAEM,OAAO;QACZ,OAAO,WAAW,CAAC,OAAO,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACzC,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC,QAAQ,EAAE,CAAC;IAC/B,CAAC;IAED,oCAAoC;IAC7B,MAAM,CAAC,KAAkB;QAC9B,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,KAAK,CAAC;IACpC,CAAC;CACF;AA9BD,kCA8BC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\location\\longitude.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\nimport { BaseVO } from \"../base.vo\";\n\nexport class LongitudeVO extends BaseVO<number> {\n  protected readonly value: number;\n\n  constructor(value: number) {\n    super(value);\n    if (!LongitudeVO.isValid(value)) {\n      throw new BadRequestError({\n        fieldName: \"longitude\",\n        message: \"Longitude must be a number between -180 and 180\",\n      });\n    }\n    this.value = value;\n  }\n\n  public static isValid(value: number): boolean {\n    return value >= -180 && value <= 180;\n  }\n\n  public isValid(): boolean {\n    return LongitudeVO.isValid(this.value);\n  }\n\n  public toString(): string {\n    return this.value.toString();\n  }\n\n  /** Compara com outro LongitudeVO */\n  public equals(other: LongitudeVO): boolean {\n    return this.value === other.value;\n  }\n}\n"],"version":3}