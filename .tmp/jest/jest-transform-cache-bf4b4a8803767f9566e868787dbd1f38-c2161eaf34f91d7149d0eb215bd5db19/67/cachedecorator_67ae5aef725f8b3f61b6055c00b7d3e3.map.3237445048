{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\cache.decorator.ts","mappings":";AAAA,gDAAgD;;AAUhD,sBAQC;AAhBD,yCAAyC;AAEzC;;;;;GAKG;AACH,SAAgB,KAAK,CAAC,GAAW;IAC/B,OAAO,UAAU,MAAc,EAAE,WAA4B;QAC3D,IAAA,sBAAW,EAAC,MAAM,CAAC,WAAW,EAAE,MAAM,CAAC,WAAW,CAAC,EAAE;YACnD,KAAK,EAAE;gBACL,GAAG;aACJ;SACF,CAAC,CAAC;IACL,CAAC,CAAC;AACJ,CAAC;AAED;;;;;;;;;GASG","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\cache.decorator.ts"],"sourcesContent":["// src/shared/http/decorators/cache.decorator.ts\n\nimport { updateRoute } from \"./metadata\";\n\n/**\n * Define cache em segundos para uma rota.\n *\n * Exemplo:\n * @Cache(60)\n */\nexport function Cache(ttl: number) {\n  return function (target: object, propertyKey: string | symbol): void {\n    updateRoute(target.constructor, String(propertyKey), {\n      cache: {\n        ttl,\n      },\n    });\n  };\n}\n\n/**\n * Define que a rota é pública, ou seja, não requer autenticação.\n *\n * Exemplo:\n * @Get(\"/\")\n * @Cache(60)\n * async listUsers() {\n * return this.usersService.findAll();\n * }\n */\n"],"version":3}