{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\standard.error.ts","mappings":";;;AAAA,MAAa,aAAc,SAAQ,KAAK;IAC7B,SAAS,CAAO;IAChB,UAAU,CAAS;IACnB,IAAI,CAAU;IACd,KAAK,CAAS;IACd,IAAI,CAAU;IACd,SAAS,CAAU;IAE5B,YAAY,MAQX;QACC,KAAK,CAAC,MAAM,CAAC,OAAO,CAAC,CAAC;QAEtB,IAAI,CAAC,IAAI,GAAG,IAAI,CAAC,WAAW,CAAC,IAAI,CAAC;QAClC,KAAK,CAAC,iBAAiB,CAAC,IAAI,EAAE,IAAI,CAAC,WAAW,CAAC,CAAC;QAEhD,IAAI,CAAC,SAAS,GAAG,MAAM,CAAC,SAAS,IAAI,IAAI,IAAI,EAAE,CAAC;QAChD,IAAI,CAAC,UAAU,GAAG,MAAM,CAAC,UAAU,IAAI,GAAG,CAAC;QAC3C,IAAI,CAAC,IAAI,GAAG,MAAM,CAAC,IAAI,IAAI,IAAI,CAAC,IAAI,CAAC;QACrC,IAAI,CAAC,KAAK,GAAG,MAAM,CAAC,KAAK,CAAC;QAE1B,iCAAiC;QACjC,iCAAiC;QACjC,IAAI,MAAM,CAAC,IAAI,EAAE,CAAC;YAChB,IAAI,CAAC,IAAI,GAAG,MAAM,CAAC,IAAI,CAAC;QAC1B,CAAC;QAED,IAAI,MAAM,CAAC,SAAS,EAAE,CAAC;YACrB,IAAI,CAAC,SAAS,GAAG,MAAM,CAAC,SAAS,CAAC;QACpC,CAAC;IACH,CAAC;IAED,MAAM;QACJ,MAAM,QAAQ,GASV;YACF,IAAI,EAAE,IAAI,CAAC,IAAI;YACf,UAAU,EAAE,IAAI,CAAC,UAAU;YAC3B,KAAK,EAAE,IAAI,CAAC,KAAK;YACjB,OAAO,EAAE,IAAI,CAAC,OAAO;YACrB,SAAS,EAAE,IAAI,CAAC,SAAS,CAAC,WAAW,EAAE;SACxC,CAAC;QAEF,IAAI,IAAI,CAAC,IAAI,EAAE,CAAC;YACd,QAAQ,CAAC,IAAI,GAAG,IAAI,CAAC,IAAI,CAAC;QAC5B,CAAC;QAED,IAAI,IAAI,CAAC,IAAI,EAAE,CAAC;YACd,QAAQ,CAAC,IAAI,GAAG,IAAI,CAAC,IAAI,CAAC;QAC5B,CAAC;QAED,IAAI,IAAI,CAAC,SAAS,EAAE,CAAC;YACnB,QAAQ,CAAC,SAAS,GAAG,IAAI,CAAC,SAAS,CAAC;QACtC,CAAC;QAED,OAAO,QAAQ,CAAC;IAClB,CAAC;CACF;AAtED,sCAsEC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\standard.error.ts"],"sourcesContent":["export class StandardError extends Error {\n  readonly timestamp: Date;\n  readonly statusCode: number;\n  readonly code?: string;\n  readonly error: string;\n  readonly path?: string;\n  readonly fieldName?: string;\n\n  constructor(params: {\n    timestamp?: Date;\n    statusCode?: number;\n    code?: string;\n    error: string;\n    message: string;\n    path?: string;\n    fieldName?: string;\n  }) {\n    super(params.message);\n\n    this.name = this.constructor.name;\n    Error.captureStackTrace(this, this.constructor);\n\n    this.timestamp = params.timestamp ?? new Date();\n    this.statusCode = params.statusCode ?? 400;\n    this.code = params.code ?? this.name;\n    this.error = params.error;\n\n    // com exactOptionalPropertyTypes\n    // só define se realmente existir\n    if (params.path) {\n      this.path = params.path;\n    }\n\n    if (params.fieldName) {\n      this.fieldName = params.fieldName;\n    }\n  }\n\n  toJSON() {\n    const response: {\n      name: string;\n      statusCode: number;\n      code?: string;\n      error: string;\n      message: string;\n      path?: string;\n      fieldName?: string;\n      timestamp: string;\n    } = {\n      name: this.name,\n      statusCode: this.statusCode,\n      error: this.error,\n      message: this.message,\n      timestamp: this.timestamp.toISOString(),\n    };\n\n    if (this.code) {\n      response.code = this.code;\n    }\n\n    if (this.path) {\n      response.path = this.path;\n    }\n\n    if (this.fieldName) {\n      response.fieldName = this.fieldName;\n    }\n\n    return response;\n  }\n}\n"],"version":3}