{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\auth.decorator.ts","mappings":";;AAYA,oBAcC;AA1BD,yCAAuC;AAEvC;;;;;;;;;GASG;AACH,SAAgB,IAAI;IAClB,OAAO,UAAU,MAAc,EAAE,WAA4B;QAC3D,MAAM,MAAM,GAAG,IAAA,oBAAS,EAAC,MAAM,CAAC,WAAW,CAAC,CAAC;QAE7C,MAAM,KAAK,GAAG,MAAM,CAAC,IAAI,CAAC,CAAC,IAAI,EAAE,EAAE,CAAC,IAAI,CAAC,WAAW,KAAK,MAAM,CAAC,WAAW,CAAC,CAAC,CAAC;QAE9E,IAAI,CAAC,KAAK,EAAE,CAAC;YACX,MAAM,IAAI,KAAK,CACb,6DAA6D,MAAM,CAAC,WAAW,CAAC,EAAE,CACnF,CAAC;QACJ,CAAC;QAED,KAAK,CAAC,IAAI,GAAG,IAAI,CAAC;IACpB,CAAC,CAAC;AACJ,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\http\\decorators\\auth.decorator.ts"],"sourcesContent":["import { getRoutes } from \"./metadata\";\n\n/**\n * Marca uma rota como protegida.\n *\n * A implementação real da autenticação fica no register-routes.\n * Exemplo:\n * @Auth()\n * async getProtectedResource() {\n *   // lógica para obter recurso protegido\n * }\n */\nexport function Auth() {\n  return function (target: object, propertyKey: string | symbol): void {\n    const routes = getRoutes(target.constructor);\n\n    const route = routes.find((item) => item.handlerName === String(propertyKey));\n\n    if (!route) {\n      throw new Error(\n        `@Auth precisa ser usado junto com um decorator de rota em ${String(propertyKey)}`,\n      );\n    }\n\n    route.auth = true;\n  };\n}\n"],"version":3}