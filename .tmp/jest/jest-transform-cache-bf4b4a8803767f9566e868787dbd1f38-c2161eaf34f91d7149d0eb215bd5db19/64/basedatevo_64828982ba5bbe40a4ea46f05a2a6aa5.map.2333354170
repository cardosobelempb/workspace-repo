{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\date\\base-date.vo.ts","mappings":";;;AAAA,MAAsB,UAAU;IAG9B,iCAAiC;IACjC,MAAM,CAAC,MAAM,CAEX,UAAkB;QAElB,OAAO,IAAI,IAAI,CAAC,UAAU,CAAC,CAAC;IAC9B,CAAC;CAgBF;AAzBD,gCAyBC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\date-time\\date\\base-date.vo.ts"],"sourcesContent":["export abstract class BaseDateVO {\n  protected abstract value: Date;\n\n  /** Cria a instância (factory) */\n  static create<T extends BaseDateVO>(\n    this: new (dateString: string) => T,\n    dateString: string,\n  ): T {\n    return new this(dateString);\n  }\n\n  /** Retorna a data como string no formato YYYY-MM-DD */\n  abstract getValue(): string;\n\n  /** Retorna a data como objeto Date */\n  abstract getDate(): Date;\n\n  /** Valida o formato da data */\n  protected abstract validate(dateString: string): Date;\n\n  /** Representação da data como string */\n  abstract toString(): string;\n\n  /** Compara com outro DateVO */\n  abstract equals(other: BaseDateVO): boolean;\n}\n"],"version":3}