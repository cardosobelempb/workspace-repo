{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\ip-address\\ip-address.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC,wBAAwB;AACxB,MAAM,UAAU,GAAG,qEAAqE,CAAC;AAEzF,uEAAuE;AACvE,MAAM,UAAU,GACd,6HAA6H,CAAC;AAIhI;;;;;GAKG;AACH,MAAa,WAAY,SAAQ,gBAAc;IAC7C,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAED,6DAA6D;IAE7D;;;OAGG;IACI,MAAM,CAAC,MAAM,CAAC,GAAW;QAC9B,IAAI,CAAC,GAAG,IAAI,GAAG,CAAC,IAAI,EAAE,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACpC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,6BAA6B;aACvC,CAAC,CAAC;QACL,CAAC;QAED,MAAM,QAAQ,GAAG,IAAI,WAAW,CAAC,GAAG,CAAC,IAAI,EAAE,CAAC,CAAC;QAE7C,IAAI,CAAC,QAAQ,CAAC,OAAO,EAAE,EAAE,CAAC;YACxB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,oDAAoD;aAC9D,CAAC,CAAC;QACL,CAAC;QAED,OAAO,QAAQ,CAAC;IAClB,CAAC;IAED;;;OAGG;IACI,MAAM,CAAC,eAAe,CAAC,GAA8B;QAC1D,IAAI,CAAC,GAAG;YAAE,OAAO,IAAI,WAAW,CAAC,SAAS,CAAC,CAAC;QAC5C,IAAI,CAAC;YACH,OAAO,WAAW,CAAC,MAAM,CAAC,GAAG,CAAC,CAAC;QACjC,CAAC;QAAC,MAAM,CAAC;YACP,OAAO,IAAI,WAAW,CAAC,SAAS,CAAC,CAAC;QACpC,CAAC;IACH,CAAC;IAED,6DAA6D;IAEtD,OAAO;QACZ,IAAI,IAAI,CAAC,KAAK,KAAK,SAAS;YAAE,OAAO,IAAI,CAAC;QAC1C,OAAO,UAAU,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,IAAI,UAAU,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IACpE,CAAC;IAED,6DAA6D;IAE7D,IAAW,OAAO;QAChB,IAAI,IAAI,CAAC,KAAK,KAAK,SAAS;YAAE,OAAO,SAAS,CAAC;QAC/C,IAAI,UAAU,CAAC,IAAI,CAAC,IAAI,CAAC,KAAK,CAAC;YAAE,OAAO,IAAI,CAAC;QAC7C,OAAO,IAAI,CAAC;IACd,CAAC;IAED,IAAW,UAAU;QACnB,OAAO,IAAI,CAAC,KAAK,KAAK,WAAW,IAAI,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC;IAC5D,CAAC;IAED,IAAW,SAAS;QAClB,IAAI,IAAI,CAAC,KAAK,KAAK,SAAS,IAAI,IAAI,CAAC,OAAO,KAAK,IAAI;YAAE,OAAO,KAAK,CAAC;QACpE,MAAM,CAAC,CAAC,EAAE,CAAC,CAAC,GAAG,IAAI,CAAC,KAAK,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC;QACjD,OAAO,CAAC,KAAK,EAAE,IAAI,CAAC,CAAC,KAAK,GAAG,IAAI,CAAC,IAAI,EAAE,IAAI,CAAC,IAAI,EAAE,CAAC,IAAI,CAAC,CAAC,KAAK,GAAG,IAAI,CAAC,KAAK,GAAG,CAAC,CAAC;IACnF,CAAC;CACF;AApED,kCAoEC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\ip-address\\ip-address.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\n// IPv4: 4 octetos 0–255\r\nconst IPV4_REGEX = /^((25[0-5]|2[0-4]\\d|[01]?\\d\\d?)\\.){3}(25[0-5]|2[0-4]\\d|[01]?\\d\\d?)$/;\r\n\r\n// IPv6: 8 grupos de 4 hex separados por : (ou forma compactada com ::)\r\nconst IPV6_REGEX =\r\n  /^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|(([0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{1,4})?::(([0-9a-fA-F]{1,4}:)*[0-9a-fA-F]{1,4})?)$/;\r\n\r\nexport type IpVersion = \"v4\" | \"v6\" | \"unknown\";\r\n\r\n/**\r\n * 🌐 IpAddressVO\r\n *\r\n * Encapsula um endereço IPv4 ou IPv6 validado.\r\n * Oferece fallback seguro para \"unknown\" quando o IP não está disponível.\r\n */\r\nexport class IpAddressVO extends BaseVO<string> {\r\n  private constructor(value: string) {\r\n    super(value);\r\n  }\r\n\r\n  // ─── Factories ────────────────────────────────────────────\r\n\r\n  /**\r\n   * ✅ Cria a partir de um IP obrigatório.\r\n   * Lança erro se o formato for inválido.\r\n   */\r\n  public static create(raw: string): IpAddressVO {\r\n    if (!raw || raw.trim().length === 0) {\r\n      throw new BadRequestError({\r\n        fieldName: \"ipAddress\",\r\n        message: \"IP address cannot be empty.\",\r\n      });\r\n    }\r\n\r\n    const instance = new IpAddressVO(raw.trim());\r\n\r\n    if (!instance.isValid()) {\r\n      throw new BadRequestError({\r\n        fieldName: \"ipAddress\",\r\n        message: \"Invalid IP address format (IPv4 or IPv6 expected).\",\r\n      });\r\n    }\r\n\r\n    return instance;\r\n  }\r\n\r\n  /**\r\n   * ✅ Cria com fallback para \"unknown\".\r\n   * Use em controllers onde o header pode estar ausente.\r\n   */\r\n  public static createOrUnknown(raw: string | undefined | null): IpAddressVO {\r\n    if (!raw) return new IpAddressVO(\"unknown\");\r\n    try {\r\n      return IpAddressVO.create(raw);\r\n    } catch {\r\n      return new IpAddressVO(\"unknown\");\r\n    }\r\n  }\r\n\r\n  // ─── Validação ────────────────────────────────────────────\r\n\r\n  public isValid(): boolean {\r\n    if (this.value === \"unknown\") return true;\r\n    return IPV4_REGEX.test(this.value) || IPV6_REGEX.test(this.value);\r\n  }\r\n\r\n  // ─── Accessors ────────────────────────────────────────────\r\n\r\n  public get version(): IpVersion {\r\n    if (this.value === \"unknown\") return \"unknown\";\r\n    if (IPV4_REGEX.test(this.value)) return \"v4\";\r\n    return \"v6\";\r\n  }\r\n\r\n  public get isLoopback(): boolean {\r\n    return this.value === \"127.0.0.1\" || this.value === \"::1\";\r\n  }\r\n\r\n  public get isPrivate(): boolean {\r\n    if (this.value === \"unknown\" || this.version === \"v6\") return false;\r\n    const [a, b] = this.value.split(\".\").map(Number);\r\n    return a === 10 || (a === 172 && b >= 16 && b <= 31) || (a === 192 && b === 168);\r\n  }\r\n}\r\n"],"version":3}