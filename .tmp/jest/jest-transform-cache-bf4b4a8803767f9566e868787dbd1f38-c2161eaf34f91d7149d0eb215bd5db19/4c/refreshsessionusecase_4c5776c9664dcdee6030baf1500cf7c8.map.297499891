{"version":3,"names":["cov_c5ss0zm6g","actualCoverage","s","common_1","require","session_factory_1","constants_1","RefreshSessionUseCase","tokenGenerator","hashGenerator","users","sessions","cache","inject","AUTH_DI_TOKENS","SESSION_TOKEN_SERVICE","USER_REPOSITORY","SESSION_REPOSITORY","SESSION_CACHE_REPOSITORY","constructor","f","execute","rawSessionToken","metadata","oldHash","hash","AUTH_TOKEN_CONSTANTS","SESSION_TOKEN_SALT_ROUNDS","current","findValidByTokenHash","b","left","UnauthorizedError","fieldName","message","user","findActiveById","userId","getValue","revokeByTokenHash","delete","newToken","generate","id","newHash","expiresAt","Date","now","SESSION_TTL_SECONDS","session","create","SessionFactory","build","sessionToken","expires","toDateString","ipAddress","userAgent","set","right","email","value","emailVerified","accessToken","refreshToken","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\use-cases\\refresh-session.use-case.ts"],"sourcesContent":["import {\r\n  Either,\r\n  HashGenerator,\r\n  left,\r\n  right,\r\n  TokenGenerator,\r\n  UnauthorizedError,\r\n} from \"@repo/common\";\r\nimport { SessionCacheRepository } from \"../../domain/repositories/session-cache.repository\";\r\nimport { SessionRepository } from \"../../domain/repositories/session.repository\";\r\nimport { UserRepository } from \"../../domain/repositories/user.repository\";\r\nimport { AuthProjectionDto } from \"../dto/auth.dto\";\r\nimport { SessionFactory } from \"../factories/session.factory\";\r\n\r\nimport { AUTH_DI_TOKENS, AUTH_TOKEN_CONSTANTS } from \"../../constants\";\r\n\r\nexport type RefreshSessionUseCaseResponse = Either<UnauthorizedError, AuthProjectionDto>;\r\nexport type RefreshSessionMetadata = {\r\n  ipAddress: string | null;\r\n  userAgent: string | null;\r\n};\r\n\r\nexport class RefreshSessionUseCase {\r\n  static inject = [\r\n    AUTH_DI_TOKENS.SESSION_TOKEN_SERVICE,\r\n    AUTH_DI_TOKENS.SESSION_TOKEN_SERVICE,\r\n    AUTH_DI_TOKENS.USER_REPOSITORY,\r\n    AUTH_DI_TOKENS.SESSION_REPOSITORY,\r\n    AUTH_DI_TOKENS.SESSION_CACHE_REPOSITORY,\r\n  ];\r\n\r\n  constructor(\r\n    private readonly tokenGenerator: TokenGenerator<{ userId: string }>,\r\n    private readonly hashGenerator: HashGenerator,\r\n    private readonly users: UserRepository,\r\n    private readonly sessions: SessionRepository,\r\n    private readonly cache: SessionCacheRepository,\r\n  ) {}\r\n\r\n  async execute(\r\n    rawSessionToken: string,\r\n    metadata: RefreshSessionMetadata,\r\n  ): Promise<RefreshSessionUseCaseResponse> {\r\n    const oldHash = await this.hashGenerator.hash(\r\n      rawSessionToken,\r\n      AUTH_TOKEN_CONSTANTS.SESSION_TOKEN_SALT_ROUNDS,\r\n    );\r\n    const current = await this.sessions.findValidByTokenHash(oldHash);\r\n\r\n    if (!current) {\r\n      return left(\r\n        new UnauthorizedError({\r\n          fieldName: \"session\",\r\n          message: \"Sessão inválida ou expirada.\",\r\n        }),\r\n      );\r\n    }\r\n\r\n    const user = await this.users.findActiveById(current.userId.getValue());\r\n    if (!user) {\r\n      return left(\r\n        new UnauthorizedError({\r\n          fieldName: \"user\",\r\n          message: \"Usuário inválido ou inativo.\",\r\n        }),\r\n      );\r\n    }\r\n\r\n    await this.sessions.revokeByTokenHash(oldHash);\r\n    await this.cache.delete(oldHash);\r\n\r\n    const newToken = await this.tokenGenerator.generate({ userId: user.id.getValue() });\r\n    const newHash = await this.hashGenerator.hash(\r\n      newToken,\r\n      AUTH_TOKEN_CONSTANTS.SESSION_TOKEN_SALT_ROUNDS,\r\n    );\r\n    const expiresAt = new Date(\r\n      Date.now() + AUTH_TOKEN_CONSTANTS.SESSION_TTL_SECONDS * 1000,\r\n    );\r\n\r\n    const session = await this.sessions.create(\r\n      SessionFactory.build({\r\n        userId: user.id.getValue(),\r\n        sessionToken: newHash,\r\n        expires: expiresAt.toDateString(),\r\n        ipAddress: metadata.ipAddress,\r\n        userAgent: metadata.userAgent,\r\n      }),\r\n    );\r\n\r\n    await this.cache.set(session);\r\n\r\n    return right({\r\n      user: {\r\n        id: user.id.getValue(),\r\n        email: user.email.getValue().value,\r\n        emailVerified: user.emailVerified,\r\n      },\r\n      accessToken: newToken,\r\n      refreshToken: newToken,\r\n      expiresAt,\r\n    });\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IA0BI;IAAAA,aAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,aAAA;AAAAA,aAAA,GAAAE,CAAA;;;;;;;AA1BJ,MAAAC,QAAA;AAAA;AAAA,CAAAH,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAYA,MAAAC,iBAAA;AAAA;AAAA,CAAAL,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAEA,MAAAE,WAAA;AAAA;AAAA,CAAAN,aAAA,GAAAE,CAAA,OAAAE,OAAA;AAQA,MAAaG,qBAAqB;EAUbC,cAAA;EACAC,aAAA;EACAC,KAAA;EACAC,QAAA;EACAC,KAAA;EAbnB,OAAOC,MAAM;EAAA;EAAA,CAAAb,aAAA,GAAAE,CAAA,OAAG,CACdI,WAAA,CAAAQ,cAAc,CAACC,qBAAqB,EACpCT,WAAA,CAAAQ,cAAc,CAACC,qBAAqB,EACpCT,WAAA,CAAAQ,cAAc,CAACE,eAAe,EAC9BV,WAAA,CAAAQ,cAAc,CAACG,kBAAkB,EACjCX,WAAA,CAAAQ,cAAc,CAACI,wBAAwB,CACxC;EAEDC,YACmBX,cAAkD,EAClDC,aAA4B,EAC5BC,KAAqB,EACrBC,QAA2B,EAC3BC,KAA6B;IAAA;IAAAZ,aAAA,GAAAoB,CAAA;IAAApB,aAAA,GAAAE,CAAA;IAJ7B,KAAAM,cAAc,GAAdA,cAAc;IAAoC;IAAAR,aAAA,GAAAE,CAAA;IAClD,KAAAO,aAAa,GAAbA,aAAa;IAAe;IAAAT,aAAA,GAAAE,CAAA;IAC5B,KAAAQ,KAAK,GAALA,KAAK;IAAgB;IAAAV,aAAA,GAAAE,CAAA;IACrB,KAAAS,QAAQ,GAARA,QAAQ;IAAmB;IAAAX,aAAA,GAAAE,CAAA;IAC3B,KAAAU,KAAK,GAALA,KAAK;EACrB;EAEH,MAAMS,OAAOA,CACXC,eAAuB,EACvBC,QAAgC;IAAA;IAAAvB,aAAA,GAAAoB,CAAA;IAEhC,MAAMI,OAAO;IAAA;IAAA,CAAAxB,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACO,aAAa,CAACgB,IAAI,CAC3CH,eAAe,EACfhB,WAAA,CAAAoB,oBAAoB,CAACC,yBAAyB,CAC/C;IACD,MAAMC,OAAO;IAAA;IAAA,CAAA5B,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACS,QAAQ,CAACkB,oBAAoB,CAACL,OAAO,CAAC;IAAC;IAAAxB,aAAA,GAAAE,CAAA;IAElE,IAAI,CAAC0B,OAAO,EAAE;MAAA;MAAA5B,aAAA,GAAA8B,CAAA;MAAA9B,aAAA,GAAAE,CAAA;MACZ,OAAO,IAAAC,QAAA,CAAA4B,IAAI,EACT,IAAI5B,QAAA,CAAA6B,iBAAiB,CAAC;QACpBC,SAAS,EAAE,SAAS;QACpBC,OAAO,EAAE;OACV,CAAC,CACH;IACH,CAAC;IAAA;IAAA;MAAAlC,aAAA,GAAA8B,CAAA;IAAA;IAED,MAAMK,IAAI;IAAA;IAAA,CAAAnC,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACQ,KAAK,CAAC0B,cAAc,CAACR,OAAO,CAACS,MAAM,CAACC,QAAQ,EAAE,CAAC;IAAC;IAAAtC,aAAA,GAAAE,CAAA;IACxE,IAAI,CAACiC,IAAI,EAAE;MAAA;MAAAnC,aAAA,GAAA8B,CAAA;MAAA9B,aAAA,GAAAE,CAAA;MACT,OAAO,IAAAC,QAAA,CAAA4B,IAAI,EACT,IAAI5B,QAAA,CAAA6B,iBAAiB,CAAC;QACpBC,SAAS,EAAE,MAAM;QACjBC,OAAO,EAAE;OACV,CAAC,CACH;IACH,CAAC;IAAA;IAAA;MAAAlC,aAAA,GAAA8B,CAAA;IAAA;IAAA9B,aAAA,GAAAE,CAAA;IAED,MAAM,IAAI,CAACS,QAAQ,CAAC4B,iBAAiB,CAACf,OAAO,CAAC;IAAC;IAAAxB,aAAA,GAAAE,CAAA;IAC/C,MAAM,IAAI,CAACU,KAAK,CAAC4B,MAAM,CAAChB,OAAO,CAAC;IAEhC,MAAMiB,QAAQ;IAAA;IAAA,CAAAzC,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACM,cAAc,CAACkC,QAAQ,CAAC;MAAEL,MAAM,EAAEF,IAAI,CAACQ,EAAE,CAACL,QAAQ;IAAE,CAAE,CAAC;IACnF,MAAMM,OAAO;IAAA;IAAA,CAAA5C,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACO,aAAa,CAACgB,IAAI,CAC3CgB,QAAQ,EACRnC,WAAA,CAAAoB,oBAAoB,CAACC,yBAAyB,CAC/C;IACD,MAAMkB,SAAS;IAAA;IAAA,CAAA7C,aAAA,GAAAE,CAAA,QAAG,IAAI4C,IAAI,CACxBA,IAAI,CAACC,GAAG,EAAE,GAAGzC,WAAA,CAAAoB,oBAAoB,CAACsB,mBAAmB,GAAG,IAAI,CAC7D;IAED,MAAMC,OAAO;IAAA;IAAA,CAAAjD,aAAA,GAAAE,CAAA,QAAG,MAAM,IAAI,CAACS,QAAQ,CAACuC,MAAM,CACxC7C,iBAAA,CAAA8C,cAAc,CAACC,KAAK,CAAC;MACnBf,MAAM,EAAEF,IAAI,CAACQ,EAAE,CAACL,QAAQ,EAAE;MAC1Be,YAAY,EAAET,OAAO;MACrBU,OAAO,EAAET,SAAS,CAACU,YAAY,EAAE;MACjCC,SAAS,EAAEjC,QAAQ,CAACiC,SAAS;MAC7BC,SAAS,EAAElC,QAAQ,CAACkC;KACrB,CAAC,CACH;IAAC;IAAAzD,aAAA,GAAAE,CAAA;IAEF,MAAM,IAAI,CAACU,KAAK,CAAC8C,GAAG,CAACT,OAAO,CAAC;IAAC;IAAAjD,aAAA,GAAAE,CAAA;IAE9B,OAAO,IAAAC,QAAA,CAAAwD,KAAK,EAAC;MACXxB,IAAI,EAAE;QACJQ,EAAE,EAAER,IAAI,CAACQ,EAAE,CAACL,QAAQ,EAAE;QACtBsB,KAAK,EAAEzB,IAAI,CAACyB,KAAK,CAACtB,QAAQ,EAAE,CAACuB,KAAK;QAClCC,aAAa,EAAE3B,IAAI,CAAC2B;OACrB;MACDC,WAAW,EAAEtB,QAAQ;MACrBuB,YAAY,EAAEvB,QAAQ;MACtBI;KACD,CAAC;EACJ;;;;AAhFFoB,OAAA,CAAA1D,qBAAA,GAAAA,qBAAA","ignoreList":[]}