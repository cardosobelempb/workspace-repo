{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\page-query.schema.ts","mappings":";;;;;;AAAA,8CAAoB;AAEpB,+CAA+C;AAClC,QAAA,eAAe,GAAG,aAAC;KAC7B,MAAM,CAAC;IACN,IAAI,EAAE,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,OAAO,CAAC,CAAC,CAAC;IAC/C,IAAI,EAAE,aAAC,CAAC,MAAM,CAAC,MAAM,EAAE,CAAC,GAAG,EAAE,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,GAAG,CAAC,CAAC,OAAO,CAAC,EAAE,CAAC;IACzD,IAAI,EAAE,aAAC;SACJ,MAAM,EAAE;SACR,IAAI,EAAE;SACN,KAAK,CACJ,sCAAsC,EACtC,qDAAqD,CACtD;SACA,QAAQ,EAAE;IACb,MAAM,EAAE,aAAC,CAAC,MAAM,EAAE,CAAC,IAAI,EAAE,CAAC,OAAO,CAAC,EAAE,CAAC;CACtC,CAAC;KACD,MAAM,EAAE,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\shared\\lib\\schemas\\page-query.schema.ts"],"sourcesContent":["import z from \"zod\";\n\n/*/* Schema de entrada para buscas paginadas */\nexport const PageQuerySchema = z\n  .object({\n    page: z.coerce.number().int().min(0).default(0),\n    size: z.coerce.number().int().min(1).max(100).default(20),\n    sort: z\n      .string()\n      .trim()\n      .regex(\n        /^[a-zA-Z][a-zA-Z0-9_.]*,(asc|desc)$/i,\n        \"sort deve seguir o formato: campo,asc ou campo,desc\",\n      )\n      .optional(),\n    filter: z.string().trim().default(\"\"),\n  })\n  .strict();\n"],"version":3}