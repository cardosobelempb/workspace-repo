{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\test\\wait-for.ts","mappings":";;AAUA,0BA4BC;AAtCD;;;;;;;;;GASG;AACI,KAAK,UAAU,OAAO,CAC3B,UAAsB,EACtB,OAAO,GAAG,IAAI,EACd,QAAQ,GAAG,EAAE;IAEb,MAAM,SAAS,GAAG,IAAI,CAAC,GAAG,EAAE,CAAC;IAC7B,IAAI,SAAkB,CAAC;IAEvB,OAAO,IAAI,OAAO,CAAC,CAAC,OAAO,EAAE,MAAM,EAAE,EAAE;QACrC,MAAM,OAAO,GAAG,GAAG,EAAE;YACnB,IAAI,CAAC;gBACH,UAAU,EAAE,CAAC;gBACb,OAAO,OAAO,EAAE,CAAC;YACnB,CAAC;YAAC,OAAO,KAAK,EAAE,CAAC;gBACf,SAAS,GAAG,KAAK,CAAC;gBAElB,MAAM,WAAW,GAAG,IAAI,CAAC,GAAG,EAAE,GAAG,SAAS,CAAC;gBAE3C,IAAI,WAAW,IAAI,OAAO,EAAE,CAAC;oBAC3B,OAAO,MAAM,CAAC,SAAS,CAAC,CAAC;gBAC3B,CAAC;gBAED,UAAU,CAAC,OAAO,EAAE,QAAQ,CAAC,CAAC;YAChC,CAAC;QACH,CAAC,CAAC;QAEF,OAAO,EAAE,CAAC;IACZ,CAAC,CAAC,CAAC;AACL,CAAC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\test\\wait-for.ts"],"sourcesContent":["/**\n * Reexecuta assertions até que todas passem ou o tempo máximo seja atingido.\n *\n * Útil para testar comportamentos assíncronos/eventuais,\n * como subscribers, side effects ou event buses.\n *\n * @param assertions Função contendo as assertions (deve lançar erro se falhar)\n * @param timeout Tempo máximo de espera em ms\n * @param interval Intervalo entre tentativas em ms\n */\nexport async function waitFor(\n  assertions: () => void,\n  timeout = 1000,\n  interval = 10,\n): Promise<void> {\n  const startTime = Date.now();\n  let lastError: unknown;\n\n  return new Promise((resolve, reject) => {\n    const attempt = () => {\n      try {\n        assertions();\n        return resolve();\n      } catch (error) {\n        lastError = error;\n\n        const elapsedTime = Date.now() - startTime;\n\n        if (elapsedTime >= timeout) {\n          return reject(lastError);\n        }\n\n        setTimeout(attempt, interval);\n      }\n    };\n\n    attempt();\n  });\n}\n"],"version":3}