{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\cpf\\cpf.vo.ts","mappings":";;;AAAA,kFAA6E;AAE7E,MAAa,KAAK;IACC,KAAK,CAAS;IAE/B,YAAY,GAAW;QACrB,2DAA2D;QAC3D,IAAI,CAAC,UAAU,CAAC,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC;YAC1B,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,KAAK;gBAChB,KAAK,EAAE,GAAG;gBACV,OAAO,EAAE,sEAAsE,GAAG,GAAG;aACtF,CAAC,CAAC;QACL,CAAC;QAED,2CAA2C;QAC3C,MAAM,YAAY,GAAG,KAAK,CAAC,QAAQ,CAAC,GAAG,CAAC,CAAC;QAEzC,IAAI,CAAC,KAAK,CAAC,OAAO,CAAC,YAAY,CAAC,EAAE,CAAC;YACjC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,KAAK;gBAChB,KAAK,EAAE,GAAG;gBACV,OAAO,EAAE,kCAAkC,YAAY,EAAE;aAC1D,CAAC,CAAC;QACL,CAAC;QAED,IAAI,CAAC,KAAK,GAAG,YAAY,CAAC;IAC5B,CAAC;IAEM,QAAQ;QACb,OAAO,IAAI,CAAC,KAAK,CAAC;IACpB,CAAC;IAEM,YAAY;QACjB,OAAO,KAAK,CAAC,MAAM,CAAC,IAAI,CAAC,KAAK,CAAC,CAAC;IAClC,CAAC;IAEM,MAAM,CAAC,KAAY;QACxB,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,QAAQ,EAAE,CAAC;IACzC,CAAC;IAED,qEAAqE;IAC9D,MAAM,CAAC,OAAO,CAAC,GAAW;QAC/B,MAAM,YAAY,GAAG,IAAI,CAAC,QAAQ,CAAC,GAAG,CAAC,CAAC;QAExC,IAAI,CAAC,UAAU,CAAC,IAAI,CAAC,YAAY,CAAC;YAAE,OAAO,KAAK,CAAC;QACjD,IAAI,WAAW,CAAC,IAAI,CAAC,YAAY,CAAC;YAAE,OAAO,KAAK,CAAC,CAAC,6CAA6C;QAE/F,MAAM,MAAM,GAAG,YAAY,CAAC,KAAK,CAAC,EAAE,CAAC,CAAC,GAAG,CAAC,MAAM,CAAC,CAAC;QAElD,wDAAwD;QACxD,MAAM,cAAc,GAAG,CAAC,IAAY,EAAE,GAAa,EAAU,EAAE;YAC7D,MAAM,GAAG,GAAG,GAAG;iBACZ,KAAK,CAAC,CAAC,EAAE,IAAI,CAAC;iBACd,MAAM,CAAC,CAAC,GAAG,EAAE,KAAK,EAAE,GAAG,EAAE,EAAE,CAAC,GAAG,GAAG,KAAK,GAAG,CAAC,IAAI,GAAG,CAAC,GAAG,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC;YAClE,MAAM,IAAI,GAAG,GAAG,GAAG,EAAE,CAAC;YACtB,OAAO,IAAI,GAAG,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,GAAG,IAAI,CAAC;QAClC,CAAC,CAAC;QAEF,MAAM,EAAE,GAAG,cAAc,CAAC,CAAC,EAAE,MAAM,CAAC,CAAC;QACrC,MAAM,EAAE,GAAG,cAAc,CAAC,EAAE,EAAE,CAAC,GAAG,MAAM,CAAC,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC;QAE3D,OAAO,EAAE,KAAK,MAAM,CAAC,CAAC,CAAC,IAAI,EAAE,KAAK,MAAM,CAAC,EAAE,CAAC,CAAC;IAC/C,CAAC;IAED,0CAA0C;IACnC,MAAM,CAAC,MAAM,CAAC,GAAW;QAC9B,MAAM,YAAY,GAAG,IAAI,CAAC,QAAQ,CAAC,GAAG,CAAC,CAAC;QACxC,IAAI,YAAY,CAAC,MAAM,KAAK,EAAE,EAAE,CAAC;YAC/B,MAAM,IAAI,KAAK,CAAC,6BAA6B,CAAC,CAAC;QACjD,CAAC;QACD,OAAO,YAAY,CAAC,OAAO,CAAC,8BAA8B,EAAE,aAAa,CAAC,CAAC;IAC7E,CAAC;IAED,2CAA2C;IACnC,MAAM,CAAC,QAAQ,CAAC,GAAW;QACjC,OAAO,GAAG,CAAC,OAAO,CAAC,KAAK,EAAE,EAAE,CAAC,CAAC;IAChC,CAAC;CACF;AA5ED,sBA4EC;AAED;;;;;;;;;;;;;;;EAeE","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\cpf\\cpf.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\n\nexport class CpfVO {\n  private readonly value: string;\n\n  constructor(cpf: string) {\n    // Verifica se o CPF contém exatamente 11 dígitos numéricos\n    if (!/^\\d{11}$/.test(cpf)) {\n      throw new BadRequestError({\n        fieldName: \"cpf\",\n        value: cpf,\n        message: `CPF deve conter exatamente 11 dígitos numéricos. Valor fornecido: \"${cpf}\"`,\n      });\n    }\n\n    // Limpa o CPF (remove pontuações) e valida\n    const sanitizedCpf = CpfVO.sanitize(cpf);\n\n    if (!CpfVO.isValid(sanitizedCpf)) {\n      throw new BadRequestError({\n        fieldName: \"cpf\",\n        value: cpf,\n        message: `CPF inválido. Valor fornecido: ${sanitizedCpf}`,\n      });\n    }\n\n    this.value = sanitizedCpf;\n  }\n\n  public getValue(): string {\n    return this.value;\n  }\n\n  public getFormatted(): string {\n    return CpfVO.format(this.value);\n  }\n\n  public equals(other: CpfVO): boolean {\n    return this.value === other.getValue();\n  }\n\n  // Valida o CPF, incluindo a verificação dos dois dígitos de controle\n  public static isValid(cpf: string): boolean {\n    const sanitizedCpf = this.sanitize(cpf);\n\n    if (!/^\\d{11}$/.test(sanitizedCpf)) return false;\n    if (/^(\\d)\\1+$/.test(sanitizedCpf)) return false; // CPF com todos os números iguais é inválido\n\n    const digits = sanitizedCpf.split(\"\").map(Number);\n\n    // Função auxiliar para calcular o dígito de verificação\n    const calcCheckDigit = (base: number, arr: number[]): number => {\n      const sum = arr\n        .slice(0, base)\n        .reduce((acc, digit, idx) => acc + digit * (base + 1 - idx), 0);\n      const rest = sum % 11;\n      return rest < 2 ? 0 : 11 - rest;\n    };\n\n    const d1 = calcCheckDigit(9, digits);\n    const d2 = calcCheckDigit(10, [...digits.slice(0, 9), d1]);\n\n    return d1 === digits[9] && d2 === digits[10];\n  }\n\n  // Formata o CPF no formato XXX.XXX.XXX-XX\n  public static format(cpf: string): string {\n    const sanitizedCpf = this.sanitize(cpf);\n    if (sanitizedCpf.length !== 11) {\n      throw new Error(\"CPF deve conter 11 dígitos.\");\n    }\n    return sanitizedCpf.replace(/(\\d{3})(\\d{3})(\\d{3})(\\d{2})/, \"$1.$2.$3-$4\");\n  }\n\n  // Remove todos os caracteres não numéricos\n  private static sanitize(cpf: string): string {\n    return cpf.replace(/\\D/g, \"\");\n  }\n}\n\n/*\nconst cpf2 = new CpfVO('529.982.247-25')\nconsole.log(cpf2.getValue()) // CPF sem formatação\nconsole.log(cpf2.getFormatted()) // CPF formatado\nconsole.log(cpf2.equals(new CpfVO('52998224725'))) // Comparação\n\ntry {\n  const cpf = new CpfVO('529.982.247-25')\n  console.log(cpf.getValue())        // '52998224725'\n  console.log(cpf.getFormatted())    // '529.982.247-25'\n  console.log(cpf.equals(new CpfVO('52998224725'))) // true\n} catch (error) {\n  console.error(error.message) // Caso o CPF seja inválido\n}\n\n*/\n"],"version":3}