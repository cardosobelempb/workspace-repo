{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\image.vo.ts","mappings":";;;AAAA,iDAA4C;AAE5C,MAAa,OAAQ,SAAQ,yBAAU;IAC7B,MAAM,CAAU,kBAAkB,GAAG,CAAC,MAAM,EAAE,OAAO,EAAE,MAAM,EAAE,OAAO,CAAC,CAAC;IACxE,MAAM,CAAU,kBAAkB,GAAG,CAAC,WAAW,EAAE,YAAY,EAAE,YAAY,CAAC,CAAC;IAEhF,OAAO;QACZ,MAAM,IAAI,KAAK,CAAC,yBAAyB,CAAC,CAAC;IAC7C,CAAC;IAEM,MAAM,CAAC,MAAM,CAClB,YAAoB,EACpB,QAAgB,EAChB,MAAc,EACd,IAAY;QAEZ,MAAM,KAAK,GAAG,IAAI,OAAO,CAAC,YAAY,EAAE,QAAQ,EAAE,MAAM,EAAE,IAAI,CAAC,CAAC;QAChE,OAAO,KAAK,CAAC;IACf,CAAC;IAED,KAAK,CAAC,QAAQ;QACZ,MAAM,GAAG,GAAG,GAAG,GAAG,CAAC,IAAI,CAAC,YAAY,CAAC,KAAK,CAAC,GAAG,CAAC,CAAC,GAAG,EAAE,IAAI,EAAE,CAAC,CAAC,WAAW,EAAE,CAAC;QAC3E,IAAI,CAAC,OAAO,CAAC,kBAAkB,CAAC,QAAQ,CAAC,GAAG,CAAC,EAAE,CAAC;YAC9C,MAAM,IAAI,KAAK,CAAC,4BAA4B,GAAG,EAAE,CAAC,CAAC;QACrD,CAAC;QACD,IAAI,CAAC,OAAO,CAAC,kBAAkB,CAAC,QAAQ,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YACxD,MAAM,IAAI,KAAK,CAAC,4BAA4B,IAAI,CAAC,QAAQ,EAAE,CAAC,CAAC;QAC/D,CAAC;QACD,IAAI,CAAC,IAAI,CAAC,MAAM,IAAI,IAAI,CAAC,MAAM,CAAC,MAAM,KAAK,CAAC;YAC1C,MAAM,IAAI,KAAK,CAAC,6BAA6B,CAAC,CAAC;QACjD,sBAAsB;QACtB,MAAM,MAAM,GAAG,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC;QACvC,MAAM,KAAK,GACT,CAAC,GAAG,KAAK,MAAM,IAAI,MAAM,CAAC,QAAQ,CAAC,KAAK,CAAC,KAAK,UAAU,CAAC;YACzD,CAAC,CAAC,MAAM,EAAE,OAAO,CAAC,CAAC,QAAQ,CAAC,GAAG,CAAC,IAAI,MAAM,CAAC,QAAQ,CAAC,KAAK,CAAC,CAAC,UAAU,CAAC,MAAM,CAAC,CAAC;YAC9E,CAAC,GAAG,KAAK,OAAO,IAAI,MAAM,CAAC,QAAQ,EAAE,KAAK,MAAM,CAAC,CAAC;QACpD,IAAI,CAAC,KAAK;YAAE,MAAM,IAAI,KAAK,CAAC,iDAAiD,CAAC,CAAC;IACjF,CAAC;;AAnCH,0BAoCC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\file\\image.vo.ts"],"sourcesContent":["import { BaseFileVO } from \"./base-file.vo\";\n\nexport class ImageVO extends BaseFileVO {\n  private static readonly ALLOWED_EXTENSIONS = [\".png\", \".jpeg\", \".jpg\", \".webp\"];\n  private static readonly ALLOWED_MIME_TYPES = [\"image/png\", \"image/jpeg\", \"image/webp\"];\n\n  public isValid(): boolean {\n    throw new Error(\"Method not implemented.\");\n  }\n\n  public static create(\n    originalName: string,\n    mimeType: string,\n    buffer: Buffer,\n    size: number,\n  ): ImageVO {\n    const image = new ImageVO(originalName, mimeType, buffer, size);\n    return image;\n  }\n\n  async validate() {\n    const ext = \".\" + (this.originalName.split(\".\").pop() ?? \"\").toLowerCase();\n    if (!ImageVO.ALLOWED_EXTENSIONS.includes(ext)) {\n      throw new Error(`Invalid image extension: ${ext}`);\n    }\n    if (!ImageVO.ALLOWED_MIME_TYPES.includes(this.mimeType)) {\n      throw new Error(`Invalid image MIME type: ${this.mimeType}`);\n    }\n    if (!this.buffer || this.buffer.length === 0)\n      throw new Error(\"Image is empty or corrupted\");\n    // Magic number básico\n    const header = this.buffer.slice(0, 4);\n    const valid =\n      (ext === \".png\" && header.toString(\"hex\") === \"89504e47\") ||\n      ([\".jpg\", \".jpeg\"].includes(ext) && header.toString(\"hex\").startsWith(\"ffd8\")) ||\n      (ext === \".webp\" && header.toString() === \"RIFF\");\n    if (!valid) throw new Error(\"Invalid image signature (magic number mismatch)\");\n  }\n}\n"],"version":3}