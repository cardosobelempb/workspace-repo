{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\user-agent\\user-agent.vo.ts","mappings":";;;AAAA,kFAA6E;AAC7E,wCAAoC;AAEpC,MAAM,UAAU,GAAG,GAAG,CAAC;AAIvB;;;;;GAKG;AACH,MAAa,WAAY,SAAQ,gBAAc;IAC7C,YAAoB,KAAa;QAC/B,KAAK,CAAC,KAAK,CAAC,CAAC;IACf,CAAC;IAED,6DAA6D;IAE7D;;OAEG;IACI,MAAM,CAAC,MAAM,CAAC,GAAW;QAC9B,IAAI,CAAC,GAAG,IAAI,GAAG,CAAC,IAAI,EAAE,CAAC,MAAM,KAAK,CAAC,EAAE,CAAC;YACpC,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,6BAA6B;aACvC,CAAC,CAAC;QACL,CAAC;QAED,MAAM,QAAQ,GAAG,IAAI,WAAW,CAAC,GAAG,CAAC,IAAI,EAAE,CAAC,CAAC;QAE7C,IAAI,CAAC,QAAQ,CAAC,OAAO,EAAE,EAAE,CAAC;YACxB,MAAM,IAAI,mCAAe,CAAC;gBACxB,SAAS,EAAE,WAAW;gBACtB,OAAO,EAAE,8BAA8B,UAAU,cAAc;aAChE,CAAC,CAAC;QACL,CAAC;QAED,OAAO,QAAQ,CAAC;IAClB,CAAC;IAED;;;OAGG;IACI,MAAM,CAAC,eAAe,CAAC,GAA8B;QAC1D,IAAI,CAAC,GAAG;YAAE,OAAO,IAAI,WAAW,CAAC,SAAS,CAAC,CAAC;QAC5C,IAAI,CAAC;YACH,OAAO,WAAW,CAAC,MAAM,CAAC,GAAG,CAAC,CAAC;QACjC,CAAC;QAAC,MAAM,CAAC;YACP,OAAO,IAAI,WAAW,CAAC,SAAS,CAAC,CAAC;QACpC,CAAC;IACH,CAAC;IAED,6DAA6D;IAEtD,OAAO;QACZ,OAAO,IAAI,CAAC,KAAK,CAAC,MAAM,GAAG,CAAC,IAAI,IAAI,CAAC,KAAK,CAAC,MAAM,IAAI,UAAU,CAAC;IAClE,CAAC;IAED,6DAA6D;IAE7D,IAAW,UAAU;QACnB,MAAM,EAAE,GAAG,IAAI,CAAC,KAAK,CAAC;QACtB,IAAI,EAAE,KAAK,SAAS;YAAE,OAAO,SAAS,CAAC;QACvC,IAAI,8BAA8B,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,KAAK,CAAC;QAC1D,IAAI,6BAA6B,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,QAAQ,CAAC;QAC5D,IAAI,cAAc,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,QAAQ,CAAC;QAC7C,IAAI,0BAA0B,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,SAAS,CAAC;QAC1D,OAAO,SAAS,CAAC;IACnB,CAAC;IAED,IAAW,OAAO;QAChB,MAAM,EAAE,GAAG,IAAI,CAAC,KAAK,CAAC;QACtB,IAAI,QAAQ,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,MAAM,CAAC;QACrC,IAAI,WAAW,CAAC,IAAI,CAAC,EAAE,CAAC,IAAI,CAAC,WAAW,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,QAAQ,CAAC;QACnE,IAAI,YAAY,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,SAAS,CAAC;QAC5C,IAAI,WAAW,CAAC,IAAI,CAAC,EAAE,CAAC,IAAI,CAAC,SAAS,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,QAAQ,CAAC;QACjE,IAAI,eAAe,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,mBAAmB,CAAC;QACzD,IAAI,QAAQ,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,OAAO,CAAC;QACtC,OAAO,SAAS,CAAC;IACnB,CAAC;IAED,IAAW,EAAE;QACX,MAAM,EAAE,GAAG,IAAI,CAAC,KAAK,CAAC;QACtB,IAAI,aAAa,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,SAAS,CAAC;QAC7C,IAAI,WAAW,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,OAAO,CAAC;QACzC,IAAI,QAAQ,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,OAAO,CAAC;QACtC,IAAI,UAAU,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,SAAS,CAAC;QAC1C,IAAI,mBAAmB,CAAC,IAAI,CAAC,EAAE,CAAC;YAAE,OAAO,KAAK,CAAC;QAC/C,OAAO,SAAS,CAAC;IACnB,CAAC;CACF;AAjFD,kCAiFC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\values-objects\\user-agent\\user-agent.vo.ts"],"sourcesContent":["import { BadRequestError } from \"../../errors/controllers/bad-request.error\";\r\nimport { BaseVO } from \"../base.vo\";\r\n\r\nconst MAX_LENGTH = 512;\r\n\r\nexport type DeviceType = \"mobile\" | \"tablet\" | \"desktop\" | \"bot\" | \"unknown\";\r\n\r\n/**\r\n * 🖥️ UserAgentVO\r\n *\r\n * Encapsula a string User-Agent de uma requisição HTTP.\r\n * Expõe metadados de dispositivo, browser e OS via parsing leve sem biblioteca.\r\n */\r\nexport class UserAgentVO extends BaseVO<string> {\r\n  private constructor(value: string) {\r\n    super(value);\r\n  }\r\n\r\n  // ─── Factories ────────────────────────────────────────────\r\n\r\n  /**\r\n   * ✅ Cria a partir de um User-Agent obrigatório.\r\n   */\r\n  public static create(raw: string): UserAgentVO {\r\n    if (!raw || raw.trim().length === 0) {\r\n      throw new BadRequestError({\r\n        fieldName: \"userAgent\",\r\n        message: \"User-Agent cannot be empty.\",\r\n      });\r\n    }\r\n\r\n    const instance = new UserAgentVO(raw.trim());\r\n\r\n    if (!instance.isValid()) {\r\n      throw new BadRequestError({\r\n        fieldName: \"userAgent\",\r\n        message: `User-Agent must be at most ${MAX_LENGTH} characters.`,\r\n      });\r\n    }\r\n\r\n    return instance;\r\n  }\r\n\r\n  /**\r\n   * ✅ Cria com fallback para \"unknown\".\r\n   * Use quando o header pode estar ausente.\r\n   */\r\n  public static createOrUnknown(raw: string | undefined | null): UserAgentVO {\r\n    if (!raw) return new UserAgentVO(\"unknown\");\r\n    try {\r\n      return UserAgentVO.create(raw);\r\n    } catch {\r\n      return new UserAgentVO(\"unknown\");\r\n    }\r\n  }\r\n\r\n  // ─── Validação ────────────────────────────────────────────\r\n\r\n  public isValid(): boolean {\r\n    return this.value.length > 0 && this.value.length <= MAX_LENGTH;\r\n  }\r\n\r\n  // ─── Accessors ────────────────────────────────────────────\r\n\r\n  public get deviceType(): DeviceType {\r\n    const ua = this.value;\r\n    if (ua === \"unknown\") return \"unknown\";\r\n    if (/bot|crawler|spider|crawling/i.test(ua)) return \"bot\";\r\n    if (/mobile|android|iphone|ipod/i.test(ua)) return \"mobile\";\r\n    if (/tablet|ipad/i.test(ua)) return \"tablet\";\r\n    if (/windows|macintosh|linux/i.test(ua)) return \"desktop\";\r\n    return \"unknown\";\r\n  }\r\n\r\n  public get browser(): string {\r\n    const ua = this.value;\r\n    if (/Edg\\//i.test(ua)) return \"Edge\";\r\n    if (/Chrome\\//i.test(ua) && !/Chromium/i.test(ua)) return \"Chrome\";\r\n    if (/Firefox\\//i.test(ua)) return \"Firefox\";\r\n    if (/Safari\\//i.test(ua) && !/Chrome/i.test(ua)) return \"Safari\";\r\n    if (/MSIE|Trident/i.test(ua)) return \"Internet Explorer\";\r\n    if (/OPR\\//i.test(ua)) return \"Opera\";\r\n    return \"unknown\";\r\n  }\r\n\r\n  public get os(): string {\r\n    const ua = this.value;\r\n    if (/Windows NT/i.test(ua)) return \"Windows\";\r\n    if (/Mac OS X/i.test(ua)) return \"macOS\";\r\n    if (/Linux/i.test(ua)) return \"Linux\";\r\n    if (/Android/i.test(ua)) return \"Android\";\r\n    if (/iPhone|iPad|iPod/i.test(ua)) return \"iOS\";\r\n    return \"unknown\";\r\n  }\r\n}\r\n"],"version":3}