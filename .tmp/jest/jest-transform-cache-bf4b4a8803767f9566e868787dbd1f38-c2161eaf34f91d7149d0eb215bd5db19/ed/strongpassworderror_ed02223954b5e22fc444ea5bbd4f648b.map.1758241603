{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\usecases\\strong-password.error.ts","mappings":";;;AAEA,MAAa,mBAAoB,SAAQ,KAAK;IAC5C,YAAY,OAAe,EAAE,QAAgB;QAC3C,KAAK,CAAC,OAAO,CAAC,CAAC;QACf,IAAI,CAAC,IAAI,GAAG,qBAAqB,CAAC;QAClC,IAAI,CAAC,2BAA2B,CAAC,QAAQ,CAAC,CAAC;IAC7C,CAAC;IAEO,2BAA2B,CAAC,QAAgB;QAClD,IAAI,QAAQ,CAAC,MAAM,GAAG,CAAC,EAAE,CAAC;YACxB,OAAO,0CAA0C,CAAC;QACpD,CAAC;QACD,IAAI,CAAC,OAAO,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YAC5B,OAAO,qDAAqD,CAAC;QAC/D,CAAC;QACD,IAAI,CAAC,OAAO,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YAC5B,OAAO,qDAAqD,CAAC;QAC/D,CAAC;QACD,IAAI,CAAC,OAAO,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YAC5B,OAAO,2CAA2C,CAAC;QACrD,CAAC;QACD,IAAI,CAAC,wBAAwB,CAAC,IAAI,CAAC,QAAQ,CAAC,EAAE,CAAC;YAC7C,OAAO,qDAAqD,CAAC;QAC/D,CAAC;QAED,OAAO,IAAI,CAAC,CAAC,eAAe;IAC9B,CAAC;CACF;AA1BD,kDA0BC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\errors\\usecases\\strong-password.error.ts"],"sourcesContent":["import { BaseUseCaseError } from \"./base-usecase.error\";\n\nexport class StrongPasswordError extends Error implements BaseUseCaseError {\n  constructor(message: string, password: string) {\n    super(message);\n    this.name = \"StrongPasswordError\";\n    this.validatePasswordWithMessage(password);\n  }\n\n  private validatePasswordWithMessage(password: string): string | null {\n    if (password.length < 8) {\n      return \"A senha deve ter no mínimo 8 caracteres.\";\n    }\n    if (!/[A-Z]/.test(password)) {\n      return \"A senha deve conter pelo menos uma letra maiúscula.\";\n    }\n    if (!/[a-z]/.test(password)) {\n      return \"A senha deve conter pelo menos uma letra minúscula.\";\n    }\n    if (!/[0-9]/.test(password)) {\n      return \"A senha deve conter pelo menos um número.\";\n    }\n    if (!/[!@#$%^&*(),.?\":{}|<>]/.test(password)) {\n      return \"A senha deve conter pelo menos um símbolo especial.\";\n    }\n\n    return null; // senha válida\n  }\n}\n"],"version":3}