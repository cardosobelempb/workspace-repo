{"version":3,"names":["cov_1krmwosb1j","actualCoverage","s","constants_1","require","LogoutUseCase","tokenHasher","sessions","cache","inject","AUTH_DI_TOKENS","SESSION_TOKEN_SERVICE","SESSION_REPOSITORY","SESSION_CACHE_REPOSITORY","constructor","f","execute","rawSessionToken","hash","revokeByTokenHash","delete","exports"],"sources":["E:\\workspace-sass\\repo\\packages\\auth-core\\src\\application\\use-cases\\logout.use-case.ts"],"sourcesContent":["import { BcryptHasher } from \"@repo/common\";\r\nimport { AUTH_DI_TOKENS } from \"../../constants\";\r\nimport { SessionCacheRepository } from \"../../domain/repositories/session-cache.repository\";\r\nimport { SessionRepository } from \"../../domain/repositories/session.repository\";\r\n\r\nexport class LogoutUseCase {\r\n  static inject = [\r\n    AUTH_DI_TOKENS.SESSION_TOKEN_SERVICE,\r\n    AUTH_DI_TOKENS.SESSION_REPOSITORY,\r\n    AUTH_DI_TOKENS.SESSION_CACHE_REPOSITORY,\r\n  ];\r\n\r\n  constructor(\r\n    private readonly tokenHasher: BcryptHasher,\r\n    private readonly sessions: SessionRepository,\r\n    private readonly cache: SessionCacheRepository,\r\n  ) {}\r\n  async execute(rawSessionToken: string): Promise<void> {\r\n    const hash = await this.tokenHasher.hash(rawSessionToken, 10);\r\n    await this.sessions.revokeByTokenHash(hash);\r\n    await this.cache.delete(hash);\r\n  }\r\n}\r\n"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;IAcqB;IAAAA,cAAA,YAAAA,CAAA;MAAA,OAAAC,cAAA;IAAA;EAAA;EAAA,OAAAA,cAAA;AAAA;AAAAD,cAAA;AAAAA,cAAA,GAAAE,CAAA;;;;;;;AAbrB,MAAAC,WAAA;AAAA;AAAA,CAAAH,cAAA,GAAAE,CAAA,OAAAE,OAAA;AAIA,MAAaC,aAAa;EAQLC,WAAA;EACAC,QAAA;EACAC,KAAA;EATnB,OAAOC,MAAM;EAAA;EAAA,CAAAT,cAAA,GAAAE,CAAA,OAAG,CACdC,WAAA,CAAAO,cAAc,CAACC,qBAAqB,EACpCR,WAAA,CAAAO,cAAc,CAACE,kBAAkB,EACjCT,WAAA,CAAAO,cAAc,CAACG,wBAAwB,CACxC;EAEDC,YACmBR,WAAyB,