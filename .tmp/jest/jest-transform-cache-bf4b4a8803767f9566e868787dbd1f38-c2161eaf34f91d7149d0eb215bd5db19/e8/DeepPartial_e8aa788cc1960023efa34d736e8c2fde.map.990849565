{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\DeepPartial.ts","mappings":";AAAA;;2FAE2F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\DeepPartial.ts"],"sourcesContent":["/* =====================================================================================\n *  DEEPPARTIAL<T>\n * ===================================================================================== */\n\n/**\n * Transforma qualquer estrutura aninhada em parcial (recursivo).\n *\n * Muito útil para criação de objetos em testes.\n *\n * @example\n * type User = {\n *   id: string\n *   profile: { email: string; avatar: string }\n * }\n *\n * type UserPatch = DeepPartial<User>\n */\nexport type DeepPartial<T> = {\n  [P in keyof T]?: DeepPartial<T[P]>;\n};\n"],"version":3}