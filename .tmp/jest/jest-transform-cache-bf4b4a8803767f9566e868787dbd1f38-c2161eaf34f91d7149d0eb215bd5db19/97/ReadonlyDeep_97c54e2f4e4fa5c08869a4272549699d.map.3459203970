{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\ReadonlyDeep.ts","mappings":";AAAA;;2FAE2F","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\types\\ReadonlyDeep.ts"],"sourcesContent":["/* =====================================================================================\n *  READONLYDEEP<T>\n * ===================================================================================== */\n\n/**\n * Deixa TODAS as propriedades readonly, inclusive aninhadas.\n * Excelente para proteção de estados internos.\n *\n * @example\n * type User = {\n *   name: string\n *   address: { city: string }\n * }\n *\n * type Frozen = ReadonlyDeep<User>\n * // { readonly name: string; readonly address: { readonly city: string } }\n */\nexport type ReadonlyDeep<T> = {\n  readonly [P in keyof T]: ReadonlyDeep<T[P]>;\n};\n"],"version":3}