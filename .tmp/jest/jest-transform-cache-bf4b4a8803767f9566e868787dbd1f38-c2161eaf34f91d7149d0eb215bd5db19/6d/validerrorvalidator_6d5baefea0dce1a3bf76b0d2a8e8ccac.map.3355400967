{"file":"E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\validations\\valid-error.validator.ts","mappings":";;;AAAA,MAAa,UAAU;IACZ,KAAK,CAAS;IACd,SAAS,CAAS;IAE3B,YAAY,KAAa,EAAE,SAAiB;QAC1C,IAAI,CAAC,KAAK,GAAG,KAAK,CAAC;QACnB,IAAI,CAAC,SAAS,GAAG,SAAS,CAAC;IAC7B,CAAC;IAED,MAAM,CAAC,KAAc;QACnB,IAAI,CAAC,CAAC,KAAK,YAAY,UAAU,CAAC;YAAE,OAAO,KAAK,CAAC;QACjD,OAAO,IAAI,CAAC,KAAK,KAAK,KAAK,CAAC,KAAK,IAAI,IAAI,CAAC,SAAS,KAAK,KAAK,CAAC,SAAS,CAAC;IAC1E,CAAC;IAED,QAAQ;QACN,mDAAmD;QACnD,MAAM,UAAU,GAAG,GAAG,IAAI,CAAC,KAAK,IAAI,IAAI,CAAC,SAAS,EAAE,CAAC;QACrD,IAAI,IAAI,GAAG,CAAC,CAAC;QACb,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAG,UAAU,CAAC,MAAM,EAAE,CAAC,EAAE,EAAE,CAAC;YAC3C,MAAM,IAAI,GAAG,UAAU,CAAC,UAAU,CAAC,CAAC,CAAC,CAAC;YACtC,IAAI,GAAG,CAAC,IAAI,IAAI,CAAC,CAAC,GAAG,IAAI,GAAG,IAAI,CAAC;YACjC,IAAI,IAAI,CAAC,CAAC,CAAC,2BAA2B;QACxC,CAAC;QACD,OAAO,IAAI,CAAC;IACd,CAAC;IAED,QAAQ;QACN,OAAO,qBAAqB,IAAI,CAAC,KAAK,iBAAiB,IAAI,CAAC,SAAS,IAAI,CAAC;IAC5E,CAAC;CACF;AA7BD,gCA6BC","names":[],"sources":["E:\\workspace-sass\\repo\\packages\\common\\src\\domain\\validations\\valid-error.validator.ts"],"sourcesContent":["export class ValidError {\n  readonly field: string;\n  readonly errorCode: string;\n\n  constructor(field: string, errorCode: string) {\n    this.field = field;\n    this.errorCode = errorCode;\n  }\n\n  equals(other: unknown): boolean {\n    if (!(other instanceof ValidError)) return false;\n    return this.field === other.field && this.errorCode === other.errorCode;\n  }\n\n  hashCode(): number {\n    // Simulando um hashCode simples baseado em strings\n    const hashString = `${this.field}:${this.errorCode}`;\n    let hash = 0;\n    for (let i = 0; i < hashString.length; i++) {\n      const char = hashString.charCodeAt(i);\n      hash = (hash << 5) - hash + char;\n      hash |= 0; // Convert to 32bit integer\n    }\n    return hash;\n  }\n\n  toString(): string {\n    return `ValidError{field='${this.field}', errorCode='${this.errorCode}'}`;\n  }\n}\n"],"version":3}