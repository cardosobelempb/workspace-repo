# ─────────────────────────────────────────────────────────────
# Stage 1 — development: nginx com config de dev (sem SSL, logs verbosos)
# ─────────────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS development

RUN apk add --no-cache bash curl

# Remove config padrão
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx/conf.d/dev.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# ─────────────────────────────────────────────────────────────
# Stage 2 — test: valida configuração e responde health check
# ─────────────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS test

RUN apk add --no-cache bash curl

RUN rm /etc/nginx/conf.d/default.conf

COPY nginx/conf.d/test.conf /etc/nginx/conf.d/default.conf

# Valida a config antes de subir
RUN nginx -t

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# ─────────────────────────────────────────────────────────────
# Stage 3 — production: nginx endurecido com SSL e compressão
# ─────────────────────────────────────────────────────────────
FROM nginx:1.25-alpine AS production

RUN apk add --no-cache bash curl

# Remove config e páginas padrão
RUN rm /etc/nginx/conf.d/default.conf && \
    rm -rf /usr/share/nginx/html/*

COPY nginx/conf.d/prod.conf   /etc/nginx/conf.d/default.conf
COPY nginx/nginx.prod.conf    /etc/nginx/nginx.conf

# Valida config na build
RUN nginx -t

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
