{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@repo/common": [
        "./packages/common/src/index.ts"
      ],
      "@repo/common/*": [
        "./packages/common/src/*"
      ]
    }
  }
}